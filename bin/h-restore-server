#!/bin/bash
# info: restore selected components of a server backup
# options: ARCHIVE COMPONENT[,COMPONENT...] [CONSENT]
#
# example: h-restore-server server.2026-08-19_18-00-00.tar webmail
# example: h-restore-server server.2026-08-19_18-00-00.tar webmail,packages all
#
# There is deliberately NO whole-archive verb. A server backup describes the box, so putting all of
# it back would overwrite the configuration of a running host - every customer at once, and not the
# kind of mistake anyone undoes. A component has to be named, or the run refuses before it writes.
#
# Naming a component says WHICH live state to replace, not that replacing it is intended, so each
# one is consented to before the first write - by answering the question, or by naming the component
# (or 'all') in CONSENT. Without a terminal there is nobody to ask and the run writes nothing.
#
# ARCHIVE is a basename: this reads as root, so a path argument would be a read oracle. Resolved
# only inside the backup folder, and checked to still be there afterwards.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

archive=$1
components=$2
consent=$3

# A member name comes out of the archive and is then used to look something up - a directory in this
# host's item list, or a database identifier. So it has to be a plain ASCII basename.
#
# Deliberately NOT is_object_format_valid: that exits, so one crafted member would abort a run that
# should merely skip it, and its [[:alnum:]] is locale dependent - the wrong property for a string
# spliced into a sed pattern and an SQL identifier. Stricter here on purpose, not accidentally.
member_name_ok() {
	case "$1" in
		'' | .* | *[!A-Za-z0-9._-]*) return 1 ;;
	esac
	return 0
}

# What restoring COMPONENT would replace on THIS host, as one line for the consent question.
component_targets() {
	local _item _out=''
	while IFS= read -r _item; do
		case "$_item" in
			dir:*) _out="$_out, ${_item#dir:}" ;;
			db:mysql:*) _out="$_out, database ${_item##*:}" ;;
		esac
	done < <(tr ' ' '\n' <<< "$1")
	printf '%s' "${_out#, }"
}

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'ARCHIVE COMPONENT[,COMPONENT...] [CONSENT]'
is_object_format_valid "$archive" 'backup'
check_hestia_demo_mode

if [ ! -f "$BACKUP/$archive" ]; then
	check_result "$E_NOTEXIST" "$archive doesn't exist in '$BACKUP'"
fi
archive_real=$(realpath -e -- "$BACKUP/$archive" 2> /dev/null)
backup_real=$(realpath -e -- "$BACKUP" 2> /dev/null)
if [ -z "$archive_real" ] || [ -z "$backup_real" ] || [ "${archive_real%/*}" != "$backup_real" ]; then
	check_result "$E_INVALID" "$archive does not resolve to a file inside '$BACKUP'"
fi

in_archive=$(tar -tf "$BACKUP/$archive" 2> /dev/null | sed -n 's|^\./server/\([^/]*\)/.*|\1|p' | sort -u)
if [ -z "$in_archive" ]; then
	check_result "$E_PARSING" "$archive holds no server components"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

selected=''
for c in ${components//,/ }; do
	[ -n "$c" ] || continue
	is_object_format_valid "$c" 'component'
	if ! grep -qxF "$c" <<< "$in_archive"; then
		check_result "$E_NOTEXIST" "$archive holds no component $c - it has: $(tr '\n' ' ' <<< "$in_archive")"
	fi
	selected="$selected$c"$'\n'
done
if [ -z "$selected" ]; then
	check_result "$E_INVALID" "name at least one component - a server backup is never restored whole"
fi

# Consent (C.5), for the same reason the user restore has it, only the stakes are higher: naming a
# component says WHICH live state to replace, not that replacing it is intended - and the webmail
# component carries the identities, address books and settings of every mailbox on the box. So the
# question is asked BEFORE the first write, for every selected component, and it names the paths and
# databases this host would actually lose. Without a terminal there is nobody to ask: the consent
# has to arrive in the argument, or the run ends having written nothing.
if ! restore_consent_parse "$consent" "all $(tr '\n' ' ' <<< "$in_archive")"; then
	check_result "$E_INVALID" "consent must be a comma list of components, or 'all'"
fi

declare -A items=()
approved=''
# A plain `for` over the validated names, as the user restore does, and NOT a `while read` fed by a
# process substitution: that makes the loop's stdin the fifo, so the terminal check is false and the
# question is never put - a refusal that looks identical to a considered no.
for component in $selected; do
	# Once per component, not once per member: server_components asks the database engine what
	# exists, so calling it per member is a query per member.
	items[$component]=$(server_component_items "$component")
	# The database clause only where there is one - a warning that does not apply to what is being
	# asked about teaches the reader to skim the ones that do.
	dbnote=''
	case "${items[$component]}" in *db:*) dbnote=' (databases are dropped and recreated)' ;; esac
	if restore_consent_ask "$component" \
		"$component replaces the live $(component_targets "${items[$component]}") on this box$dbnote. Replace?"; then
		approved="$approved$component"$'\n'
	else
		echo "Skipped $component: no consent given"
	fi
done

if [ -z "$approved" ]; then
	check_result "$E_INVALID" "no component was consented to - nothing has been written"
fi

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT
chmod 700 "$tmpdir"

echo "-- SERVER RESTORE --"
while IFS= read -r component; do
	[ -n "$component" ] || continue
	# One component at a time, by exact member: the name came out of the archive, so it is never a
	# wildcard here.
	tar -xf "$BACKUP/$archive" -C "$tmpdir" --no-wildcards "./server/$component" 2> /dev/null
	# Counted, because a loop that recognises nothing otherwise looks exactly like a clean run: the
	# glob skips dot members, tar may have written nothing, a codec may be one we do not read.
	seen=0
	for part in "$tmpdir/server/$component"/*; do
		[ -e "$part" ] || continue
		# Both codecs on read whatever this box writes - the archive may come from a zstd box.
		case "$part" in
			*.mysql.sql.gz | *.mysql.sql.zst)
				seen=$((seen + 1))
				db=$(basename "$part")
				db="${db%.mysql.sql.*}"
				if ! member_name_ok "$db"; then
					echo "Warning!: $component: $db is not a database member name - skipped"
					continue
				fi
				if [ -z "$DB_SYSTEM" ] || ! command -v mysql > /dev/null 2>&1; then
					echo "Warning!: $component: no database engine on this host for $db - skipped"
					continue
				fi
				# The dump must be whole BEFORE the target is dropped. Without this the codec's
				# exit status is all we would have, and that is not the dump's.
				if ! backup_dump_complete "$part"; then
					echo "Warning!: $component: the dump of $db is truncated - $db left untouched"
					continue
				fi
				# Dropped and recreated, not loaded on top: --add-drop-table only replaces the
				# tables the dump CARRIES, so a table the archive predates would survive a restore
				# and leave a schema that never existed. Measured; grants live outside the schema
				# and survive the drop.
				if ! mysql -e "DROP DATABASE IF EXISTS \`$db\`; CREATE DATABASE \`$db\`" 2> /dev/null; then
					echo "Warning!: $component: database $db could not be reset - left untouched"
					continue
				fi
				backup_decompress "$part" | mysql "$db" 2> /dev/null \
					&& echo "$(date '+%F %T') $component: database $db" \
					|| echo "Warning!: $component: database $db was not loaded"
				;;
			*.tar.gz | *.tar.zst)
				seen=$((seen + 1))
				# THIS host's item list picks the destination, never the archive: an archive that
				# named its own absolute paths would be a write primitive. The member name only
				# looks one up.
				name=$(basename "$part")
				name="${name%.tar.*}"
				if ! member_name_ok "$name"; then
					echo "Warning!: $component: $name is not a component member name - skipped"
					continue
				fi
				mapfile -t places < <(tr ' ' '\n' <<< "${items[$component]}" | sed -n "s|^dir:\(.*/$name\)$|\1|p")
				if [ "${#places[@]}" -eq 0 ]; then
					echo "Warning!: $component: no place on this host for $name - skipped"
					continue
				fi
				# Refuse rather than pick: two dirs of one name means the mapping stopped being one
				# to one, and unpacking into the wrong one of them is silent.
				if [ "${#places[@]}" -gt 1 ]; then
					echo "Warning!: $component: $name matches ${#places[@]} places on this host - skipped"
					continue
				fi
				dest="${places[0]}"
				backup_decompress "$part" | tar -xf - -C "$(dirname "$dest")" \
					&& echo "$(date '+%F %T') $component: $dest" \
					|| echo "Warning!: $component: $dest was not unpacked"
				;;
		esac
	done
	[ "$seen" -gt 0 ] || echo "Warning!: $component: the archive holds nothing under this component that this host can read"
done < <(printf '%s\n' "$approved")

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "Backup" "Server components restored from $archive: $(tr '\n' ' ' <<< "$approved")."
log_event "$OK" "$ARGUMENTS"

exit
