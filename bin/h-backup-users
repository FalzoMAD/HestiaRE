#!/bin/bash
# info: backup all users
# options: NONE
#
# example: h-backup-users
#
# This function backups all system users.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Auto-repair all databases before backuping all accounts
mysqlrepair --all-databases --check --auto-repair > /dev/null 2>&1

if [ -z "$BACKUP_SYSTEM" ]; then
	exit
fi
for user in $("$BIN/h-list-users" list); do
	check_suspend=$(grep "SUSPENDED='no'" $CONF_DIR/users/$user/user.conf)
	log=$HESTIA/log/backup.log
	if [ ! -f "$CONF_DIR/users/$user/user.conf" ]; then
		continue
	fi
	check_backup_conditions
	check_suspend=$(grep "SUSPENDED='no'" $CONF_DIR/users/$user/user.conf)
	log=$HESTIA/log/backup.log
	if [ -n "$check_suspend" ]; then
		echo -e "================================" >> $log
		echo -e "$user" >> $log
		echo -e "--------------------------------\n" >> $log
		# The dispatcher (#712): one nightly run, and the customer's mode decides which backup it
		# is. restic is an alternative to the archive path, not something running beside it - and
		# it only exists where the addon does, so a mode naming it on a host without it falls back
		# rather than failing silently at 5 in the morning.
		mode=$(sed -n "s/^BACKUPS_MODE='\([^']*\)'.*/\1/p" "$CONF_DIR/users/$user/user.conf" | head -1)
		if [ "${mode:-full}" = 'restic' ] && [ "$BACKUP_INCREMENTAL" = 'yes' ]; then
			nice -n 19 ionice -c2 -n7 $BIN/h-backup-user-restic $user >> $log 2>&1
		else
			if [ "${mode:-full}" = 'restic' ]; then
				echo "Warning: $user is set to restic but the addon is not installed - archive backup instead" >> $log
			fi
			nice -n 19 ionice -c2 -n7 $BIN/h-backup-user $user >> $log 2>&1
		fi
		echo -e "\n--------------------------------\n\n" >> $log
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
