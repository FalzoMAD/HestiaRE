#!/bin/bash
# info: listing backend templates
# options: [FORMAT]
#
# example: h-list-web-templates-backend
#
# This function for obtaining the list of available backend templates.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	i=1
	objects=$(echo "$templates" | wc -w)
	echo '['
	for template in $templates; do
		json_escape template
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$template"
		else
			printf '\t"%s"\n' "$template"
		fi
		((++i))
	done
	echo "]"
}

# SHELL list function
shell_list() {
	echo "TEMPLATE"
	echo "--------"
	for template in $templates; do
		echo "$template"
	done
}

# PLAIN list function
plain_list() {
	for template in $templates; do
		echo "$template"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing backend templates
if [ -n "$WEB_BACKEND" ]; then
	templates=$(ls -t $PHPTPL \
		| cut -f1 -d . \
		| grep -v proxy_ip \
		| sort -u)
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
