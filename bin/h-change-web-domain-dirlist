#!/bin/bash
# info: enable/disable directory listing
# options: USER DOMAIN MODE [RESTART] [QUIET]
#
# example: h-change-web-domain-dirlist user demo.com on
#
# This function is used for changing the directory list mode.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument defenition
user=$1
domain=$2
mode=$3
restart="$4"
quiet="$5"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Serialize behind a live web-model switch (#120): a bounded, reentrant wait so a
# domain change cannot land on a half-flipped tree (the switch owner is exempt).
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN MODE'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Fetching domain variables
get_domain_values 'web'

if [ "$mode" = "on" ]; then
	# Enable directory listing
	sed -i "s/-Index/+Index/g" $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf
	if [ "$SSL" == "yes" ]; then
		# Enable directory listing for SSL-enforced domains
		sed -i "s/-Index/+Index/g" $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf
	fi
	[ "$quiet" != "yes" ] && echo "Enabled directory browsing for $domain."
else
	# Disable directory listing
	sed -i "s/+Index/-Index/g" $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf
	if [ "$SSL" == "yes" ]; then
		# Enable directory listing for SSL-enforced domains
		sed -i "s/+Index/-Index/g" $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf
	fi
	[ "$quiet" != "yes" ] && echo "Disabled directory browsing for $domain."
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Persist the state so a vhost rebuild can self-heal it. Without a web.conf key
# the setting lives only in the generated vhost and every rebuild silently drops it.
if [ -z "$DIR_LIST" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'DIR_LIST' 'SUSPENDED'
fi
if [ "$mode" = "on" ]; then
	update_object_value 'web' 'DOMAIN' "$domain" '$DIR_LIST' 'yes'
else
	update_object_value 'web' 'DOMAIN' "$domain" '$DIR_LIST' 'no'
fi

# Restart web server
$BIN/h-restart-web "$restart"

# Logging
if [ "$quiet" != "yes" ]; then
	if [ "$mode" = "on" ]; then
		$BIN/h-log-action "$user" "Warning" "Web" "Directory browsing enabled (Domain: $domain)."
	else
		$BIN/h-log-action "$user" "Info" "Web" "Directory browsing disabled (Domain: $domain)."
	fi
fi
log_event "$OK" "$EVENT"

exit
