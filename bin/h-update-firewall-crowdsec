#!/bin/bash
# info: refresh the CrowdSec L3 ipset from local ban decisions
# options: NONE
#
# example: h-update-firewall-crowdsec
#
# Feeds the crowdsec-blacklists ipset from CrowdSec's own local web-tier bans (cscli, atomic swap);
# h-update-firewall's hestia-crowdsec chain drops them at L3. Own feeder, not the OS
# crowdsec-firewall-bouncer (its 0.0.25 nil-panics in the ipset path - fleet-verified). No-op sans marker.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# L3 only when wired (marker) and the tools exist; otherwise a silent no-op (timer fires anyway).
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] || exit 0
IPSET_BIN="$(command -v ipset)"
[ -n "$IPSET_BIN" ] || exit 0
command -v cscli > /dev/null 2>&1 || exit 0
command -v jq > /dev/null 2>&1 || exit 0

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

SET="crowdsec-blacklists"
TMP="${SET}-tmp"

# Ensure the live set exists (also provisioned by h-update-firewall-ipset at boot/rebuild).
"$IPSET_BIN" create -exist "$SET" hash:net timeout 0 maxelem 131072 2> /dev/null

# Build a fresh set + atomic swap, so the DROP never sees a half-built set (cscli lists only active).
"$IPSET_BIN" create -exist "$TMP" hash:net timeout 0 maxelem 131072 2> /dev/null
"$IPSET_BIN" flush "$TMP" 2> /dev/null

# Only local web-tier bans enter L3: origin==crowdsec (manual/CAPI stay L7-only), minus a denylist of
# fail2ban's auth families + req-limit (rate-limit breach, CGNAT collateral). Denylist so advisory-named
# exploits (vmsa) aren't missed; the flip side is a web scenario named with a denied token would skip L3.
cscli decisions list -o json 2> /dev/null \
	| jq -r '(if type=="array" then .[] else . end)
		| (.decisions // [])[]
		| select(.type == "ban" and .origin == "crowdsec"
			and ((.scenario // "") | ascii_downcase
				| test("ssh|ftp|smtp|imap|pop3|dovecot|postfix|exim|mysql|mariadb|postgres|req-limit") | not))
		| .value' 2> /dev/null \
	| while IFS= read -r ip; do
		[ -n "$ip" ] && "$IPSET_BIN" add -exist "$TMP" "$ip" 2> /dev/null
	done

"$IPSET_BIN" swap "$TMP" "$SET" 2> /dev/null
"$IPSET_BIN" destroy "$TMP" 2> /dev/null

exit 0
