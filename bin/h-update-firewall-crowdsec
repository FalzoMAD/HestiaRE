#!/bin/bash
# info: refresh the CrowdSec L3 ipset from local ban decisions
# options: NONE
#
# example: h-update-firewall-crowdsec
#
# Feeds the crowdsec-blacklists ipset from CrowdSec's own local, web-tier ban decisions (via
# cscli) with an atomic swap, so h-update-firewall's hestia-crowdsec chain drops them at L3.
# Run by the hestia-crowdsec-l3 systemd timer (#186). Own feeder instead of the OS
# crowdsec-firewall-bouncer, whose 0.0.25 config loader nil-panics non-deterministically in the
# ipset path (fleet-verified). No-op unless the CrowdSec L3 marker is present.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# L3 only when wired (marker) and the tools exist; otherwise a silent no-op (timer fires anyway).
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] || exit 0
IPSET_BIN="$(command -v ipset)"
[ -n "$IPSET_BIN" ] || exit 0
command -v cscli > /dev/null 2>&1 || exit 0
command -v jq > /dev/null 2>&1 || exit 0

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

SET="crowdsec-blacklists"
TMP="${SET}-tmp"

# Ensure the live set exists (also provisioned by h-update-firewall-ipset at boot/rebuild).
"$IPSET_BIN" create -exist "$SET" hash:net timeout 0 maxelem 131072 2> /dev/null

# Build a fresh set and swap it in atomically (same idiom as h-add-firewall-ipset), so the DROP
# never sees a half-built set and expired decisions drop out for free (cscli lists only active).
"$IPSET_BIN" create -exist "$TMP" hash:net timeout 0 maxelem 131072 2> /dev/null
"$IPSET_BIN" flush "$TMP" 2> /dev/null

# Only local, web-tier bans enter the L3 set: origin == crowdsec (the engine's own detections -
# excludes admin cscli-manual bans) and the scenario names a web tier (http / CVE). No `-a`, so the
# CAPI/community blocklist is never even pulled (it stays an L7-only concern via Layer A). This keeps
# fail2ban's auth lanes (ssh/mail/panel) out of L3 even once an sshd collection lands. The
# origin/scenario tokens are PLACEHOLDERS, curate against `cscli scenarios list` before release.
cscli decisions list -o json 2> /dev/null \
	| jq -r '(if type=="array" then .[] else . end)
		| (.decisions // [])[]
		| select(.type == "ban" and .origin == "crowdsec"
			and ((.scenario // "") | test("http|CVE"; "i")))
		| .value' 2> /dev/null \
	| while IFS= read -r ip; do
		[ -n "$ip" ] && "$IPSET_BIN" add -exist "$TMP" "$ip" 2> /dev/null
	done

"$IPSET_BIN" swap "$TMP" "$SET" 2> /dev/null
"$IPSET_BIN" destroy "$TMP" 2> /dev/null

exit 0
