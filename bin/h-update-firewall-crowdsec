#!/bin/bash
# info: refresh the CrowdSec L3 blocklist set from local ban decisions
# options: NONE
#
# example: h-update-firewall-crowdsec
#
# Feeds the crowdsec-blacklists nft set from CrowdSec's own local web-tier bans (cscli);
# h-update-firewall's hestia-crowdsec chain drops them at L3. Own feeder, not the OS
# crowdsec-firewall-bouncer: 0.0.25 nil-panics non-deterministically, and its native nft mode was only
# ever measured on one distro. No-op without the marker.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# L3 only when wired (marker) and the tools exist; otherwise a silent no-op (timer fires anyway).
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] || exit 0
command -v cscli > /dev/null 2>&1 || exit 0
command -v jq > /dev/null 2>&1 || exit 0

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

SET="crowdsec-blacklists"
SET6="crowdsec6-blacklists"
CACHE="$CONF_DIR/firewall/crowdsec.iplist"
CACHE6="$CONF_DIR/firewall/crowdsec6.iplist"

# The set is rendered from CACHE every time the ruleset is rebuilt, so the cache is the record of truth
# and has to be written even when the live update fails.
#
# Only local web-tier bans reach L3: origin==crowdsec (manual and CAPI stay L7-only), minus a denylist of
# scenario tokens. Denylist so advisory-named exploits (vmsa) are not missed; the flip side is a web
# scenario named with a denied token skips L3.
#
# The auth families are denied only while fail2ban is present (FIREWALL_EXTENSION): fail2ban enforces them
# at L1 in ~1s and cuts live connections, so keeping their CrowdSec decisions off L3 avoids a slower,
# weaker duplicate. In the crowdsec-only model nothing else would enforce them, so they are let through -
# best-effort, at the feeder's ~45s latency (mail still has no CrowdSec detection surface; that gap stands).
# req-limit is denied in EVERY model: a Layer-B rate-limit 429 must never escalate into a firewall ban
# (CGNAT collateral).
deny='req-limit'
[ -n "$FIREWALL_EXTENSION" ] && deny='ssh|ftp|smtp|imap|pop3|dovecot|postfix|exim|mysql|mariadb|postgres|req-limit'
# One extraction of every kept decision (both families), then split by family below.
raw="$(mktemp)"
cscli decisions list -o json 2> /dev/null \
	| jq -r --arg deny "$deny" '(if type=="array" then .[] else . end)
		| (.decisions // [])[]
		| select(.type == "ban" and .origin == "crowdsec"
			and ((.scenario // "") | ascii_downcase | test($deny) | not))
		| .value' 2> /dev/null \
	| sort -u > "$raw"

# Never overwrite the caches just because cscli or jq hiccuped: an empty cache renders an empty set, which
# would silently lift every L3 ban. An empty result is trusted only when cscli itself answered cleanly.
if [ ! -s "$raw" ] && ! cscli decisions list -o json > /dev/null 2>&1; then
	rm -f "$raw"
	exit 0
fi
# Split by family - a v4 element in the v6 set (or vice versa) fails the whole nft document. Both caches
# are rewritten together, so a decision that flips family is never left stale in the other set.
grep -oE "$FW_ADDR_RE" "$raw" > "$CACHE" || true
grep -oE "$FW_ADDR6_RE" "$raw" > "$CACHE6" || true
chmod 640 "$CACHE" "$CACHE6"
rm -f "$raw"

# Flush and refill in one transaction per set, so the set is never observably empty. The ipset original
# needed a temporary set and a swap for the same guarantee.
fw_set_replace "$SET" "$CACHE"
fw_set_replace "$SET6" "$CACHE6" 6

# Self-heal the brute-force layer separation (#542): while fail2ban is present it owns brute force, so
# CrowdSec's ssh scenarios must stay removed. A manual `cscli hub upgrade` (no automated one runs here) can
# re-write them and silently restore the double-ban - the D1 dpkg-conffile class - and the model gates only
# run at explicit transitions. Re-assert on this 45s timer. File-checked, so a no-op (no cscli, no reload)
# unless a scenario actually drifted back. Only the removal direction: the install side is a transition
# concern, and re-adding here would fight a deliberate admin removal in the crowdsec-only model.
if [ "$FIREWALL_EXTENSION" = 'fail2ban' ]; then
	# shellcheck source=/usr/local/hestia/func/crowdsec.sh
	declare -F crowdsec_gate_bruteforce > /dev/null 2>&1 || source "$HESTIA/func/crowdsec.sh"
	crowdsec_gate_bruteforce
fi

exit 0
