#!/bin/bash
# info: list user packages
# options: [FORMAT]
#
# This function for obtaining the list of available hosting packages.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(echo "$packages" | wc -l)
	echo "{"
	for package in $packages; do
		PACKAGE=${package/.pkg/}
		source_conf "$CONF_DIR/packages/$PACKAGE.pkg"
		json_escape PACKAGE WEB_TEMPLATE PROXY_TEMPLATE WEB_DOMAINS WEB_ALIASES MAIL_DOMAINS MAIL_ACCOUNTS DATABASES CRON_JOBS DISK_QUOTA DOCKER_LIMIT BANDWIDTH SHELL BACKUPS TIME DATE
		printf '    "%s": {\n' "$PACKAGE"
		printf '        "WEB_TEMPLATE": "%s",\n' "$WEB_TEMPLATE"
		printf '        "PROXY_TEMPLATE": "%s",\n' "$PROXY_TEMPLATE"
		printf '        "WEB_DOMAINS": "%s",\n' "$WEB_DOMAINS"
		printf '        "WEB_ALIASES": "%s",\n' "$WEB_ALIASES"
		printf '        "MAIL_DOMAINS": "%s",\n' "$MAIL_DOMAINS"
		printf '        "MAIL_ACCOUNTS": "%s",\n' "$MAIL_ACCOUNTS"
		printf '        "DATABASES": "%s",\n' "$DATABASES"
		printf '        "CRON_JOBS": "%s",\n' "$CRON_JOBS"
		printf '        "DISK_QUOTA": "%s",\n' "$DISK_QUOTA"
		printf '        "DOCKER_LIMIT":"%s",\n' "$DOCKER_LIMIT"
		printf '        "BANDWIDTH": "%s",\n' "$BANDWIDTH"
		printf '        "SHELL": "%s",\n' "$SHELL"
		printf '        "BACKUPS": "%s",\n' "$BACKUPS"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '}'
}

# SHELL list function
shell_list() {
	echo "PKG   TPL   WEB   MAIL   DB   SHELL   DISK   DOCKER_LIMIT   BW"
	echo "---   ---   ---   ----   --   -----   ----   ------------   --"
	for package in $packages; do
		source $CONF_DIR/packages/$package
		PACKAGE=${package/.pkg/}
		package_data=$(cat $CONF_DIR/packages/$package)
		package_data=$(echo "$package_data" | sed -e 's/unlimited/unlim/g')
		parse_object_kv_list "$package_data"
		echo -n "$PACKAGE $WEB_TEMPLATE $WEB_DOMAINS "
		echo "$MAIL_DOMAINS $DATABASES $SHELL $DISK_QUOTA $DOCKER_LIMIT $BANDWIDTH"
	done
}

# PLAIN list function
plain_list() {
	for package in $packages; do
		source $CONF_DIR/packages/$package
		PACKAGE=${package/.pkg/}
		echo -ne "$PACKAGE\t$WEB_TEMPLATE\t$PROXY_TEMPLATE\t"
		echo -ne "$WEB_DOMAINS\t$WEB_ALIASES\t"
		echo -ne "$MAIL_DOMAINS\t$MAIL_ACCOUNTS\t$DATABASES\t$CRON_JOBS\t"
		echo -ne "$DISK_QUOTA\t$DOCKER_LIMIT\t"
		echo -e "$BANDWIDTH\t$SHELL\t$BACKUPS\t$TIME\t$DATE"
	done
}

# CSV list function
csv_list() {
	echo -n "PACKAGE,WEB_TEMPLATE,PROXY_TEMPLATE,"
	echo -n "WEB_DOMAINS,WEB_ALIASES,"
	echo -n "MAIL_DOMAINS,MAIL_ACCOUNTS,DATABASES,CRON_JOBS,"
	echo -n "DISK_QUOTA,"
	echo "DOCKER_LIMIT,BANDWIDTH,SHELL,BACKUPS,TIME,DATE"
	for package in $packages; do
		PACKAGE=${package/.pkg/}
		echo -n "$PACKAGE,$WEB_TEMPLATE,$PROXY_TEMPLATE,"
		echo -n "$WEB_DOMAINS,$WEB_ALIASES,"
		echo -n "$MAIL_DOMAINS,$MAIL_ACCOUNTS,$DATABASES,$CRON_JOBS,"
		echo -n "$DISK_QUOTA,"
		echo "$DOCKER_LIMIT,$BANDWIDTH,$SHELL,$BACKUPS,$TIME,$DATE"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing packages
packages=$(ls --sort=time $CONF_DIR/packages | grep .pkg)

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
