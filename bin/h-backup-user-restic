#!/bin/bash
# info: backup system user with all its objects to restic backup
# options: USER NOTIFY
#
# example: h-backup-user-restic admin yes
#
# Backup user with all its objects to restic backup. If the repo doesn't exists a new one will be created.
#

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
# Argument definition
user=$1
notify=${2-no}
# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_backup_mode_restic
is_backup_enabled

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Set notification email and subject
subj="$user → backup failed"
email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf" | cut -f 2 -d \')

is_restic_repo_configured

if [ ! -f "$USER_DATA/restic.conf" ]; then
	password=$(generate_password '' '32')
	echo "$password" > $USER_DATA/restic.conf
	chmod 0600 "$USER_DATA/restic.conf"

	restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf init
	if [ $? -ne 0 ]; then
		check_result $E_CONNECT "Unable to create restic repo"
	fi
else
	# Check if repo exists and is accessible with restic key
	restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json snapshots > /dev/null
	if [ $? -ne 0 ]; then
		# Send an email
		echo "Unable to open restic backup. It might not exists or key is incorrect" | $SENDMAIL -s "$subj" "$email" "yes"
		check_result $E_CONNECT "Unable to access restic repo"
	fi
fi

# One stamp for both artefacts of this run.
stamp=$(date +"%Y-%m-%d_%H-%M-%S")
meta_dir=$(restic_meta_dir "$user")
dump_dir=$(restic_dump_dir "$user")
meta_pkg="$BACKUP/$user/$user.$stamp.meta.tgz"
backup_user_dir "$user"
# Every exit removes the stage, not just the successful one.
trap 'rm -rf "$meta_dir" "$dump_dir"' EXIT
# Leftovers first, or yesterday's dump counts as occupied space in the check below.
rm -rf "$meta_dir" "$dump_dir"

# Against the filesystem the dumps land on, not against /backup.
need=$(restic_dump_space_needed "$user")
free=$(df -Pm "$HOMEDIR/$user" | tail -1 | awk '{print $4}')
if [ "${need:-0}" -gt 0 ] && [ "${free:-0}" -lt "$need" ]; then
	echo "Not enough space for the database dumps of $user: $need MB needed, $free MB free" \
		| $SENDMAIL -s "$subj" "$email" "yes"
	check_result "$E_DISK" "$user needs $need MB for its dumps, $HOMEDIR/$user has $free MB"
fi

# Only stale locks, never --remove-all: a running nightly job would lose its own.
restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf unlock > /dev/null 2>&1

$BIN/h-backup-user-config "$user"

export GOMAXPROCS=2
export RESTIC_READ_CONCURRENCY=2
# Asked from the binary, not from the version.
restic_opts=()
restic backup --help 2>&1 | grep -q -- '--read-concurrency' && restic_opts+=(--read-concurrency 2)
# The customer's exclusion list, path-producing entries only (include/backup.sh).
while read -r _x; do
	[ -n "$_x" ] && restic_opts+=(--exclude "$_x")
done < <(restic_excludes "$user")
ionice -c2 -n7 nice -n 19 restic --repo "$REPO$user" --limit-upload 10240 "${restic_opts[@]}" \
	--password-file $USER_DATA/restic.conf --tag "meta:$user.$stamp" backup /home/$user

if [ $? -ne 0 ]; then
	echo "Unable to create the backup" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result $E_BACKUP "Unable to backup user"
fi

snap_id=$(restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json snapshots \
	--tag "meta:$user.$stamp" 2> /dev/null | grep -o '"short_id":"[^"]*"' | tail -1 | cut -d'"' -f4)
# A package that cannot name its snapshot is half a restore point.
if [ -z "$snap_id" ]; then
	echo "Snapshot written but its id could not be read - no metadata package for $user.$stamp, so the snapshot has no partner" \
		| $SENDMAIL -s "$subj" "$email" "yes"
	check_result "$E_BACKUP" "cannot read the snapshot id for $user.$stamp - no package written, the snapshot stays an orphan"
fi
{
	echo "USER='$user'"
	echo "REPO='$REPO$user'"
	echo "SNAPSHOT='$snap_id'"
	echo "STAMP='$stamp'"
	echo "HOST='$(hostname)'"
	echo "VERSION='$(cat $HESTIA/VERSION 2> /dev/null)'"
} > "$meta_dir/restic.meta"
# Second key copy, with the artefact's lifetime (D1).
cp -p "$USER_DATA/restic.conf" "$meta_dir/restic.key"
if ! tar -czf "$meta_pkg" -C "$meta_dir" .; then
	echo "Unable to write the metadata package $meta_pkg" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result "$E_BACKUP" "cannot write $meta_pkg - the snapshot has no metadata beside it"
fi
# The panel pool reads it, the customer must not: it carries pam and the key.
chown hestia:hestia "$meta_pkg"
chmod 0640 "$meta_pkg"
rm -rf "$meta_dir" "$dump_dir"
echo "$(date "+%F %T") Metadata: $meta_pkg (snapshot $snap_id)" \
	| tee -a $BACKUP/$user/$user.log

# The customer's number first, the server-wide slots on top. A policy of nothing keeps nothing,
# so an empty result is refused rather than passed to forget.
restic_prune=''
keep_last=$(get_user_value '$BACKUPS')
case "$keep_last" in '' | 0 | *[!0-9]*) keep_last="$SNAPSHOTS" ;; esac
case "$keep_last" in
	'' | 0 | *[!0-9]*) ;;
	*) restic_prune="--keep-last $keep_last" ;;
esac
for _slot in "daily:$KEEP_DAILY" "weekly:$KEEP_WEEKLY" "monthly:$KEEP_MONTHLY" "yearly:$KEEP_YEARLY"; do
	_v=${_slot#*:}
	case "$_v" in '' | *[!0-9]*) continue ;; esac
	restic_prune="$restic_prune --keep-${_slot%%:*} $_v"
done
if [ -z "$restic_prune" ]; then
	check_result "$E_INVALID" "no retention policy for $user - forget without one keeps everything"
fi

# One derivation for both halves: forget decides on snapshots, the packages follow the survivors.
restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf forget $restic_prune --prune \
	> /dev/null 2>&1
kept=$(restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json snapshots 2> /dev/null \
	| grep -o '"meta:[^"]*"' | tr -d '"')
if [ -n "$kept" ]; then
	for _pkg in "$BACKUP/$user/$user".*.meta.tgz; do
		[ -f "$_pkg" ] || continue
		_tag="meta:$(basename "$_pkg" .meta.tgz)"
		# The run that is writing right now is not in the list it would be measured against (#787).
		[ "$_tag" = "meta:$user.$stamp" ] && continue
		grep -qxF "$_tag" <<< "$kept" || rm -f "$_pkg"
	done
fi

# Send notification
if [ -e "$BACKUP/$user/$user.log" ] && [ "$notify" = "yes" ]; then
	subj="$user → backup has been completed"
	email=$(get_user_value '$CONTACT')
	cat $BACKUP/$user/$user.log | $SENDMAIL -s "$subj" "$email" "$notify"
	$BIN/h-add-user-notification "$user" "Snapshot created successfully" "Snap shot of user successfully created"
fi

# Deleting task from queue
sed -i "/h-backup-user-restic $user /d" $CONF_DIR/queue/backup.pipe

# Logging
$BIN/h-log-action "$user" "Info" "Backup" "Backup created."
$BIN/h-log-action "system" "Info" "Backup" "Backup created (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
