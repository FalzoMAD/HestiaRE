#!/bin/bash
# info: delete user backup
# options: USER BACKUP
#
# example: h-delete-user-backup admin admin.2012-12-21_00-10-00.tar
#
# This function deletes user backup.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER BACKUP'
is_format_valid 'user' 'backup'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'backup' 'BACKUP' "$2"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

backup_folder="$BACKUP"

line=$(grep "BACKUP='$backup'" $USER_DATA/backup.conf)
parse_object_kv_list "$line"

deleted=0
if [[ "$TYPE" =~ "sftp" ]]; then
	sftp_delete "$backup"
	deleted=1
fi
if [[ "$TYPE" =~ "ftp" ]] && [ "$deleted" == "0" ]; then
	ftp_delete "$backup"
fi
if [[ "$TYPE" =~ "rclone" ]]; then
	rclone_delete "$backup"
fi
# An adopted archive is the operator's own file, put into the backup folder by hand. Forgetting the
# record is this command's job; deleting a migration source is not.
if [[ "$TYPE" =~ "local" ]] && [ "$ADOPTED" != 'yes' ]; then
	rm -f "$backup_folder/$2"
fi
if [ "$ADOPTED" = 'yes' ]; then
	echo "$2 was adopted - the record is gone, the file is still in $backup_folder"
fi

# Deleting backup
sed -i "/BACKUP='$2' /d" "$USER_DATA/backup.conf"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Update counter
U_BACKUPS=$(grep BACKUP $USER_DATA/backup.conf | wc -l)
update_user_value "$user" '$U_BACKUPS' "$U_BACKUPS"

# Logging
$BIN/h-log-action "$user" "Info" "Backup" "Deleted backup (Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit
