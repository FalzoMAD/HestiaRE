#!/bin/bash
# info: list php config parameters
# options: [FORMAT]
#
# example: h-list-sys-php-config
#
# This function for obtaining the list of php config parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	parse_object_kv_list "$(echo "$config" | egrep "$keys" \
		| sed -e "s/[ ]*=/=/" -e "s/=[ ]*/=\'/" -e "s/$/'/")"
	json_escape memory_limit max_execution_time max_input_time upload_max_filesize post_max_size display_errors error_reporting config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "memory_limit": "%s",\n' "$memory_limit"
	printf '        "max_execution_time": "%s",\n' "$max_execution_time"
	printf '        "max_input_time": "%s",\n' "$max_input_time"
	printf '        "upload_max_filesize": "%s",\n' "$upload_max_filesize"
	printf '        "post_max_size": "%s",\n' "$post_max_size"
	printf '        "display_errors": "%s",\n' "$display_errors"
	printf '        "error_reporting": "%s",\n' "$error_reporting"
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "$config" | egrep "$keys" | tr -d '='
	echo "config_path $config_path"
}

# PLAIN list function
plain_list() {
	echo "$config" | egrep "$keys" | tr -d '='
	echo "config_path $config_path"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config path
config_path=$(find /etc/php* -name php.ini)
config_count=$(echo "$config_path" | wc -l)
if [ "$config_count" -gt 1 ]; then
	multiphp_versions=$(ls -d /etc/php/*/fpm/pool.d 2> /dev/null | wc -l)
	if [ "$WEB_BACKEND" = 'php-fpm' ] || [ "$multiphp_versions" -gt 0 ]; then
		config_path=$(echo "$config_path" | grep fpm)
	else
		config_path=$(echo "$config_path" | grep apache)
	fi
fi

# Defining keys
keys="memory_limit |max_execution_time |max_input_time"
keys="$keys |upload_max_filesize |post_max_size"
keys="$keys |display_errors |error_reporting "

# Reading config
config=$(cat $config_path | grep -v "^;")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
