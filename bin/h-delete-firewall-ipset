#!/bin/bash
# info: delete firewall ipset
# options: NAME
#
# example: h-delete-firewall-ipset country-nl
#
# This function removes ipset from system and from hestia

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

ip_name=${1}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'NAME'
is_format_valid 'ip_name'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Define variables for ipset configuration
ipset_hstobject="$CONF_DIR/firewall/ipset"
is_object_valid "$ipset_hstobject" 'LISTNAME' "$ip_name"
ip_version="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$IP_VERSION')"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

IPSET_PATH="$CONF_DIR/firewall/ipset"
IPSET_FILE="${ip_name}.${ip_version}"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# A set still matched by a rule cannot go: nft refuses to delete it, and that refusal is the check. The
# old code asked ipset the same question but then tested the wrong exit status, so it never actually
# blocked. Removing the object while a rule references it would make the next render fail validation.
if fw_set_exists "$ip_name" && ! fw_set_destroy "$ip_name"; then
	check_result "$E_INUSE" "IP list ${ip_name} is still referenced by a firewall rule. Cannot remove"
fi

sed -i "/LISTNAME='$ip_name'/d" "${IPSET_PATH}.conf"
rm -f "${IPSET_PATH}/${IPSET_FILE}.iplist"

# Nothing left to refresh: stop the timer rather than leave it firing against an empty object list.
grep -q "LISTNAME=" "${IPSET_PATH}.conf" 2> /dev/null || fw_blocklist_timer_remove

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "Firewall" "IPset IP list deleted (Name: $ip_name)."
log_event "$OK" "$ARGUMENTS"

exit
