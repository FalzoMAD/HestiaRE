#!/bin/bash
# info: update backup exclusion list
# options: USER FILE
#
# example: h-update-user-backup-exclusions admin /tmp/backup_exclusions
#
# This function for updating backup exclusion list

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
vfile=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

is_file_available() {
	if [ ! -e "$vfile" ]; then
		check_result "$E_NOTEXIST" "file $vfile doesn't exist"
	fi
}

is_file_valid() {
	exclude="[!|#|$|^|&|(|)|{|}|<|>|?|\|\"|;|%|\`]"
	if [[ "$(cat $vfile)" =~ $exclude ]]; then
		check_result "$E_INVALID" "invalid characters in the exlusion list"
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_file_available
is_file_valid

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Flush variables
WEB=''
MAIL=''
DB=''
CRON=''
USER=''

# Source exclusion list
source_conf "$vfile"

# The backup tests CRON only against '*', so a job name would be stored and then ignored.
if [ -n "$CRON" ] && [ "$CRON" != '*' ]; then
	check_result "$E_INVALID" "cron accepts only '*' (all jobs) or empty - single jobs cannot be excluded"
fi

# No DNS key: source_conf turns an absent key into an unset variable. The empty DNS= in the
# backup.conf record stays, because a record's field set is a HestiaCP-facing interface.
echo "WEB='$WEB'" > $USER_DATA/backup-excludes.conf
echo "MAIL='$MAIL'" >> $USER_DATA/backup-excludes.conf
echo "DB='$DB'" >> $USER_DATA/backup-excludes.conf
echo "CRON='$CRON'" >> $USER_DATA/backup-excludes.conf
echo "USER='$USER'" >> $USER_DATA/backup-excludes.conf
chmod 660 $USER_DATA/backup-excludes.conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "Backups" "Updated backup exclusion list."
log_event "$OK" "$ARGUMENTS"

exit
