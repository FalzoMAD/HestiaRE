#!/bin/bash
# info: backup system user with all its objects
# options: USER NOTIFY
#
# example: h-backup-user admin yes
#
# This function is used for backing up user with all its domains and databases.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
format=${3-plain}
# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# JSON list function
json_list() {
	echo '{'
	json_escape BACKUP TYPE WEB MAIL DB CRON UDIR RUNTIME TIME DATE
	printf '    "%s": {\n' "$BACKUP"
	printf '		"TYPE": "%s",\n' "$TYPE"
	printf '		"WEB": "%s",\n' "$WEB"
	printf '		"MAIL": "%s",\n' "$MAIL"
	printf '		"DB": "%s",\n' "$DB"
	printf '		"CRON": "%s",\n' "$CRON"
	printf '		"UDIR": "%s",\n' "$UDIR"
	printf '		"RUNTIME": "%s",\n' "$RUNTIME"
	printf '		"TIME": "%s",\n' "$TIME"
	printf '		"DATE": "%s"\n' "$DATE"
	echo '	}'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "BACKUP:         $BACKUP"
	echo "TYPE:           $TYPE"
	echo "RUNTIME:        $RUNTIME min"
	echo "WEB:            ${WEB//,/ }"
	echo "MAIL:           ${MAIL//,/ }"
	echo "DB:             ${DB//,/ }"
	echo "CRON:           $CRON"
	echo "UDIR:           ${UDIR//,/ }"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "$BACKUP\t$TYPE\t$WEB\t$MAIL\t$DB\t$CRON\t"
	echo -e "$UDIR\t$RUNTIME\t$TIME\t$DATE"
}

source_conf $HESTIA/conf/restic.conf

restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json dump $snapshot /home/$user/backup/backup.conf > /home/$user/tmp/backup.conf

parse_object_kv_list "$(cat /home/$user/tmp/backup.conf)"

rm /home/$user/tmp/backup.conf
# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
