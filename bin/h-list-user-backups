#!/bin/bash
# info: list user backups
# options: USER [FORMAT]
#
# example: h-list-user-backups admin
#
# This function for obtaining the list of available user backups.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep BACKUP $USER_DATA/backup.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		json_escape BACKUP TYPE SIZE WEB MAIL DB CRON UDIR MAP MODE BASE RUNTIME TIME DATE
		printf '    "%s": {\n' "$BACKUP"
		printf '        "TYPE": "%s",\n' "$TYPE"
		printf '        "SIZE": "%s",\n' "$SIZE"
		printf '        "WEB": "%s",\n' "$WEB"
		printf '        "MAIL": "%s",\n' "$MAIL"
		printf '        "DB": "%s",\n' "$DB"
		printf '        "CRON": "%s",\n' "$CRON"
		printf '        "UDIR": "%s",\n' "$UDIR"
		printf '        "MAP": "%s",\n' "$MAP"
		printf '        "MODE": "%s",\n' "${MODE:-full}"
		printf '        "BASE": "%s",\n' "$BASE"
		printf '        "RUNTIME": "%s",\n' "$RUNTIME"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/backup.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "BACKUP   TYPE   SIZE  TIME  DATE"
	echo "------   ----   ---   ----  ----"
	while read -r str; do
		parse_object_kv_list "$str"
		echo "$BACKUP $TYPE $SIZE $RUNTIME $DATE"
	done < <(cat $USER_DATA/backup.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read -r str; do
		parse_object_kv_list "$str"
		echo -ne "$BACKUP\t$TYPE\t$SIZE\t$WEB\t$MAIL\t$CRON\t$UDIR\t$MAP\t${MODE:-full}\t$BASE\t"
		echo -e "$RUNTIME\t$TIME\t$DATE"
	done < <(cat $USER_DATA/backup.conf)
}

# CSV list function
csv_list() {
	IFS=$'\n'
	echo "BACKUP,TYPE,SIZE,WEB,MAIL,CRON,UDIR,MAP,MODE,BASE,RUNTIME,TIME,DATE"
	while read -r str; do
		parse_object_kv_list "$str"
		echo -n "$BACKUP,$TYPE,$SIZE,\"$WEB\",\"$MAIL\",\"$CRON\","
		echo "\"$UDIR\",$MAP,${MODE:-full},$BASE,$RUNTIME,$TIME,$DATE"
	done < <(cat $USER_DATA/backup.conf)
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking config
conf=$USER_DATA/backup.conf
if [ ! -e "$conf" ]; then
	touch $conf
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
