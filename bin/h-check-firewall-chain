#!/bin/bash
# info: check that a firewall jail chain is wired
# options: CHAIN
#
# example: h-check-firewall-chain SSH
#
# fail2ban's actioncheck. Exits 0 while the jail chain exists and the base chain still jumps to it.
#
# Replaces a grep for the backend's own output, which goes stale as soon as the renderer changes. A wrong
# "missing" is expensive: fail2ban answers a failed actioncheck with actionstop + actionstart, and
# actionstop drops every banlist.conf row for the chain.
# No v-* symlink.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CHAIN'
is_format_valid 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

fw_jail_wired "$chain"
exit $?
