#!/bin/bash
# info: update user disk usage
# options: USER
#
# example: h-update-user-disk admin
#
# The functions recalculates disk usage and updates database.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Saving old IFS
OLDIFS=$IFS
IFS=$(echo -en "\n\b")

#Starting update disk space excluding web, mail, conf directory
disk_usage='0'
# The companion image store is counted here on purpose, unlike in h-backup-user. These
# answer different questions: the archive excludes it because images are pulled again,
# while this is what the customer actually occupies on disk. Excluding it would
# understate usage for exactly the customers using the most of it (#389).
# .dumps is the restic stage, not the customer's data (#217): counting it would make the reported
# usage jump by the whole raw dump set during a run, and stay there after a failed one.
disk_usage=$(du -shm $HOMEDIR/$user --exclude $HOMEDIR/$user/web --exclude $HOMEDIR/$user/mail --exclude $HOMEDIR/$user/conf --exclude $HOMEDIR/$user/.dumps | cut -f 1)

# Restoring old IFS
IFS=$OLDIFS

# Updating disk value in config
update_user_value "$user" '$U_DISK_DIRS' "$disk_usage"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Recalculating user disk space
recalc_user_disk_usage

# Logging
log_event "$OK" "$ARGUMENTS"

exit
