#!/bin/bash
# info: Install SnappyMail webmail client
# options: [MODE]
#
# This function installs the SnappyMail webmail client.
#
# Source is the GitHub release for the version pinned in share/manifest.json, not the
# project's own host: snappymail.eu went dark in Aug 2026 (ICMP alive, TCP silently
# dropped) and the old unbounded wget turned that into a 45-minute hang (#573). A pinned
# version is also the only one we can verify - "latest" is unpinnable by definition.
#
# The tarball is fetched and checked BEFORE anything is removed, so an unreachable source
# leaves an existing installation intact instead of destroying it on the way down.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

sm_v=$(manifest_get '.software_versions.snappymail')

MODE=$1
UPDATE="no"
SM_FILE="snappymail-${sm_v}.tar.gz"
# For removal of folder
SM_EXTRACT_MAIN="snappymail"

SM_URL="https://github.com/the-djmaze/snappymail/releases/download/v${sm_v}/snappymail-${sm_v}.tar.gz"

# Folder paths
SM_INSTALL_DIR="/var/lib/snappymail"
SM_CONFIG_DIR="/etc/snappymail"
SM_LOG="/var/log/snappymail"

# Bounded on purpose: wget's defaults are 20 tries at a 900s read timeout, so a host that
# drops SYNs costs ~45 minutes before the first error surfaces.
sm_fetch() {
	local dest="$1"
	wget "$SM_URL" --timeout=30 --tries=3 --retry-connrefused --quiet -O "$dest" || return 1
	# wget -O leaves a 0-byte file behind on failure, and that file used to pass the
	# [ -f ] check and take the whole install down silently (#573).
	[ -s "$dest" ] || return 1
	gzip -t "$dest" 2> /dev/null || return 1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-snappymail can only be executed by the root user"
	exit 10
fi

# Ensure that $HESTIA (/usr/local/hestia/) and other variables are valid.
if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

if [ -z "$HOMEDIR" ]; then
	echo "ERROR: Environment variables not present, installation aborted."
	exit 2
fi

if [ -z "$(echo "$DB_SYSTEM" | grep -w 'mysql')" ]; then
	echo "ERROR: Mysql not available. Installation aborted"
	exit 2
fi

# Without it the release URL would resolve to .../download/v/snappymail-.tar.gz and 404.
if [ -z "$sm_v" ]; then
	echo "ERROR: no SnappyMail version pinned in share/manifest.json. Installation aborted"
	exit 2
fi

# Get current version
if [ -f "/var/lib/snappymail/data/VERSION" ]; then
	version=$(cat $SM_INSTALL_DIR/data/VERSION)
	if [ "$version" == "$sm_v" ]; then
		echo "Error: Installed version ($version) is equal to the available version ($sm_v)"
		exit 2
	else
		UPDATE="yes"
	fi
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$UPDATE" == "no" ]; then
	# Fetched before the removals below: a dead source must not cost the running install.
	sm_tmp="$(mktemp -t snappymail.XXXXXX.tar.gz)"
	if ! sm_fetch "$sm_tmp"; then
		rm -f "$sm_tmp"
		echo "ERROR: could not download SnappyMail $sm_v from $SM_URL"
		echo "       Installation aborted - nothing was changed."
		exit 2
	fi

	rm -f -r $SM_INSTALL_DIR
	rm -f -r $SM_CONFIG_DIR

	mkdir $SM_INSTALL_DIR
	mkdir $SM_CONFIG_DIR

	cd "$SM_INSTALL_DIR"
	mv "$sm_tmp" "${SM_INSTALL_DIR}/${SM_FILE}"

	key=$(openssl rand -hex 4)
	suffix=$(openssl rand -hex 4)
	admin_account="admin_$key"
	admin_password=$(generate_password)

	echo "Username: admin_$key" > ~/.snappymail
	echo "Password: $admin_password" >> ~/.snappymail
	echo "Admin Panel key: admin_$suffix" >> ~/.snappymail

	tar -xzf ${SM_INSTALL_DIR}/${SM_FILE}
	# No set -e here, so an unpacked-but-empty tree used to run the whole rest of this
	# script and exit 0, leaving a dangling data symlink and a WEBMAIL_SYSTEM that claimed
	# an install nobody had (#573). Stop at the first thing that proves the tree is real.
	if [ ! -s ./data/VERSION ]; then
		echo "ERROR: SnappyMail archive did not unpack (no data/VERSION). Installation aborted."
		exit 2
	fi
	version=$(cat ./data/VERSION)

	mv ./data $SM_CONFIG_DIR/
	ln -s $SM_CONFIG_DIR/data/ ./data

	# Create cache folder and set permissions
	mkdir -p "$SM_CONFIG_DIR/data/_data_/_default_/cache/"
	chown -R www-data:www-data ./data

	if [ -f '/usr/bin/mariadb' ]; then
		mariadb -e "CREATE DATABASE snappymail" 2>&1
		r=$(generate_password)
		mariadb -e "GRANT ALL ON snappymail.*
		 TO snappymail@localhost IDENTIFIED BY '$r'"
	else
		mysql -e "CREATE DATABASE snappymail" 2>&1
		r=$(generate_password)
		mysql -e "GRANT ALL ON snappymail.*
		 TO snappymail@localhost IDENTIFIED BY '$r'"
	fi
	# Temporarily set the permissions to www-data
	chown -R www-data:www-data $SM_CONFIG_DIR/
	php -f $HESTIA/share/snappymail/install.php "admin_$key" "admin_$suffix" "$admin_password" "$r" "$BACKEND_PORT"

	# back to caddy (the FPM pool user); explicit 0750 keeps the data dir caddy-private
	chown -R caddy:caddy $SM_CONFIG_DIR/
	chmod -R 750 $SM_CONFIG_DIR/data

	# Auth-log target for the fail2ban webmail jail. SnappyMail runs as caddy and writes
	# /var/log/snappymail/fail2ban/auth.txt (see share/snappymail/install.php); create the root here so
	# the first failed login has somewhere to write and the jail has a file to watch.
	mkdir -p /var/log/snappymail
	chown caddy:caddy /var/log/snappymail
	chmod 750 /var/log/snappymail
	# the fail2ban snappymail-auth jail tails fail2ban/auth.txt, so the log must rotate
	cp -f "$HESTIA/share/snappymail/logrotate" /etc/logrotate.d/snappymail

	# Remove the downloaded file
	rm ${SM_INSTALL_DIR}/${SM_FILE}
	# Add robots.txt
	echo "User-agent: *" > $SM_INSTALL_DIR/robots.txt
	echo "Disallow: /" >> $SM_INSTALL_DIR/robots.txt

	# Panel-Caddy delivery: caddy FPM pool behind the :8091 loopback listener
	# (the caddy-owned data dir only works because the pool runs as caddy)
	mkdir -p $SM_INSTALL_DIR/tmp
	chown caddy:caddy $SM_INSTALL_DIR/tmp
	chmod 770 $SM_INSTALL_DIR/tmp
	cp -f "$HESTIA/share/panel-php/pool.d/snappymail.conf" /etc/php/hestia/fpm/pool.d/snappymail.conf
	systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true
	cp -f "$HESTIA/share/panel-caddy/webmail-snappymail.conf" /etc/caddy/webmail-snappymail.conf
	systemctl try-restart caddy > /dev/null 2>&1 || true

	# Updating hestia.conf
	if [ -z "$(grep WEBMAIL_SYSTEM $HESTIA/conf/hestia.conf)" ]; then
		$BIN/h-change-sys-config-value 'WEBMAIL_SYSTEM' 'snappymail'
	else
		if [ -z "$(echo "$WEBMAIL_SYSTEM" | grep -w 'snappymail')" ]; then
			if [ -n "$WEBMAIL_SYSTEM" ]; then
				$BIN/h-change-sys-config-value 'WEBMAIL_SYSTEM' "snappymail,$WEBMAIL_SYSTEM"
			else
				$BIN/h-change-sys-config-value 'WEBMAIL_SYSTEM' "snappymail"
			fi
		fi
	fi

else
	if [ ! -s "${SM_INSTALL_DIR}/${SM_FILE}" ] && ! sm_fetch "${SM_INSTALL_DIR}/${SM_FILE}"; then
		rm -f "${SM_INSTALL_DIR}/${SM_FILE}"
		echo "ERROR: could not download SnappyMail $sm_v from $SM_URL"
		echo "       Update aborted - the installed version is untouched."
		exit 2
	fi

	version=$(cat $SM_INSTALL_DIR/data/VERSION)
	cd $SM_INSTALL_DIR
	mkdir -p /tmp/snappy/
	tar -xzf "$SM_FILE" -C /tmp/snappy/
	version_source=$(cat /tmp/snappy/data/VERSION)
	# check the version in the tarball in case hestia hasn't updated yet
	if [ "$version" != "$version_source" ]; then
		tar -xzf ${SM_INSTALL_DIR}/${SM_FILE}
		rm $SM_INSTALL_DIR/$SM_FILE
	fi
	rm -fr /tmp/snappy
fi

# re-render mail domains so they pick up the new client immediately
$BIN/h-update-mail-templates yes > /dev/null 2>&1 || true

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

set_install_component MAIL_WEBMAILER SNAPPYMAIL

if [ "$UPDATE" = "yes" ]; then
	$BIN/h-log-action "system" "Info" "Plugins" "SnappyMail updated (Version: $version)."
else
	$BIN/h-log-action "system" "Info" "Plugins" "SnappyMail enabled (Version: $version)."
fi
# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/func/fail2ban.sh
source "$HESTIA/func/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"
