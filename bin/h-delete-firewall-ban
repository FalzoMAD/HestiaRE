#!/bin/bash
# info: delete firewall blocking rule
# options: IP_CIDR CHAIN
#
# example: h-delete-firewall-ban 198.11.130.250 MAIL
#
# This function deletes blocking rule from system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_cidr=$1
chain=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# Defining absolute path for iptables and fail2ban-client
f2bcli="/usr/bin/fail2ban-client"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP_CIDR CHAIN'
is_format_valid 'ip_cidr' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

conf="$CONF_DIR/firewall/banlist.conf"
# CHAIN='ALL' means every chain this address is banned in, so the pattern stops after the opening quote.
# It used to read CHAIN='*', which happened to do the same thing only because * is a BRE quantifier on the
# preceding quote rather than a wildcard - the right answer by accident.
if [ "$chain" == "ALL" ]; then
	check_ip=$(grep "IP='$ip_cidr' CHAIN='" $conf)
	if [ -z "$check_ip" ]; then
		exit
	fi
	grep "IP='$ip_cidr' CHAIN='" $conf | while read -r line; do
		parse_object_kv_list $line

		# Deleting ip from banlist. sip is escaped for the SED PATTERN only; fail2ban gets the raw address,
		# since a CIDR handed to unbanip as 10.0.0.0\/8 is simply never found.
		sip=$(echo "$IP" | sed "s|/|\\\/|g")
		sed -i "/IP='$sip' CHAIN='$CHAIN'/d" $conf
		fw_ban_delete "$CHAIN" "$ip_cidr"
		for f2bjail in $("$f2bcli" status | grep -i 'Jail list:' | cut -d':' -f2- | sed -E 's/\s*//g' | tr ',' ' '); do
			if "$f2bcli" get "$f2bjail" actions | grep -Eq "^hestia-$CHAIN" 2> /dev/null; then
				"$f2bcli" set "$f2bjail" unbanip "$IP" &> /dev/null
			fi
		done
	done
else
	# Checking ip in banlist
	check_ip=$(grep "IP='$ip_cidr' CHAIN='$chain'" $conf 2> /dev/null)
	if [ -z "$check_ip" ]; then
		exit
	fi

	# Deleting ip from banlist. sip is escaped for the SED PATTERN only - fail2ban gets the raw address.
	sip=$(echo "$ip_cidr" | sed "s|/|\\\/|g")
	sed -i "/IP='$sip' CHAIN='$chain'/d" $conf
	fw_ban_delete "$chain" "$ip_cidr"
	for f2bjail in $("$f2bcli" status | grep -i 'Jail list:' | cut -d':' -f2- | sed -E 's/\s*//g' | tr ',' ' '); do
		if "$f2bcli" get "$f2bjail" actions | grep -Eq "^hestia-$chain" 2> /dev/null; then
			"$f2bcli" set "$f2bjail" unbanip "$ip_cidr" &> /dev/null
		fi
	done

fi

# Changing permissions
chmod 660 $conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "Firewall" "Removed IP from ban list (IP: $ip_cidr, Service: $chain)."
log_event "$OK" "$ARGUMENTS"

exit
