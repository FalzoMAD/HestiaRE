#!/bin/bash
# info: check user password
# options: USER PASSWORD [IP] [RETURN_HASH]
#
# example: h-check-user-password admin qwerty1234
#
# This function verifies user password from file

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
password=$2
HIDE=2
ip46=${3-127.0.0.1}
return_hash=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER PASSWORD [IP] [RETURN_HASH]'
is_format_valid 'user' 'ip46'

# Checking user
if [ ! -d "$CONF_DIR/users/$user" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

is_password_valid

# Checking empty password
if [[ -z "$password" ]]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing user's salt
shadow=$(grep "^$user:" /etc/shadow | cut -f 2 -d :)

if echo "$shadow" | grep -qE '^\$[0-9a-z]+\$[^\$]+\$'; then
	salt=$(echo "$shadow" | cut -f 3 -d \$)
	method=$(echo "$shadow" | cut -f 2 -d \$)
	if [ "$method" = "y" ]; then
		method="yescrypt"
	elif [ "$method" -eq '1' ]; then
		method='md5'
	elif [ "$method" -eq '6' ]; then
		method='sha-512'
	else
		echo "Error: password missmatch"
		echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
		exit 9
	fi
else
	salt=${shadow:0:2}
	method='des'
fi

if [ -z "$salt" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

if [ "$method" = "yescrypt" ]; then
	# mkpasswd gets the SETTING (method, parameters, salt) - never the whole hash. Handed the full
	# hash it doubles as a comparator: crypt(3) hashes against the setting prefix, mkpasswd then
	# finds its result differs from what it was given and exits 2 with "Method not supported by
	# crypt(3)." on stderr. So every wrong password wrote that line into the panel's FPM log, where
	# it is indistinguishable from a libcrypt that genuinely cannot do yescrypt - the one fault it
	# would matter to see. As a plain hash function the exit code means only what it says, and the
	# shadow comparison below is the single step that decides.
	if ! hash=$(mkpasswd "$password" "${shadow%\$*}\$" 2> /dev/null); then
		# Only mkpasswd itself failing reaches here: an absent binary, or a libcrypt without
		# yescrypt. Named, so an operator can tell a real fault from the wrong password it used to
		# look like. Not phrased as "failed to login", but that only keeps THIS line out of the
		# count fail2ban makes: the panel passes the refusal on to h-check-user-hash, which writes
		# its own "failed to login" anyway (measured). A broken mkpasswd therefore still bans - the
		# named line above it is what says why.
		echo "$date $time $user $ip46 yescrypt hashing unavailable - check mkpasswd (whois) and libcrypt" \
			>> $HESTIA/log/auth.log
		echo "Error: password missmatch"
		exit 9
	fi
else
	# Generating hash
	set -o noglob
	hash=$($BIN/h-generate-password-hash "$method" "$salt" <<< "$password")
	if [[ -z "$hash" ]]; then
		echo "Error: password missmatch"
		if [ -z "$return_hash" ]; then
			echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
		fi
		exit 9
	fi
fi

# Checking hash
result=$(grep "^$user:$hash:" /etc/shadow 2> /dev/null)
if [[ -z "$result" ]]; then
	echo "Error: password missmatch"
	if [ -z "$return_hash" ]; then
		echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	fi
	exit 9
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

if [ -n "$return_hash" ]; then
	echo $hash
else
	# If return_hash is pressent it will log a second time
	echo "$date $time $user $ip46 successfully logged in" >> $HESTIA/log/auth.log
fi

exit
