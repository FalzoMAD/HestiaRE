#!/bin/bash
# info: update user disk quota
# options: USER
#
# example: h-update-user-quota alice
#
# Applies the package DISK_QUOTA as a project quota hard limit on the user's
# home tree (project id = uid). Tree-based, not owner-based: files written by
# php-fpm, the docker companion or subuids all count against the customer (#211).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Gated here, not only in the callers: a fifth caller must inherit the safety,
# and the installer runs h-* against a half-built box (blast-radius rule).
quota_is_active || exit 0
quota_home_fs || exit 0

quota_project_assign "$user"

uid=$(id -u "$user" 2> /dev/null)
[ -n "$uid" ] || exit 0
quota=$(get_user_value '$DISK_QUOTA')

# unlimited -> 0: the record keeps the project-wide 'unlimited' sentinel, 0 is
# setquota's own grammar for "no limit". Hard only, soft unused (decision in
# #211): a soft window without a delivery channel for its warning is just a
# delayed hard limit nobody hears about.
if [ "$quota" = 'unlimited' ] || [ -z "$quota" ]; then
	setquota -P "$uid" 0 0 0 0 "$QUOTA_MNT" 2> /dev/null
else
	setquota -P "$uid" 0 $((quota * 1024)) 0 0 "$QUOTA_MNT" 2> /dev/null
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
