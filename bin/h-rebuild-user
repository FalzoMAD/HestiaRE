#!/bin/bash
# info: rebuild system user
# options: USER [RESTART]
#
# example: h-rebuild-user admin yes
#
# This function rebuilds system user account.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
restart=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
check_user=$(is_object_unsuspended 'user' 'USER' "$user")
if [ -n "$check_user" ]; then
	exit
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update disk quota
if [ "$DISK_QUOTA" = 'yes' ]; then
	$BIN/h-update-user-quota "$user"
fi

# Update cgroup
if [ "$RESOURCES_LIMIT" = 'yes' ]; then
	$BIN/h-update-user-cgroup "$user"
fi

# not gated on RESOURCES_LIMIT - see h-change-user-package
source $HESTIA/include/docker.sh
docker_slice_apply "$user" "$(get_user_value '$DOCKER_LIMIT')"

# Rebuild user
rebuild_user_conf

# Update user counters
$BIN/h-update-user-counters "$user"

# Update account usage statistics
$BIN/h-update-user-stats "$user"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "Rebuilt user profile (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
