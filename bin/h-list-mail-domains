#!/bin/bash
# info: list mail domains
# options: USER [FORMAT]
#
# example: h-list-mail-domains admin
#
# This function of obtaining the list of all user domains.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep DOMAIN $USER_DATA/mail.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		json_escape DOMAIN ANTIVIRUS ANTISPAM REJECT RATE_LIMIT DKIM CATCHALL ACCOUNTS U_DISK SSL SUSPENDED TIME DATE WEBMAIL_ALIAS WEBMAIL
		printf '    "%s": {\n' "$DOMAIN"
		printf '        "ANTIVIRUS": "%s",\n' "$ANTIVIRUS"
		printf '        "ANTISPAM": "%s",\n' "$ANTISPAM"
		printf '        "REJECT": "%s",\n' "$REJECT"
		printf '        "RATE_LIMIT": "%s",\n' "$RATE_LIMIT"
		printf '        "DKIM": "%s",\n' "$DKIM"
		printf '        "CATCHALL": "%s",\n' "$CATCHALL"
		printf '        "ACCOUNTS": "%s",\n' "$ACCOUNTS"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "SSL": "%s",\n' "$SSL"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s",\n' "$DATE"
		printf '        "WEBMAIL_ALIAS": "%s",\n' "$WEBMAIL_ALIAS"
		printf '        "WEBMAIL": "%s"\n' "$WEBMAIL"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/mail.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "DOMAIN   ANTIVIRUS   ANTISPAM   DKIM  SSL   ACC   DISK   SPND   DATE"
	echo "------   ---------   --------   ----  ---   ---   ----   ---   ----"
	while read str; do
		parse_object_kv_list "$str"
		echo -n "$DOMAIN $ANTIVIRUS $ANTISPAM $DKIM $SSL $ACCOUNTS $U_DISK "
		echo "$SUSPENDED $DATE"
	done < <(cat $USER_DATA/mail.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		echo -ne "$DOMAIN\t$ANTIVIRUS\t$ANTISPAM\t$DKIM\t$SSL\$CATCHALL\t"
		echo -e "$ACCOUNTS\t$U_DISK\t$SUSPENDED\t$TIME\t$DATE\t$WEBMAIL_ALIAS\t$WEBMAIL"
	done < <(cat $USER_DATA/mail.conf)
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
