#!/bin/bash
# info: list nginx config parameters
# options: [FORMAT]
#
# example: h-list-sys-nginx-config
#
# This function for obtaining the list of nginx config parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	parse_object_kv_list "$(echo "$config" | egrep "$keys" | tr -d ';' | awk '{print $1"="$2}')"
	json_escape worker_processes worker_connections send_timeout proxy_connect_timeout proxy_send_timeout proxy_read_timeout client_max_body_size gzip gzip_comp_level charset config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "worker_processes": "%s",\n' "$worker_processes"
	printf '        "worker_connections": "%s",\n' "$worker_connections"
	printf '        "send_timeout": "%s",\n' "$send_timeout"
	printf '        "proxy_connect_timeout": "%s",\n' "$proxy_connect_timeout"
	printf '        "proxy_send_timeout": "%s",\n' "$proxy_send_timeout"
	printf '        "proxy_read_timeout": "%s",\n' "$proxy_read_timeout"
	printf '        "client_max_body_size": "%s",\n' "$client_max_body_size"
	printf '        "gzip": "%s",\n' "$gzip"
	printf '        "gzip_comp_level": "%s",\n' "$gzip_comp_level"
	printf '        "charset": "%s",\n' "$charset"
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "$config" | egrep "$keys" | tr -d ';'
	echo "config_path    $config_path"
}

# PLAIN list function
plain_list() {
	echo "$config" | egrep "$keys" | tr -d ';'
	echo "config_path $config_path"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config path
config_path='/etc/nginx/nginx.conf'

# Defining keys
keys="worker_processes |worker_connections |send_timeout"
keys="$keys |proxy_connect_timeout |proxy_send_timeout"
keys="$keys |proxy_read_timeout |client_max_body_size"
keys="$keys |gzip |gzip_comp_level |charset "

# Reading nginx config
config=$(cat $config_path)

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
