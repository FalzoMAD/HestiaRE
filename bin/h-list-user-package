#!/bin/bash
# info: list user package
# options: PACKAGE [FORMAT]
#
# This function for getting the list of system ip parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1
PACKAGE=$package
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# JSON list function
json_list() {
	echo '{'
	json_escape PACKAGE WEB_TEMPLATE BACKEND_TEMPLATE PROXY_TEMPLATE WEB_DOMAINS WEB_ALIASES MAIL_DOMAINS MAIL_ACCOUNTS RATE_LIMIT DATABASES CRON_JOBS DISK_QUOTA DOCKER_LIMIT BANDWIDTH SHELL BACKUPS BACKUPS_MODE TIME DATE
	printf '    "%s": {\n' "$PACKAGE"
	printf '        "WEB_TEMPLATE": "%s",\n' "$WEB_TEMPLATE"
	printf '        "BACKEND_TEMPLATE": "%s",\n' "$BACKEND_TEMPLATE"
	printf '        "PROXY_TEMPLATE": "%s",\n' "$PROXY_TEMPLATE"
	printf '        "WEB_DOMAINS": "%s",\n' "$WEB_DOMAINS"
	printf '        "WEB_ALIASES": "%s",\n' "$WEB_ALIASES"
	printf '        "MAIL_DOMAINS": "%s",\n' "$MAIL_DOMAINS"
	printf '        "MAIL_ACCOUNTS": "%s",\n' "$MAIL_ACCOUNTS"
	printf '        "RATE_LIMIT": "%s",\n' "$RATE_LIMIT"
	printf '        "DATABASES": "%s",\n' "$DATABASES"
	printf '        "CRON_JOBS": "%s",\n' "$CRON_JOBS"
	printf '        "DISK_QUOTA": "%s",\n' "$DISK_QUOTA"
	printf '        "DOCKER_LIMIT":"%s",\n' "$DOCKER_LIMIT"
	printf '        "BANDWIDTH": "%s",\n' "$BANDWIDTH"
	printf '        "SHELL": "%s",\n' "$SHELL"
	printf '        "BACKUPS": "%s",\n' "$BACKUPS"
	printf '        "BACKUPS_MODE": "%s",\n' "${BACKUPS_MODE:-full}"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '    }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "PACKAGE:          $PACKAGE"
	echo "WEB TEMPLATE:     $WEB_TEMPLATE"
	echo "BACKEND TEMPLATE: $BACKEND_TEMPLATE"
	echo "PROXY TEMPLATE:   $PROXY_TEMPLATE"
	echo "WEB DOMAINS:      $WEB_DOMAINS"
	echo "WEB ALIASES:      $WEB_ALIASES"
	echo "MAIL DOMAINS:     $MAIL_DOMAINS"
	echo "MAIL ACCOUNTS:    $MAIL_ACCOUNTS"
	echo "RATE_LIMIT:       $RATE_LIMIT"
	echo "DATABASES:        $DATABASES"
	echo "CRON JOBS:        $CRON_JOBS"
	echo "DISK QUOTA:       $DISK_QUOTA"
	echo "DOCKER LIMIT:     $DOCKER_LIMIT"
	echo "BANDWIDTH:        $BANDWIDTH"
	echo "SHELL:            $SHELL"
	echo "BACKUPS:          $BACKUPS"
	echo "TIME:             $TIME"
	echo "DATE:             $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "$PACKAGE\t$WEB_TEMPLATE\t$BACKEND_TEMPLATE\t$PROXY_TEMPLATE\t"
	echo -ne "$WEB_DOMAINS\t$WEB_ALIASES\t"
	echo -ne "$MAIL_DOMAINS\t$MAIL_ACCOUNTS\t$RATE_LIMIT\t$DATABASES\t$CRON_JOBS\t"
	echo -ne "$DOCKER_LIMIT\t"
	echo -e "$DISK_QUOTA\t$BANDWIDTH\t$SHELL\t$BACKUPS\t$TIME\t$DATE"
}

# CSV list function
csv_list() {
	echo -n "PACKAGE,WEB_TEMPLATE,BACKEND_TEMPLATE,PROXY_TEMPLATE,"
	echo -n "WEB_DOMAINS,WEB_ALIASES,"
	echo -n "MAIL_DOMAINS,MAIL_ACCOUNTS,RATE_LIMIT,DATABASES,CRON_JOBS,"
	echo "DISK_QUOTA,DOCKER_LIMIT,BANDWIDTH,SHELL,BACKUPS,TIME,DATE"
	echo -n "$PACKAGE,$WEB_TEMPLATE,$BACKEND_TEMPLATE,$PROXY_TEMPLATE,"
	echo -n "$WEB_DOMAINS,$WEB_ALIASES,"
	echo -n "$MAIL_DOMAINS,$MAIL_ACCOUNTS,$RATE_LIMIT,$DATABASES,$CRON_JOBS,"
	echo "$DISK_QUOTA,$DOCKER_LIMIT,$BANDWIDTH,$SHELL,$BACKUPS,$TIME,$DATE"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking args
check_args '1' "$#" 'PACKAGE [FORMAT]'
is_format_valid 'package'
is_package_valid

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing package
source_conf "$CONF_DIR/packages/$PACKAGE.pkg"

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
