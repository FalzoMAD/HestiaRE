#!/bin/bash
# info: delete firewall chain
# options: CHAIN
#
# example: h-delete-firewall-chain WEB
#
# This function adds new rule to system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source "$HESTIA/func/main.sh"
# shellcheck source=/usr/local/hestia/func/firewall.sh
source "$HESTIA/func/firewall.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CHAIN'
is_format_valid 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Self heal iptables links
heal_iptables_links

# Deleting chain
chains="$CONF_DIR/firewall/chains.conf"
banlist="$CONF_DIR/firewall/banlist.conf"
chain_param=""
[ -f "$chains" ] && chain_param=$(grep "CHAIN='$chain'" "$chains")
if [ -n "$chain_param" ]; then
	parse_object_kv_list "$chain_param"
	sed -i "/CHAIN='$chain'/d" "$chains"
	# NOTE this drops every ban recorded for the chain, and fail2ban calls this as actionstop - so a
	# fail2ban restart wipes the persistent banlist (roadmap D4, fixed in #496). Preserved here.
	sed -i "/CHAIN='$chain'/d" "$banlist"
	fw_jail_detach "$CHAIN" "$PROTOCOL" "$PORT"
fi

# Deleting the backend chain
fw_jail_destroy "$CHAIN"

# Changing permissions
[ -f "$chains" ] && chmod 660 "$chains"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
