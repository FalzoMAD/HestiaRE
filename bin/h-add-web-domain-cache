#!/bin/bash
# info: Enable nginx proxy cache for a domain
# options: USER DOMAIN [DURATION] [RESTART]
#
# example: h-add-web-domain-cache user domain.tld 30m
#
# Successor of the old 'caching' proxy template: the cache directives land as a fragment in
# the domain's nginx.location.d/ (read inside location / of the default proxy vhost), and
# the zone lives in its own file per domain - no shared pool file, so removal is a plain rm
# with no pattern matching. Acceptable duration is seconds (10s), minutes (10m) or days (10d).
# Add "yes" as last parameter to restart nginx.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
duration=${3-5m}
restart=${4-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [DURATION] [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

if ! [[ "$duration" =~ ^[0-9].*[s|m|d]$ ]]; then
	echo "Invalid duration"
	exit 2
fi

if [[ "$duration" =~ ^[0].*[s|m|d]$ ]]; then
	echo "Invalid duration"
	exit 2
fi

# The cache sits in the nginx proxy vhost, so it needs the proxy role
if [ "$PROXY_SYSTEM" != 'nginx' ]; then
	echo "Error: nginx proxy is not available in this web model"
	exit "$E_NOTEXIST"
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Load domain data
parse_object_kv_list $(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)

# Cache directives, read inside location / of the proxy vhost. Content matches the old
# caching template; the bypass rules keep logged-in/admin traffic out of the cache.
frag_dir="$HOMEDIR/$user/conf/web/$domain/nginx.location.d"
mkdir -p "$frag_dir"
chown root:$user "$frag_dir"
chmod 751 "$frag_dir"

no_cache='$no_cache'
cat << EOF > $frag_dir/proxy_cache.conf
proxy_cache $domain;
proxy_cache_valid 200 $duration;
proxy_cache_valid 301 302 10m;
proxy_cache_valid 404 10m;
proxy_cache_bypass $no_cache \$cookie_session \$http_x_update;
proxy_no_cache $no_cache;

set $no_cache 0;

if (\$request_uri ~* "/wp-admin/|/wp-json/|wp-.*.php|xmlrpc.php|/store.*|/cart.*|/my-account.*|/checkout.*|/user/|/admin/|/administrator/|/manager/|index.php") {
	set $no_cache 1;
}

if (\$http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart|woocommerce_cart_hash|PHPSESSID") {
	set $no_cache 1;
}

if (\$http_cookie ~ SESS) {
	set $no_cache 1;
}
EOF
chown root:$user $frag_dir/proxy_cache.conf
chmod 640 $frag_dir/proxy_cache.conf

# One zone file per domain under conf.d/ - loaded before conf.d/domains/*, so the zone
# always exists by the time the vhost references it
echo "proxy_cache_path /var/cache/nginx/$domain levels=1:2 use_temp_path=off keys_zone=$domain:10m inactive=60m max_size=256m;" \
	> "/etc/nginx/conf.d/cache-zone.$domain.conf"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

if [ -z "$PROXY_CACHE" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE' 'ALIAS'
fi
if [ -z "$PROXY_CACHE_DURATION" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE_DURATION' 'ALIAS'
fi

update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE' 'yes'
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE_DURATION' "$duration"

# Restarting proxy server
$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Proxy cache enabled (Domain: $domain, Duration: $duration)."
log_event "$OK" "$ARGUMENTS"

exit
