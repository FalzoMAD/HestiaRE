#!/bin/bash
# info: write a portable archive of a user, in any backup mode
# options: USER [NOTIFY]
#
# example: h-export-user-backup user
#
# No fourth mode: this runs the ordinary archive backup once. What comes out is the format that
# adoption, probe, report and restore already handle, which is how a restic customer migrates
# without a rebuild path from snapshots. BACKUPS_MODE stays the only truth, and retention does not
# touch the result - it is marked as an export and stays out of the rotation.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
notify=${2-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [NOTIFY]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The ordinary run, told by ARGUMENT to mark its record. Nothing else about it changes: same tar,
# same members, same map, same listing. BACKUP_EXPORT_LIMIT is enforced in there, where the exempt
# record is actually written - a limit in this wrapper would miss everyone who calls h-backup-user
# directly, which is anyone who uses the CLI at all.
# Its exit code, not a second message: the inner command already names the reason - the limit with
# the exports it found, or whatever the backup itself failed on - and a generic line under it only
# invites the reader to look for a different cause.
$BIN/h-backup-user "$user" "$notify" yes || exit $?

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
