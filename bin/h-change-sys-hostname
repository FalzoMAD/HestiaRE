#!/bin/bash
# info: change hostname
# options: HOSTNAME
#
# example: h-change-sys-hostname mydomain.tld
#
# This function for changing system hostname.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'HOSTNAME'
is_format_valid 'domain'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

current_hostname="$(hostname)"
if [[ "$current_hostname" == "$domain" ]]; then
	echo "Current hostname \"$current_hostname\" is the same as the new one you want to use"
	echo "I'm not going to change it"
	exit
fi

hostname "$domain"

# Debian/Ubuntu
hostnamectl set-hostname "$domain"
echo "$domain" > /etc/hostname

# Update webmail's password plugin configuration
if [ -d /etc/roundcube/ ]; then
	sed -i "/password_hestia_host/c\$rcmail_config['password_hestia_host'] = '$domain';" /etc/roundcube/plugins/password/config.inc.php
fi
if [ -d /etc/tachyon/ ]; then
	sed -i "/\"hestia_host\":/c\\\"hestia_host\": \"$domain\"," /etc/tachyon/data/_data_/_default_/configs/plugin-change-password.json
fi

# Update /etc/hosts. The ::1 twin only where the kernel has v6: a loopback literal the box cannot
# use turns every lookup of its own hostname into a connect that has to fail first.
if [ -f /etc/hosts ]; then
	hosts_addrs="127.0.0.1"
	[ -e /proc/net/if_inet6 ] && hosts_addrs="$hosts_addrs ::1"
	# a hostname carries dots too, so every side of the match is escaped, not just the address
	cur_re="${current_hostname//./\\.}"
	dom_re="${domain//./\\.}"
	for addr in $hosts_addrs; do
		re="${addr//./\\.}"
		if grep -q -E "^${re}\s{1,}${cur_re}$" /etc/hosts; then
			sed -i -E "s/^${re}\s{1,}${cur_re}$/${addr} ${domain}/" /etc/hosts
		elif ! grep -q -E "^${re}\s{1,}${dom_re}$" /etc/hosts; then
			echo "$addr $domain" >> /etc/hosts
		fi
		# Check whether hostname entries are duplicated and remove all but the last one
		ndup_hosts="$(grep -c -E "^${re}\s{1,}${dom_re}$" /etc/hosts)"
		if [[ "${ndup_hosts}" -gt "1" ]]; then
			nlines_to_del="$((ndup_hosts - 1))"
			lines_to_del="$(grep -n -E "^${re}\s{1,}${dom_re}$" /etc/hosts | head -n${nlines_to_del} | awk -F ':' '{print $1}')"
			list_lines=""
			for i in $lines_to_del; do
				if [[ -z $list_lines ]]; then
					list_lines="${i}d"
				else
					list_lines+=";${i}d"
				fi
			done
			sed -i "${list_lines}" /etc/hosts
		fi
	done
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Warning" "System" "System hostname changed (Host: $domain)."
log_event "$OK" "$ARGUMENTS"

exit
