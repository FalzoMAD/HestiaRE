#!/bin/bash
# info: change IP status
# options: IP IP_STATUS
#
# example: h-change-sys-ip-status 203.0.113.1 yourstatus
#
# This function of changing an IP address's status.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
# ip46 for the format dispatch; global $ip aliased for the sourced ip.sh helpers
ip46="$1"
ip="$ip46"
ip_status="$2"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP IP_STATUS'
is_format_valid 'ip46' 'ip_status'
if [ "$(ip_family "$ip46")" = 6 ]; then
	ip46=$(ip6_canonical "$ip46")
	ip="$ip46"
fi
is_ip_valid "$ip"
if [ "$ip_status" = "$(get_ip_value '$STATUS')" ]; then
	check_result "$E_EXISTS" "status $ip_status is already set"
fi
web_domains=$(get_ip_value '$U_WEB_DOMAINS')
sys_user=$(get_ip_value '$U_SYS_USERS')
ip_owner=$(get_ip_value '$OWNER')
if [ "$web_domains" -ne '0' ] && [ "$sys_user" != "$ip_owner" ]; then
	check_result "$E_INUSE" "IP $ip is used"
fi
if [ "$ip_owner" != "$ROOT_USER" ] && [ "$ip_status" = "shared" ]; then
	$BIN/h-change-sys-ip-owner "$ip" "$ROOT_USER"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Changing IP status
update_ip_value '$STATUS' "$ip_status"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "IP address status changed (Status: $ip_status, IP: $ip)."
log_event "$OK" "$ARGUMENTS"

exit
