#!/bin/bash
# info: update web templates
# options: [RESTART] [SKIP]
#
# example: h-update-web-templates
#
# This function for obtaining updated web (Nginx/Apache2/PHP) templates from the Hestia package.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
restart=$1
skip=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

is_format_valid 'restart'

# Detect whether the awstats template already has the geoip LoadPlugin enabled
awstats_patch=$(cat $SHARETPL/awstats/awstats.tpl | grep "LoadPlugin=\"geoip GEOIP_STANDARD /usr/share/GeoIP/GeoIP.dat\"")

# Web templates ship at $HESTIA/templates (delivered by the tarball). The FPM pool
# profiles (default, ondemand, high) are static files now; the version is a web.conf
# field, not baked into a per-version template. Sweep the pre-#591 artefacts an upgrade
# still carries: the generated PHP-X_Y pool templates and the retired socket / no-php.
for stale in "$PHPTPL"/PHP-[0-9]*_[0-9]*.tpl "$PHPTPL/socket.tpl" "$PHPTPL/no-php.tpl"; do
	[ -e "$stale" ] && rm -f "$stale"
done

if [ -n "$awstats_patch" ]; then
	# restore LoadPlugin variable
	echo "LoadPlugin=\"geoip GEOIP_STANDARD /usr/share/GeoIP/GeoIP.dat\"" >> $SHARETPL/awstats/awstats.tpl
fi

# Rebuilding web domains
if [ -z "$skip" ]; then
	for user in $("$BIN/h-list-users" list); do
		$BIN/h-rebuild-web-domains "$user" "no"
	done
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restarting web server
$BIN/h-restart-web "$restart"
check_result $? "restart" > /dev/null 2>&1

$BIN/h-restart-proxy "$restart"
check_result $? "restart" > /dev/null 2>&1

$BIN/h-log-action "system" "Info" "Updates" "Default web domain templates updated."

exit
