#!/bin/bash
# info: take web domain temporarily offline (customer switch)
# options: USER DOMAIN [RESTART]
#
# example: h-add-web-domain-offline admin acme.com
#
# Serves a static "temporarily offline" page with HTTP 503 in every web model - 503 so
# search engines treat it as transient. Admin suspension outranks this switch.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=${3-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Load domain data
# shellcheck disable=SC2046  # word splitting carries the record into KEY='v' tokens
parse_object_kv_list $(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)

# add_object_key is idempotent on key presence, so no value guard needed
add_object_key "web" 'DOMAIN' "$domain" 'OFFLINE' 'SUSPENDED'
update_object_value 'web' 'DOMAIN' "$domain" '$OFFLINE' 'yes'

# rendering lives in prepare_web_domain_values; the rebuild applies it. Checked, or a
# failed rebuild leaves the flag set, logs $OK, and the domain is neither on nor offline
$BIN/h-rebuild-web-domain "$user" "$domain" 'no'
check_result $? "Web rebuild failed" > /dev/null

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restarting web server
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Website taken offline (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit
