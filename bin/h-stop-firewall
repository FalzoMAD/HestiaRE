#!/bin/bash
# info: stop system firewall
# options: NONE
#
# example: h-stop-firewall
#
# This function stops iptables

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# The backend path lives in func/firewall.sh now.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Self heal iptables links
heal_iptables_links

# Opening the batch
fw_batch_begin

# Flushing INPUT chain
fw_policy INPUT ACCEPT
fw_flush INPUT

# Deleting hestia chain
fw_chain_drop hestia

# Deleting custom chains
IFS=$'\n'
for chain in $(cat $CONF_DIR/firewall/chains.conf 2> /dev/null); do
	parse_object_kv_list "$chain"
	fw_jail_teardown "$CHAIN"
done

# Applying rules
fw_batch_apply
fw_batch_discard

# Saving the flushed ruleset and standing the boot unit down
fw_persist_disable

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
