#!/bin/bash
# info: list users
# options: [FORMAT]
#
# example: h-list-users
#
# This function to obtain the list of all system users.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Argument definition
format=${1-shell}

# JSON list function
json_list() {
	echo '{'
	i=1
	while read -r USER; do
		if [ ! -f "$CONF_DIR/users/$USER/user.conf" ]; then
			continue
		fi
		if [ $i -gt 1 ]; then
			echo ","
		fi
		source_conf "$CONF_DIR/users/$USER/user.conf"
		json_escape USER NAME PACKAGE WEB_TEMPLATE BACKEND_TEMPLATE PROXY_TEMPLATE WEB_DOMAINS WEB_ALIASES MAIL_DOMAINS MAIL_ACCOUNTS DATABASES CRON_JOBS DISK_QUOTA CPU_QUOTA DOCKER_LIMIT CPU_QUOTA_PERIOD MEMORY_LIMIT SWAP_LIMIT BANDWIDTH SHELL BACKUPS CONTACT CRON_REPORTS RKEY ROLE SUSPENDED SUSPENDED_USERS SUSPENDED_WEB SUSPENDED_MAIL SUSPENDED_DB SUSPENDED_CRON IP_AVAIL IP_OWNED U_USERS U_DISK U_DISK_DIRS U_DISK_WEB U_DISK_MAIL U_DISK_DB U_BANDWIDTH U_WEB_DOMAINS U_WEB_SSL U_WEB_ALIASES U_MAIL_DOMAINS U_MAIL_DKIM U_MAIL_ACCOUNTS U_DATABASES U_CRON_JOBS U_BACKUPS LANGUAGE TIME DATE
		printf '    "%s": {\n' "$USER"
		printf '        "NAME": "%s",\n' "$NAME"
		printf '        "PACKAGE": "%s",\n' "$PACKAGE"
		printf '        "WEB_TEMPLATE": "%s",\n' "$WEB_TEMPLATE"
		printf '        "BACKEND_TEMPLATE": "%s",\n' "$BACKEND_TEMPLATE"
		printf '        "PROXY_TEMPLATE": "%s",\n' "$PROXY_TEMPLATE"
		printf '        "WEB_DOMAINS": "%s",\n' "$WEB_DOMAINS"
		printf '        "WEB_ALIASES": "%s",\n' "$WEB_ALIASES"
		printf '        "MAIL_DOMAINS": "%s",\n' "$MAIL_DOMAINS"
		printf '        "MAIL_ACCOUNTS": "%s",\n' "$MAIL_ACCOUNTS"
		printf '        "DATABASES": "%s",\n' "$DATABASES"
		printf '        "CRON_JOBS": "%s",\n' "$CRON_JOBS"
		printf '        "DISK_QUOTA": "%s",\n' "$DISK_QUOTA"
		printf '        "CPU_QUOTA": "%s",\n' "$CPU_QUOTA"
		printf '        "DOCKER_LIMIT": "%s",\n' "$DOCKER_LIMIT"
		printf '        "CPU_QUOTA_PERIOD": "%s",\n' "$CPU_QUOTA_PERIOD"
		printf '        "MEMORY_LIMIT": "%s",\n' "$MEMORY_LIMIT"
		printf '        "SWAP_LIMIT": "%s",\n' "$SWAP_LIMIT"
		printf '        "BANDWIDTH": "%s",\n' "$BANDWIDTH"
		printf '        "SHELL": "%s",\n' "$SHELL"
		printf '        "BACKUPS": "%s",\n' "$BACKUPS"
		printf '        "CONTACT": "%s",\n' "$CONTACT"
		printf '        "CRON_REPORTS": "%s",\n' "$CRON_REPORTS"
		printf '        "RKEY": "%s",\n' "$RKEY"
		printf '        "ROLE": "%s",\n' "$ROLE"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "SUSPENDED_USERS": "%s",\n' "$SUSPENDED_USERS"
		printf '        "SUSPENDED_WEB": "%s",\n' "$SUSPENDED_WEB"
		printf '        "SUSPENDED_MAIL": "%s",\n' "$SUSPENDED_MAIL"
		printf '        "SUSPENDED_DB": "%s",\n' "$SUSPENDED_DB"
		printf '        "SUSPENDED_CRON": "%s",\n' "$SUSPENDED_CRON"
		printf '        "IP_AVAIL": "%s",\n' "$IP_AVAIL"
		printf '        "IP_OWNED": "%s",\n' "$IP_OWNED"
		printf '        "U_USERS": "%s",\n' "$U_USERS"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "U_DISK_DIRS": "%s",\n' "$U_DISK_DIRS"
		printf '        "U_DISK_WEB": "%s",\n' "$U_DISK_WEB"
		printf '        "U_DISK_MAIL": "%s",\n' "$U_DISK_MAIL"
		printf '        "U_DISK_DB": "%s",\n' "$U_DISK_DB"
		printf '        "U_BANDWIDTH": "%s",\n' "$U_BANDWIDTH"
		printf '        "U_WEB_DOMAINS": "%s",\n' "$U_WEB_DOMAINS"
		printf '        "U_WEB_SSL": "%s",\n' "$U_WEB_SSL"
		printf '        "U_WEB_ALIASES": "%s",\n' "$U_WEB_ALIASES"
		printf '        "U_MAIL_DOMAINS": "%s",\n' "$U_MAIL_DOMAINS"
		printf '        "U_MAIL_DKIM": "%s",\n' "$U_MAIL_DKIM"
		printf '        "U_MAIL_ACCOUNTS": "%s",\n' "$U_MAIL_ACCOUNTS"
		printf '        "U_DATABASES": "%s",\n' "$U_DATABASES"
		printf '        "U_CRON_JOBS": "%s",\n' "$U_CRON_JOBS"
		printf '        "U_BACKUPS": "%s",\n' "$U_BACKUPS"
		printf '        "LANGUAGE": "%s",\n' "$LANGUAGE"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '        }'
		((i++))
	done < <(grep '@' /etc/passwd | cut -f1 -d:)
	echo '}'
}

# SHELL list function
shell_list() {
	echo "USER   ROLE   PKG   WEB   MAIL   DB   DISK   BW   SPND   DATE"
	echo "----   ----   ---   ---   ---   ---    --   ----   --   ----   ----"
	while read USER; do
		if [ ! -f "$CONF_DIR/users/$USER/user.conf" ]; then
			continue
		fi
		source_conf "$CONF_DIR/users/$USER/user.conf"
		echo -n "$USER $ROLE $PACKAGE $U_WEB_DOMAINS $U_MAIL_DOMAINS"
		echo " $U_DATABASES $U_DISK $U_BANDWIDTH $SUSPENDED $DATE"
	done < <(grep '@' /etc/passwd | cut -f1 -d:)
}

# PLAIN list function
plain_list() {
	while read USER; do
		if [ ! -f "$CONF_DIR/users/$USER/user.conf" ]; then
			continue
		fi
		source_conf "$CONF_DIR/users/$USER/user.conf"
		echo -ne "$USER\t$NAME\t$PACKAGE\t$WEB_TEMPLATE\t"
		echo -ne "$BACKEND_TEMPLATE\t$PROXY_TEMPLATE\t"
		echo -ne "$WEB_DOMAINS\t$WEB_ALIASES\t"
		echo -ne "$MAIL_DOMAINS\t$MAIL_ACCOUNTS\t$DATABASES\t$CRON_JOBS\t"
		echo -ne "$DISK_QUOTA\t$CPU_QUOTA\t$CPU_QUOTA_PERIOD\t$MEMORY_LIMIT\t"
		echo -ne "$SWAP_LIMIT\t$BANDWIDTH\t$SHELL\t$BACKUPS\t"
		echo -ne "$CONTACT\t$CRON_REPORTS\t$RKEY\t$ROLE\t$SUSPENDED\t"
		echo -ne "$SUSPENDED_USERS\t$SUSPENDED_WEB\t"
		echo -ne "$SUSPENDED_MAIL\t$SUSPENDED_DB\t$SUSPENDED_CRON\t"
		echo -ne "$IP_AVAIL\t$IP_OWNED\t$U_USERS\t$U_DISK\t$U_DISK_DIRS\t"
		echo -ne "$U_DISK_WEB\t$U_DISK_MAIL\t$U_DISK_DB\t$U_BANDWIDTH\t"
		echo -ne "$U_WEB_DOMAINS\t$U_WEB_SSL\t$U_WEB_ALIASES\t"
		echo -ne "$U_MAIL_DOMAINS\t"
		echo -ne "$U_MAIL_DKIM\t$U_MAIL_ACCOUNTS\t$U_DATABASES\t"
		echo -e "$U_CRON_JOBS\t$U_BACKUPS\t$LANGUAGE\t$TIME\t$DATE\t"
	done < <(grep '@' /etc/passwd | cut -f1 -d:)
}

# CSV list function
csv_list() {
	echo -n "USER,NAME,PACKAGE,WEB_TEMPLATE,BACKEND_TEMPLATE,"
	echo -n "PROXY_TEMPLATE,WEB_DOMAINS,WEB_ALIASES,"
	echo -n "MAIL_DOMAINS,MAIL_ACCOUNTS,"
	echo -n "DATABASES,CRON_JOBS,DISK_QUOTA,CPU_QUOTA,CPU_QUOTA_PERIOD,"
	echo -n "MEMORY_LIMIT,SWAP_LIMIT,BANDWIDTH,HOME,SHELL,"
	echo -n "BACKUPS,CONTACT,CRON_REPORTS,RKEY,ROLE,SUSPENDED,SUSPENDED_USERS,"
	echo -n "SUSPENDED_WEB,SUSPENDED_MAIL,SUSPENDED_DB,"
	echo -n "SUSPENDED_CRON,IP_AVAIL,IP_OWNED,U_USERS,U_DISK,U_DISK_DIRS,"
	echo -n "U_DISK_WEB,U_DISK_MAIL,U_DISK_DB,U_BANDWIDTH,U_WEB_DOMAINS,"
	echo -n "U_WEB_SSL,U_WEB_ALIASES,"
	echo -n "U_MAIL_DOMAINS,U_MAIL_DKIM,U_MAIL_ACCOUNTS,U_DATABASES"
	echo "U_CRON_JOBS,U_BACKUPS,LANGUAGE,TIME,DATE"
	while read USER; do
		if [ ! -f "$CONF_DIR/users/$USER/user.conf" ]; then
			continue
		fi
		source_conf "$CONF_DIR/users/$USER/user.conf"
		echo -n "$USER,\"$NAME\",$PACKAGE,$WEB_TEMPLATE,"
		echo -n "$BACKEND_TEMPLATE,$PROXY_TEMPLATE,"
		echo -n "$WEB_DOMAINS,$WEB_ALIASES,"
		echo -n "$MAIL_DOMAINS,$MAIL_ACCOUNTS,$DATABASES,$CRON_JOBS,"
		echo -n "$DISK_QUOTA,$CPU_QUOTA,$CPU_QUOTA_PERIOD,$MEMORY_LIMIT,"
		echo -n "$SWAP_LIMIT,$BANDWIDTH,$HOME,$SHELL,$BACKUPS,"
		echo -n "$CONTACT,$CRON_REPORTS,\"$RKEY\",$ROLE,$SUSPENDED,"
		echo -n "$SUSPENDED_USERS,$SUSPENDED_WEB,"
		echo -n "$SUSPENDED_MAIL,$SUSPENDED_DB,$SUSPENDED_CRON,$IP_AVAIL,"
		echo -n "$IP_OWNED,$U_USERS,$U_DISK,$U_DISK_DIRS,$U_DISK_WEB,"
		echo -n "$U_DISK_MAIL,$U_DISK_DB,$U_BANDWIDTH,$U_WEB_DOMAINS,"
		echo -n "$U_WEB_SSL,$U_WEB_ALIASES,"
		echo -n "$U_MAIL_DOMAINS,$U_MAIL_DKIM,$U_MAIL_ACCOUNTS,$U_DATABASES,"
		echo "$U_CRON_JOBS,$U_BACKUPS,$LANGUAGE,$TIME,$DATE"
	done < <(grep '@' /etc/passwd | cut -f1 -d:)
}

# USER ONLY list function
only_user_list() {
	while read USER; do
		if [ ! -f "$CONF_DIR/users/$USER/user.conf" ]; then
			continue
		fi
		source_conf "$CONF_DIR/users/$USER/user.conf"
		echo "$USER"
	done < <(grep '@' /etc/passwd | cut -f1 -d:)
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
	list) only_user_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
