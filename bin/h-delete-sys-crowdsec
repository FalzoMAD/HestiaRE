#!/bin/bash
# info: remove the CrowdSec security addon
# options: [FORCE]
#
# example: h-delete-sys-crowdsec
#
# Unwires and uninstalls CrowdSec: the L3 firewall-bouncer (chain/set/jump), the L7 nginx
# bouncer + http glue, then purges the engine packages. /etc/crowdsec is kept as saved state
# so a re-add reuses LAPI creds, collections and CAPI enrolment (PURGE_DATA=yes wipes it).
# This is the first step of the two-step delete-nginx teardown the Phase-1 guard points at:
# remove CrowdSec here, then h-delete-sys-nginx. Per-domain fragments stay (inert saved state).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

FORCE=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# live component state
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

# purge would drop /etc/crowdsec; keep it as saved state. Trap-restore so an aborted purge
# can't strand it under .saved (invisible to a later re-add); mirrors h-delete-sys-clamav.
restore_cs_state() {
	if [ -d /etc/crowdsec.saved ]; then
		rm -rf /etc/crowdsec
		mv /etc/crowdsec.saved /etc/crowdsec
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

check_hestia_demo_mode

# guard on the package, not COMPONENT_* - a timed-out install may have ADDON_CROWDSEC=true
# but a half-wired engine; the package is the honest signal.
if ! dpkg -l crowdsec 2> /dev/null | grep -q '^ii' && [ "$FORCE" != 'yes' ]; then
	echo "ERROR: CrowdSec is not installed. Use FORCE=yes to clean up anyway."
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

source "$HESTIA/func/crowdsec.sh"

# L3 first: stop the firewall-bouncer, drop the marker + hestia-crowdsec chain/jump + set,
# rebuild the firewall (h-update-firewall then skips the L3 block - marker gone).
crowdsec_l3_teardown

# L7: remove the nginx bouncer + http glue (the reload happens inside).
crowdsec_remove_nginx

# purge the engine + bouncers (no autoremove: it would rip out shared-stack siblings)
if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /etc/crowdsec.saved
elif [ -d /etc/crowdsec ]; then
	trap restore_cs_state EXIT
	rm -rf /etc/crowdsec.saved
	mv /etc/crowdsec /etc/crowdsec.saved
fi

apt-get -y -qq purge crowdsec crowdsec-firewall-bouncer > /dev/null 2>&1

restore_cs_state
trap - EXIT
if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /etc/crowdsec
	echo "[ * ] PURGE_DATA=yes - /etc/crowdsec removed."
fi

set_install_component ADDON_CROWDSEC false

# per-domain fragments (nginx.crowdsec.conf / crowdsec.apache2.conf) stay as saved state -
# inert without the http-block zones, restored by a re-add.

echo "CrowdSec has been removed. You can now run h-delete-sys-nginx if the model requires it."

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Removed CrowdSec addon."
log_event "$OK" "$ARGUMENTS"

exit
