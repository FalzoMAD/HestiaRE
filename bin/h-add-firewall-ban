#!/bin/bash
# info: add firewall blocking rule
# options: IP_CIDR CHAIN
#
# example: h-add-firewall-ban 37.120.129.20 MAIL
#
# This function adds new blocking rule to system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_cidr=$1
chain=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# Defining absolute path for iptables and modprobe

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP_CIDR CHAIN'
is_format_valid 'ip_cidr' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking server ip
# Loopback in either family, and any of the box's own addresses: banning one of those is a self-inflicted
# outage, and it is the shape a misconfigured proxy produces (the app sees 127.0.0.1, not the client).
if [ -e "$CONF_DIR/ips/$ip_cidr" ] || [ "$ip_cidr" = '127.0.0.1' ] || [ "$ip_cidr" = '::1' ]; then
	exit
fi

# Checking ip exclusions
excludes="$CONF_DIR/firewall/excludes.conf"
check_excludes=$(grep "^$ip_cidr$" $excludes 2> /dev/null)
if [ -n "$check_excludes" ]; then
	exit
fi

# Checking ip in banlist
conf="$CONF_DIR/firewall/banlist.conf"
check_ip=$(grep "IP='$ip_cidr' CHAIN='$chain'" $conf 2> /dev/null)
if [ -n "$check_ip" ]; then
	exit
fi

# Adding chain
$BIN/h-add-firewall-chain $chain

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Adding ip to banlist
echo "IP='$ip_cidr' CHAIN='$chain' TIME='$time' DATE='$date'" >> $conf
fw_ban_add "$chain" "$ip_cidr"

# Changing permissions
chmod 660 $conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Warning" "Firewall" "Banned IP address $ip_cidr."
log_event "$OK" "$ARGUMENTS"

exit
