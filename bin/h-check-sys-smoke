#!/bin/bash
# info: post-install smoke test (services, ports, logs)
# options: NONE
#
# example: h-check-sys-smoke
#
# Verifies that a fresh install came up: the services implied by the active
# configuration are running, the expected ports listen, the panel answers, and no
# critical markers are in the key logs. Preset-independent — it derives what to
# expect from hestia.conf's *_SYSTEM vars and install.conf's COMPONENT_* flags.
# Prints PASS/FAIL per check; exits 0 if all pass, 1 otherwise. No v-* symlink.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source $HESTIA/include/fail2ban.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# live component state (COMPONENT_* flags), if present
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

pass=0
fail=0

ok() {
	echo "[ PASS ] $1"
	pass=$((pass + 1))
}
no() {
	echo "[ FAIL ] $1${2:+ — $2}"
	fail=$((fail + 1))
}
skip() { echo "[ skip ] $1"; }

# check_source_absent <label> <pattern> <path...> — a vulnerable pattern must not
# reappear (static regression guard for a security fix). Comment lines excluded.
# Whether sudo keeps panel command lines out of the logs depends on the sudo flavor and the
# distro, so assert the outcome per run: a throwaway marker through an allowed panel call must
# not survive in any persistent log. The sink set is derived from a control marker written to
# authpriv - no file receives it (journald-only) means nothing to assert, not nothing found.
# Covers log FILES only; the journald copy is out of scope here.
check_sudo_secret_leak() {
	local probe control f sinks='' leaked=''
	id hestia > /dev/null 2>&1 || {
		skip "sudo argv leak (panel user absent)"
		return
	}
	command -v logger > /dev/null 2>&1 || {
		skip "sudo argv leak (no logger to probe with)"
		return
	}
	probe="HstProbeArgv$(openssl rand -hex 6)"
	control="HstProbeSink$(openssl rand -hex 6)"

	logger -p authpriv.notice "$control"
	runuser -u hestia -- sudo -n "$BIN/h-list-users" list "$probe" > /dev/null 2>&1
	sleep 1

	for f in /var/log/auth.log /var/log/secure /var/log/syslog /var/log/messages; do
		[ -f "$f" ] || continue
		grep -qF "$control" "$f" 2> /dev/null && sinks="$sinks $f"
	done
	if [ -z "$sinks" ]; then
		skip "sudo argv leak (no persistent authpriv file on this box)"
		return
	fi
	for f in $sinks; do
		grep -qF "$probe" "$f" 2> /dev/null && leaked="$leaked $f"
	done
	if [ -n "$leaked" ]; then
		no "panel command lines persist in the system log:$leaked" \
			"neither !log_allowed nor the rsyslog drop rule is effective - panel-set secrets land there in cleartext"
		return
	fi
	ok "no panel command line kept in the persistent logs ($(echo $sinks | wc -w) sink(s) checked)"
}

check_source_absent() {
	local label="$1" pat="$2"
	shift 2
	local hit
	hit=$(grep -rnE "$pat" "$@" 2> /dev/null | grep -vE ':[[:space:]]*(//|#|\*)')
	if [ -z "$hit" ]; then
		ok "invariant: $label"
	else
		no "invariant: $label" "$(echo "$hit" | head -n1)"
	fi
}

# check_session_user_allowlist <webdir> — $_SESSION["user"] is the REAL logged-in
# user; during impersonation it is the ADMIN, not the customer (who is in "look").
# Scoping customer data by it mis-targets (#438). Rather than chase every spelling
# of the bug, allowlist the files that may touch the real user at all (auth /
# dispatch / reset / real-identity display); ANY other file is red — it must use the
# look-aware $user/$user_plain from inc/main.php. Turns "did we catch every spelling"
# into "may this file see the real user".
check_session_user_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="inc/main.php login/index.php logout/index.php index.php list/index.php \
fm-auth.php rspamd-auth.php reset/index.php reset2fa/index.php edit/user/index.php \
list/log/index.php templates/includes/panel.php templates/pages/edit_server.php \
templates/pages/edit_user.php templates/pages/list_key.php templates/pages/list_log.php \
templates/pages/list_search.php templates/pages/list_user.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE '\$_SESSION\["user"\]' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: \$_SESSION[user] only in allowlisted files (#438)"
	else
		no "invariant: \$_SESSION[user] in non-allowlisted file (#438 mis-target risk)" "${bad# }"
	fi
}

# check_xaccel_allowlist <webdir> — only list/rrd/image.php may EMIT X-Accel-Redirect. Caddy serves it
# via file_server as `caddy`, which reads only the web-root files it owns (the RRD images); a download
# handler emitting it for a customer file hits the caddy-can't-read wall (#441) — stream via
# inc/download.php as `hestia` instead. Matches header(...) emission, not the handlers' prose.
check_xaccel_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="list/rrd/image.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE 'header\(["'"'"']X-Accel-Redirect' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: X-Accel-Redirect only emitted by allowlisted files (#441/#443)"
	else
		no "invariant: X-Accel-Redirect emitted by non-allowlisted file (caddy-can't-read wall)" "${bad# }"
	fi
}

# check_service <systemd-unit> <label>
check_service() {
	if systemctl is-active --quiet "$1"; then
		ok "service $2 ($1) active"
	else
		no "service $2 ($1) not active" "$(systemctl is-active "$1" 2> /dev/null)"
	fi
}

# check_port <port> <label>
check_port() {
	if ss -H -tln 2> /dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"; then
		ok "port $1 ($2) listening"
	else
		no "port $1 ($2) not listening"
	fi
}

# check_socket <path> <label> — listening unix socket
check_socket() {
	if ss -H -xln 2> /dev/null | grep -qF "$1"; then
		ok "socket $2 ($1) listening"
	else
		no "socket $2 ($1) not listening"
	fi
}

# check_firewall_backend - without /usr/sbin/nft, FIREWALL_SYSTEM is a claim the box cannot honour, and the
# policy check below only SKIPs, so a missing backend would pass for a permissions quirk.
check_firewall_backend() {
	if [ -x "$FW_NFT" ]; then
		ok "firewall backend present ($FW_NFT)"
	else
		no "firewall backend missing" "$FW_NFT not executable - FIREWALL_SYSTEM is set but nothing can apply a ruleset"
	fi
}

# With the firewall enabled INPUT must default to DROP; nothing else notices a box that came up with policy
# ACCEPT and no rules at all.
check_firewall_closed() {
	local pol
	pol=$(fw_policy_get INPUT)
	if [ -z "$pol" ]; then
		skip "firewall INPUT policy (backend not readable - root?)"
	elif [ "$pol" = 'DROP' ]; then
		ok "firewall INPUT policy closed (DROP)"
	else
		no "firewall INPUT policy is not DROP" "$pol"
	fi
}

# check_firewall_icmpv6 - without an explicit accept, NDP/PMTUD die under the drop policy and IPv6 breaks
# entirely (neigh INCOMPLETE, ping6 100% loss). Invisible on the v4-only fleet, hence the guard.
check_firewall_icmpv6() {
	local rules
	rules=$(nft list chain inet hestia input 2> /dev/null) || {
		skip "firewall ICMPv6 accept (inet hestia not readable)"
		return
	}
	if echo "$rules" | grep -q 'ipv6-icmp'; then
		ok "firewall accepts ICMPv6 (NDP/PMTUD - IPv6 stays functional)"
	else
		no "firewall drops ICMPv6" "no icmpv6 accept in inet hestia input - IPv6 NDP breaks under the drop policy"
	fi
}

# check_firewall_ruleset_loadable - that file IS what the boot unit reloads, so if it stops parsing the box
# boots with no ruleset at all. Sets and their rules load in one transaction now, so only this can go wrong.
check_firewall_ruleset_loadable() {
	local ruleset=/etc/hestia/firewall/ruleset.nft
	if [ ! -f "$ruleset" ]; then
		no "firewall ruleset not persisted" "$ruleset missing - a reboot would come up unfiltered"
		return
	fi
	if nft -c -f "$ruleset" > /dev/null 2>&1; then
		ok "persisted firewall ruleset loads"
	else
		no "persisted firewall ruleset is rejected by nft" "$(nft -c -f "$ruleset" 2>&1 | head -n1)"
	fi
}

# check_firewall_chains_tracked - the live ruleset must not carry a jail chain the object model forgot.
# Reproduced under iptables, where a leaked jump kept a chain referenced until its record was already gone;
# kept now the cause is fixed, because an untracked chain is a rule nobody audits.
check_firewall_chains_tracked() {
	local orphan='' c
	for c in $(fw_jail_chains_live); do
		grep -q "CHAIN='$c'" "$CONF_DIR/firewall/chains.conf" 2> /dev/null || orphan="$orphan $c"
	done
	if [ -n "$orphan" ]; then
		no "live firewall jail chain with no chains.conf record" "${orphan# }"
	else
		ok "firewall jail chains all tracked in the object model"
	fi
}

# check_firewall_rules_rendered - the other direction: fw_rule skips a source that is neither any, an ipset
# nor a valid address, so a corrupted entry drops out of the firewall with nothing going red.
check_firewall_rules_rendered() {
	local rules="$CONF_DIR/firewall/rules.conf" bad='' line
	[ -f "$rules" ] || {
		ok "firewall rules all renderable (none)"
		return
	}
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		parse_object_kv_list "$line"
		[ "${SUSPENDED:-no}" = 'yes' ] && continue
		case "$IP" in
			0.0.0.0/0 | ::/0 | '' | ipset:*) continue ;;
		esac
		fw_is_addr "$IP" || fw_is_addr6 "$IP" || bad="$bad RULE=$RULE($IP)"
	done < "$rules"
	if [ -z "$bad" ]; then
		ok "firewall rules all render (valid source per entry)"
	else
		no "firewall rule with an unrenderable source (silently skipped)" "${bad# }"
	fi
}

# check_firewall_ipsets_populated - the guard above accepts any ipset: source, but never checks the list
# behind it. No cache file renders an EMPTY set: rule present, panel shows the list, nothing matches.
check_firewall_ipsets_populated() {
	local rules="$CONF_DIR/firewall/rules.conf" bad='' line name src
	[ -f "$rules" ] || {
		ok "firewall IP lists all populated (no rules)"
		return
	}
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		parse_object_kv_list "$line"
		[ "${SUSPENDED:-no}" = 'yes' ] && continue
		case "$IP" in ipset:*) ;; *) continue ;; esac
		name="${IP#ipset:}"
		src="$(fw_set_src "$name")"
		[ -s "$src" ] || bad="$bad $name(${src##*/})"
	done < "$rules"
	if [ -z "$bad" ]; then
		ok "firewall IP lists referenced by a rule are populated"
	else
		no "firewall rule matches an empty IP list (blocks nothing)" "${bad# }"
	fi
}

# check_fail2ban_jails - running must equal configured, in both directions: one of ours missing (how the
# whole set stayed dead while the service looked healthy) and a distro jail we never asked for.
check_fail2ban_jails() {
	local want have missing='' extra='' j
	want=$(fail2ban_enabled_jails | sort)
	have=$(fail2ban-client status 2> /dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' '\n' | sort)
	for j in $want; do grep -qx "$j" <<< "$have" || missing="$missing $j"; done
	for j in $have; do grep -qx "$j" <<< "$want" || extra="$extra $j"; done
	if [ -n "$missing" ]; then
		no "fail2ban jail enabled in config but not running" "${missing# }"
	elif [ -n "$extra" ]; then
		no "fail2ban is running a jail we did not enable" "${extra# } (a distro jail bans into a ruleset we do not manage)"
	else
		ok "fail2ban jails match the configured set"
	fi
}

# check_fail2ban_config - a config error leaves the service up and the jail gone, so the exit status is not
# enough: fail2ban prints these on stderr while the dump itself still succeeds.
check_fail2ban_config() {
	local errs
	errs=$(fail2ban-client -d 2>&1 > /dev/null | grep ERROR | head -n1)
	if [ -z "$errs" ]; then
		ok "fail2ban config parses without error"
	else
		no "fail2ban config error" "${errs#*ERROR   }"
	fi
}

# check_fail2ban_banaction - one assertion covering the distro leftover, a future package default and a
# renderer swap that leaves the action behind.
check_fail2ban_banaction() {
	local foreign
	# `action = hestia[name=SSH]` is instantiated as the action `hestia-SSH`, so match the prefix. Testing
	# for a bare `hestia` looks right and never matches anything.
	foreign=$(fail2ban-client -d 2> /dev/null \
		| grep -oE "'addaction', '[^']+'" | sed "s/.*'\(.*\)'/\1/" | sort -u | grep -v '^hestia-')
	if [ -z "$foreign" ]; then
		ok "fail2ban bans through the hestia action only"
	else
		no "fail2ban jail using a foreign banaction" "$(echo "$foreign" | tr '\n' ' ')"
	fi
}

# A jail watching a missing file never fires and says so only in fail2ban's own log - how the mail jails
# stayed enabled on boxes without mail.
check_fail2ban_logpaths() {
	local missing='' p
	while read -r p; do
		[ -n "$p" ] || continue
		case "$p" in /*) [ -e "$p" ] || missing="$missing $p" ;; esac
	done <<< "$(fail2ban-client -d 2> /dev/null | grep -oE "'addlogpath', '[^']+'" | sed "s/.*'\(.*\)'/\1/" | sort -u)"
	if [ -z "$missing" ]; then
		ok "fail2ban jail logpaths all exist"
	else
		no "fail2ban jail watching a missing logpath" "${missing# }"
	fi
}

# A jail on the systemd backend keeps its logpath, starts cleanly and reports healthy while monitoring
# nothing - so neither "the file exists" nor "the jail runs" catches it. Asking what it monitors does.
check_fail2ban_backends() {
	local blind='' j pat
	for j in $(fail2ban_enabled_jails); do
		fail2ban-client status "$j" > /dev/null 2>&1 || continue
		fail2ban-client get "$j" logpath 2> /dev/null | grep -q '^ *`\?- */' && continue
		# A glob matching nothing yet is not a defect - a box with no web domains has nothing to watch. The
		# defect this guard is for is a jail whose files exist and that monitors them anyway.
		pat="$(fail2ban_jail_logpath "$j")"
		[ -n "$pat" ] && ! compgen -G "$pat" > /dev/null 2>&1 && continue
		blind="$blind $j"
	done
	if [ -z "$blind" ]; then
		ok "fail2ban jails are watching their log files"
	else
		no "fail2ban jail monitors no file (wrong backend?)" "${blind# }"
	fi
}

# WEBMAIL_SYSTEM used to be written before the install ran, so a failed download left the config claiming a
# webmail that was never unpacked (#573). The listener check catches that too, but only as an ambiguous 404
# - this names the cause.
check_webmail_payload() {
	local wm="$1" f="$2"
	[ -s "$f" ] && {
		ok "$wm payload installed"
		return
	}
	no "$wm claimed by WEBMAIL_SYSTEM but not installed" "missing $f"
}

# The SQLite exception (#584): a webmailer installed while MariaDB was deselected records the
# sqlite backend in its own config. WHERE that artefact says sqlite, the PHP driver must be in
# the panel pool - confd lists it as optional (an updated one-minor-back box lacks the package),
# so this is the guard that turns a missing driver into a hard failure exactly where it breaks.
check_webmail_sqlite_driver() {
	local wm="$1"
	if ls /etc/php/hestia/fpm/conf.d/*-sqlite3.ini > /dev/null 2>&1 \
		&& ls /etc/php/hestia/fpm/conf.d/*-pdo_sqlite.ini > /dev/null 2>&1; then
		ok "$wm sqlite backend has its PHP driver"
		return
	fi
	no "$wm records the sqlite backend but the panel pool lacks sqlite3/pdo_sqlite" \
		"install php-sqlite3 for the pinned panel version, then re-run hestia-php-confd"
}

# The write-path value domain (WEBMAIL_KNOWN_CLIENTS, include/main.sh) is a hand-kept list;
# this derives the shipped-client set from the webmail templates and asserts coverage - a
# client added by template alone would have its records normalized to 'disabled' while
# everything else works. Infrastructure template names are not clients; an empty derived
# set fails rather than passes.
check_webmail_value_domain() {
	local t c found=0 missing=''
	for t in "$HESTIA"/share/*/webmail/*.tpl; do
		c=$(basename "$t" .tpl)
		case "$c" in default | web_system | disabled | default_*) continue ;; esac
		found=$((found + 1))
		grep -qwF -- "$c" <<< "$WEBMAIL_KNOWN_CLIENTS" || missing="$missing $c"
	done
	if [ "$found" -eq 0 ]; then
		no "webmail value-domain guard found no client templates" "share/*/webmail/ empty or moved"
		return
	fi
	[ -z "$missing" ] && {
		ok "webmail value domain covers the shipped client templates"
		return
	}
	no "webmail templates outside the value domain:$missing" "extend WEBMAIL_KNOWN_CLIENTS in include/main.sh"
}

# A web jail must watch the CURRENT web system's dir. After a switch that forgets to re-gate, its logpath
# points at the old stack - a REAL path, so the "what does a jail watch" guard cannot see it, and the next
# restart from any cause leaves it watching a stack with no traffic. Compared against the WEB_SYSTEM dir.
check_fail2ban_web_logpath() {
	local want jail lp bad=''
	want="$(fail2ban_web_logdir 2> /dev/null)" || {
		skip "web jail logpath (no web system)"
		return
	}
	for jail in $F2B_WEB_JAILS; do
		fail2ban_jail_enabled "$jail" || continue
		lp="$(fail2ban_jail_logpath "$jail")"
		[ -n "$lp" ] || continue
		case "$lp" in "$want"/*) ;; *) bad="$bad $jail" ;; esac
	done
	if [ -z "$bad" ]; then
		ok "fail2ban web jails watch the current web system ($want)"
	else
		no "fail2ban web jail logpath stale vs WEB_SYSTEM" "${bad# } not under $want - a web-model switch did not re-gate; a fail2ban restart would go blind"
	fi
}

# CrowdSec owns Layer-7 and fail2ban owns brute force, so each side's jobs are off while the other is there.
# A transition that re-gates only one direction reintroduces the double-ban.
check_firewall_layer_separation() {
	local bad='' j s
	if [ -f "$CONF_DIR/firewall/crowdsec.conf" ]; then
		for j in $F2B_WEB_JAILS; do
			fail2ban_jail_enabled "$j" 2> /dev/null && bad="$bad webjail:$j"
		done
	fi
	if [ "$FIREWALL_EXTENSION" = 'fail2ban' ] && command -v cscli > /dev/null 2>&1; then
		for s in ssh-bf ssh-slow-bf; do
			[ -e "/etc/crowdsec/scenarios/$s.yaml" ] && bad="$bad crowdsec-bf:$s"
		done
	fi
	if [ -z "$bad" ]; then
		ok "fail2ban and crowdsec layers do not overlap (#542)"
	else
		no "fail2ban/crowdsec layer overlap" "${bad# } - a model transition did not re-gate the counterpart"
	fi
}

# check_http <url> <label>
check_http() {
	local code
	code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2> /dev/null)
	if [ "$code" = "200" ]; then
		ok "$2 (HTTP $code)"
	else
		no "$2 (HTTP ${code:-000})"
	fi
}

# check_rspamd_ctrl_isolation — the controller socket must be reachable by the
# Caddy proxy process but NOT by the app FPM pools that share the caddy user.
# Checked against live process creds + /etc/group, so a config regression fails here.
check_rspamd_ctrl_isolation() {
	local gid pid pgroups
	gid=$(getent group _rspamd-ctrl | cut -d: -f3)
	if [ -z "$gid" ]; then
		no "rspamd controller group _rspamd-ctrl missing"
		return
	fi
	# 1. socket carries the dedicated group (not plain _rspamd)
	if [ "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)" = '_rspamd-ctrl' ]; then
		ok "controller socket group is _rspamd-ctrl"
	else
		no "controller socket not group _rspamd-ctrl" "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)"
	fi
	# 2. caddy user NOT in the controller group (else app pools inherit via initgroups)
	if id -nG caddy 2> /dev/null | tr ' ' '\n' | grep -qxE '_rspamd(-ctrl)?'; then
		no "caddy user is in an rspamd group (app pools would inherit socket access)" "$(id -nG caddy)"
	else
		ok "caddy user not in any rspamd group (app pools isolated)"
	fi
	# 3. caddy proxy process DOES hold the group (else controller UI breaks)
	pid=$(systemctl show -p MainPID --value caddy.service 2> /dev/null)
	pgroups=$(grep -E '^Groups:' /proc/"${pid:-0}"/status 2> /dev/null)
	if echo "$pgroups" | tr ' \t' '\n' | grep -qx "$gid"; then
		ok "caddy proxy process holds _rspamd-ctrl (controller reachable)"
	else
		no "caddy proxy process lacks _rspamd-ctrl (controller UI would break)" "$pgroups"
	fi
}

# check_log_clean <file> <extended-regex> <label>
check_log_clean() {
	if [ ! -f "$1" ]; then
		skip "log $2 absent ($1)"
		return
	fi
	local hits
	hits=$(grep -aEc "$2" "$1" 2> /dev/null || true)
	if [ "${hits:-0}" -eq 0 ]; then
		ok "log $3 clean"
	else
		no "log $3 has $hits critical entr$([ "$hits" -eq 1 ] && echo y || echo ies)" "$1"
	fi
}

# check_file_empty <file> <label>  (fail if file exists and is non-empty)
check_file_empty() {
	if [ -s "$1" ]; then
		no "$2 non-empty" "$1"
	else
		ok "$2 empty/absent"
	fi
}

# check_banner <port> <label> — service answers with a protocol banner in 5s.
# Catches "active + listening but dead" (e.g. dovecot IMAP login hangs) that
# check_service/check_port miss.
check_banner() {
	local banner
	# head -n1, NOT head -c N: a byte-count read blocks until N bytes arrive
	banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1 && head -n1 <&3" 2> /dev/null)
	if [ -n "$banner" ]; then
		ok "port $1 ($2) answers with a banner"
	else
		no "port $1 ($2) gave no banner within 5s (service up but not functional?)"
	fi
}

# check_v_symlinks_resolve — no v-* compat alias may dangle (catches a rename/
# removal the install-time prune should have cleared). Extra aliases are fine.
check_v_symlinks_resolve() {
	local dangling first
	dangling=$(find "$HESTIA/bin" -maxdepth 1 -name 'v-*' -xtype l 2> /dev/null)
	if [ -z "$dangling" ]; then
		ok "no dangling v-* symlinks"
	else
		no "dangling v-* symlink(s)" "$(echo "$dangling" | head -n1 | xargs basename)"
	fi
}

# check_panel_locale - the FPM pools pin env[LANG] so a child does not inherit whatever the admin's
# base install happens to have. Pinning a locale that is not generated is the same failure with more
# confidence: every child that touches locale warns, and awstats' perl warnings land in the panel log
# (that is how this was found). The expected value is READ FROM the deployed pool, not written here,
# so changing the pin cannot leave the check testing yesterday's value.
# NOT covered: locales a customer's own PHP or a cron job sets for itself.
check_panel_locale() {
	local pool=/etc/php/hestia/fpm/pool.d/panel.conf want
	if [ ! -f "$pool" ]; then
		no "panel FPM locale" "$pool missing - nothing pins env[LANG]"
		return
	fi
	want=$(sed -n 's/^env\[LANG\][[:space:]]*=[[:space:]]*//p' "$pool" | tail -n1)
	if [ -z "$want" ]; then
		no "panel FPM locale" "no env[LANG] in $pool - the child inherits whatever is around"
		return
	fi
	if locale -a 2> /dev/null | grep -qiFx "$(echo "$want" | tr -d '-' | tr '[:upper:]' '[:lower:]')"; then
		ok "panel FPM locale $want is generated"
	else
		no "panel FPM locale $want is NOT generated" "children warn on every locale-aware call"
	fi
}

# check_sbin_not_under_bin - nothing may invoke an sbin command through a bin/ path. The sbin split
# (#209) moved the panel-PHP wrappers and the lifecycle commands out of the sudo wildcard's reach;
# callers referencing them as "$BIN/x" kept resolving to a file that is no longer there, and the
# breakage only shows when that code path runs (a fresh install died on $BIN/hestia-php-confd).
# The set is derived from what actually IS in sbin/, so a later move needs no edit here, and an
# empty sbin/ fails rather than silently agreeing with nothing.
# NOT covered: bare "bin/x" in prose/comments (deliberate - only invocation forms are checked), and
# any path assembled at runtime from a variable this cannot see.
check_sbin_not_under_bin() {
	local names hit
	names=$(find "$HESTIA/sbin" -maxdepth 1 -type f -printf '%f\n' 2> /dev/null | grep -v '\.json$' | paste -sd'|')
	if [ -z "$names" ]; then
		no "sbin commands never invoked via bin/" "sbin/ is empty or unreadable"
		return
	fi
	hit=$(grep -rnE "(\\\$BIN|\\\$HESTIA/bin|/usr/local/hestia/bin)/($names)([\"'[:space:]]|\$)" \
		"$HESTIA/bin" "$HESTIA/sbin" "$HESTIA/func" "$HESTIA/web" "$HESTIA/share" 2> /dev/null \
		| grep -vE ':[[:space:]]*(//|#|\*|;)')
	if [ -z "$hit" ]; then
		ok "sbin commands never invoked via bin/"
	else
		no "sbin commands never invoked via bin/" "$(echo "$hit" | head -n1)"
	fi
}

# check_policy_fragment_coverage — a per-domain POLICY fragment (CrowdSec Layer A, bot rate limiting)
# must be in EVERY customer-domain template of its web system: it applies to all traffic, so a template
# missing one is a silent bypass (switch to the wordpress template, escape the throttle, nothing fails).
# Feature fragments (ssl/hsts/forcessl/fastcgi_cache) are NOT checked - they belong only to the
# templates implementing them. Scope = templates carrying %domain%, so the per-IP catch-all is skipped.
check_policy_fragment_coverage() {
	local f frag miss=0 first="" checked=0
	# By file, not by service directory: a vhost template can live anywhere under the two
	# roots (share/web/suspend/ does), and scanning fixed subdirs would quietly skip it.
	# The pool templates under templates/php carry %domain% but are not vhosts.
	while read -r f; do
		[ -n "$f" ] || continue
		# Decided by content: a vhost declares either a VirtualHost or a server block.
		# Keying on the path would break the moment a directory is renamed - which is
		# exactly what just happened - and silently shrink the guard.
		if grep -q '^[[:space:]]*<VirtualHost' "$f"; then
			set -- botlimit.apache2.conf
		elif grep -qE '^[[:space:]]*server[[:space:]]*\{' "$f"; then
			set -- nginx.crowdsec.conf nginx.botlimit.conf
		else
			continue
		fi
		checked=$((checked + 1))
		for frag in "$@"; do
			grep -q "$frag" "$f" && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="${f#"$HESTIA/"} lacks $frag"
		done
	done < <(grep -rl '%domain%' "$WEBTPL" "$SHARETPL" 2> /dev/null | grep -E '\.(tpl|stpl)$')
	if [ "$miss" -eq 0 ]; then
		ok "policy fragment includes complete ($checked domain templates)"
	else
		no "$miss policy fragment include(s) missing from web templates" "$first"
	fi
}

# check_sudoers <file> <label> — file parses under the running sudo. One rejected
# setting (e.g. requiretty under sudo-rs, ub26) makes sudo drop the WHOLE file.
check_sudoers() {
	if [ ! -f "$1" ]; then
		no "sudoers $2 ($1) missing"
		return
	fi
	if visudo -cf "$1" > /dev/null 2>&1; then
		ok "sudoers $2 ($1) valid"
	else
		no "sudoers $2 ($1) invalid" "$(visudo -cf "$1" 2>&1 | tail -1)"
	fi
}

# check_web_cache_zones - a cache flag whose zone is gone breaks nginx -t box-wide: the
# vhost references a zone nginx never loaded.
check_web_hsts_effective() {
	local u d line hsts front conf miss=0 first='' checked=0
	front="${PROXY_SYSTEM:-$WEB_SYSTEM}"
	[ -n "$front" ] || {
		skip "no web front - hsts guard not checkable"
		return
	}
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			case "$line" in *"SSL_HSTS='yes'"*) ;; *) continue ;; esac
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			checked=$((checked + 1))
			conf="$HOMEDIR/$u/conf/web/$d/$front.hsts.conf"
			# Two ways to be switched on and still send nothing: no fragment for this front, or a
			# fragment carrying the other server's directive (#638).
			hsts='ok'
			[ -s "$conf" ] || hsts='missing'
			if [ "$hsts" = 'ok' ]; then
				case "$front" in
					apache2) grep -q '^Header' "$conf" || hsts='wrong syntax' ;;
					*) grep -q '^add_header' "$conf" || hsts='wrong syntax' ;;
				esac
			fi
			[ "$hsts" = 'ok' ] && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="$d: $hsts ($front)"
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "hsts switches have a fragment the front can read ($checked on)"
	else
		no "$miss domain(s) claim hsts without an effective fragment" "$first"
	fi
}

check_web_cache_zones() {
	local u d line miss=0 first="" checked=0
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			# Same role gating as the rebuild reapply: after a switch to a proxyless model the
			# flag stays recorded (inert) and MUST NOT count as a missing zone
			if [[ "$line" == *"PROXY_CACHE='yes'"* ]] && [ "$PROXY_SYSTEM" = 'nginx' ]; then
				checked=$((checked + 1))
				if [ ! -f "/etc/nginx/conf.d/cache-zone.$d.conf" ]; then
					miss=$((miss + 1))
					[ -z "$first" ] && first="proxy zone missing: $u/$d"
				fi
			fi
			if [[ "$line" == *"FASTCGI_CACHE='yes'"* ]] && [ "$WEB_SYSTEM" = 'nginx' ]; then
				checked=$((checked + 1))
				if ! grep -qF "keys_zone=$d:" /etc/nginx/conf.d/fastcgi_cache_pool.conf 2> /dev/null; then
					miss=$((miss + 1))
					[ -z "$first" ] && first="fastcgi zone missing: $u/$d"
				fi
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "cache zones match their flags ($checked flag(s))"
	else
		no "$miss cache zone(s) missing for enabled flags" "$first"
	fi
}

# check_web_http3_orphan - a quic listen fragment (nginx.ssl.conf_http3, #613) on a box whose nginx
# lacks http_v3 fails nginx -t box-wide. The switch is capability-gated at write and the rebuild
# reconciles it off, so one surviving here means the nginx package changed under a live install, or
# a fragment was placed out of band. A recorded HTTP3='yes' WITHOUT a fragment is fine and NOT
# flagged - that is intent kept for a later move onto a capable host.
check_web_http3_orphan() {
	local u frag d stray=0 first="" checked=0
	# where nginx can do http3 a fragment is correct, so there is nothing to police
	if nginx_has_http3; then
		ok "http3 fragments match the nginx build (http_v3 present)"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		for frag in "$HOMEDIR/$u"/conf/web/*/nginx.ssl.conf_http3; do
			[ -f "$frag" ] || continue
			checked=$((checked + 1))
			stray=$((stray + 1))
			d=$(basename "$(dirname "$frag")")
			[ -z "$first" ] && first="quic fragment on a box without http_v3: $u/$d"
		done
	done
	if [ "$stray" -eq 0 ]; then
		ok "no quic fragment on a box whose nginx lacks http_v3"
	else
		no "$stray quic fragment(s) on a box whose nginx has no http_v3" "$first"
	fi
}

# check_web_docker_wildcard - the add-command's wildcard check is a snapshot: a customer can bind
# 0.0.0.0 tomorrow, or an addon can take a new wildcard port. The docker domain then keeps its
# port, the customer bind silently fails and the outage shows at the NEIGHBOUR, not the causer
# (measured, #566). This is the standing counterpart: no wildcard listener may hold a port a
# docker domain proxies to.
check_web_docker_wildcard() {
	local u line d port hit=0 first="" checked=0 wildcards
	wildcards=$(ss -ltnH 2> /dev/null | awk '{print $4}' \
		| grep -E '^(0\.0\.0\.0|\*|\[::\]):' | grep -oE '[0-9]+$' | sort -u)
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			grep -q "DOCKER='[^']" <<< "$line" || continue
			port=$(sed -n "s/.*DOCKER_PORT='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$port" ] || continue
			checked=$((checked + 1))
			if grep -qxF "$port" <<< "$wildcards"; then
				hit=$((hit + 1))
				d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
				[ -z "$first" ] && first="wildcard listener holds docker port $port ($u/$d)"
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$hit" -eq 0 ]; then
		ok "no wildcard listener on a docker domain port ($checked checked)"
	else
		no "$hit docker domain port(s) held by a wildcard listener" "$first"
	fi
}

# check_vhost_nonempty - a 0-byte vhost passes apache2 -t and the domain silently falls
# through to the box default vhost.
check_vhost_nonempty() {
	local f n=0 miss=0 first=""
	for f in "/etc/$WEB_SYSTEM/conf.d/domains"/*.conf "/etc/${PROXY_SYSTEM:-none}/conf.d/domains"/*.conf; do
		[ -e "$f" ] || continue
		n=$((n + 1))
		if [ ! -s "$f" ]; then
			miss=$((miss + 1))
			[ -z "$first" ] && first="$f is empty"
		fi
	done
	if [ "$miss" -eq 0 ]; then
		ok "no empty vhost configs ($n checked)"
	else
		no "$miss empty vhost config(s)" "$first"
	fi
}
# check_vhost_upstream_host - "http://:3000" (docker domain, owner without DOCKER_IP) makes nginx
# and apache reject the whole configuration. Read the rendered files: a custom template does it too.
check_vhost_upstream_host() {
	local f n=0 hit=0 first=""
	for f in "/etc/$WEB_SYSTEM/conf.d/domains"/*.conf "/etc/${PROXY_SYSTEM:-none}/conf.d/domains"/*.conf; do
		[ -e "$f" ] || continue
		n=$((n + 1))
		if grep -qE '://:[0-9]+' "$f"; then
			hit=$((hit + 1))
			[ -z "$first" ] && first="$f proxies to a port without a host"
		fi
	done
	if [ "$hit" -eq 0 ]; then
		ok "no vhost proxies to a hostless upstream ($n checked)"
	else
		no "$hit vhost(s) proxy to a hostless upstream" "$first"
	fi
}
# check_error_code_registry - the exit codes live twice, in the shell and in the panel, and nothing
# holds them together. Known alias: E_FORBIDEN/E_FORBIDDEN share 10 on purpose.
check_error_code_registry() {
	local sh_file="$HESTIA/include/main.sh" php_file="$HESTIA/web/inc/helpers.php"
	local name val conflict=0 dupes=0 n=0 first=""
	if [ ! -f "$sh_file" ] || [ ! -f "$php_file" ]; then
		skip "error code registries not both present"
		return
	fi
	declare -A _sh=() _php=() _seen=()
	while IFS='=' read -r name val; do
		_sh[$name]=$val
		n=$((n + 1))
	done < <(grep -oE '^E_[A-Z_]+=[0-9]+' "$sh_file")
	while read -r name val; do
		_php[$name]=$val
	done < <(sed -n 's/^const \(E_[A-Z_]*\) *= *\([0-9]*\);.*/ /p' "$php_file")
	for name in "${!_sh[@]}"; do
		[ -n "${_php[$name]:-}" ] || continue
		if [ "${_sh[$name]}" != "${_php[$name]}" ]; then
			conflict=$((conflict + 1))
			[ -z "$first" ] && first="$name is ${_sh[$name]} in the shell and ${_php[$name]} in the panel"
		fi
	done
	for name in "${!_php[@]}"; do
		case "$name" in E_FORBIDEN | E_FORBIDDEN) continue ;; esac
		val=${_php[$name]}
		if [ -n "${_seen[$val]:-}" ]; then
			dupes=$((dupes + 1))
			[ -z "$first" ] && first="${_seen[$val]} and $name both use $val in the panel"
		fi
		_seen[$val]=$name
	done
	if [ "$conflict" -eq 0 ] && [ "$dupes" -eq 0 ]; then
		ok "error codes agree between shell and panel ($n shell codes)"
	else
		no "$((conflict + dupes)) error code(s) out of step" "$first"
	fi
}
# check_eval_sites - two named files used to be guarded one by one, which is a list nobody measures:
# a new eval in a third file would have gone unseen. Derived instead - every eval used as a command
# in bin/h-* and include/*.sh is found, and only the two that have a reason may remain.
#
# Whole-line comments are dropped BEFORE the search so the search can stay broad. Command position
# is more than line start, ; & and |: `then eval`, `do eval` and `else eval` sit in it too, and the
# narrow pattern that was here first missed all three - the very blind spot a hand-kept list has.
# A trailing # is never stripped (it is not a comment in $#, ${v#p}, heredocs), so a comment that
# writes "eval " can still match. That direction is a loud false positive; the other one is the hole
# this guard exists to close.
#
# Does NOT cover: sbin/, web/, share/, and eval reached through a variable or an alias.
check_eval_sites() {
	local allowed="h-add-web-domain-ssl main.sh" f base extra='' hit='' miss='' scanned=0 carry=0
	for f in "$HESTIA/bin"/h-* "$HESTIA/include"/*.sh; do
		[ -f "$f" ] || continue
		scanned=$((scanned + 1))
		sed '/^[[:space:]]*#/d' "$f" | grep -qE '(^|[^[:alnum:]_])eval[[:space:]]' || continue
		carry=$((carry + 1))
		base=$(basename "$f")
		hit="$hit $base"
		case " $allowed " in *" $base "*) continue ;; esac
		extra="$extra $base"
	done
	# Both known sites must still turn up. A sweep that looked at nothing, or one that lost sight of
	# a site it used to see, shrank its reference set - which is worse than no guard, because green
	# then means "looked at less" instead of "found nothing".
	for base in $allowed; do
		case " $hit " in *" $base "*) ;; *) miss="$miss $base" ;; esac
	done
	if [ "$scanned" -lt 400 ]; then
		no "the eval-sweep scanned only $scanned file(s)" "expected all of $HESTIA/bin/h-* and $HESTIA/include/*.sh"
	elif [ -n "$extra" ]; then
		no "eval-use over record text outside the two known places" "$extra"
	elif [ -n "$miss" ]; then
		no "a known eval-site stopped matching - sweep or file changed" "$miss"
	else
		ok "no new eval-sites ($carry of $scanned scanned file(s) carry one, both known)"
	fi
}

# check_yescrypt_hashing - the panel login of every account whose /etc/shadow entry is yescrypt runs
# through mkpasswd from the whois package, and yescrypt is the PAM default on all four targets. If
# the binary is gone or its libcrypt cannot do yescrypt, NOBODY logs in and the panel says "invalid
# password" - a total outage wearing the mask of a typo. So this asks by doing the thing the login
# does: hash a known string, then reproduce it from its own setting, which is the exact comparison
# h-check-user-password makes against the shadow entry.
#
# Does NOT cover md5/sha-512/des accounts - those go through h-generate-password-hash (perl crypt).
check_yescrypt_hashing() {
	local ref again setting probe='hestia-smoke-probe'
	if ! command -v mkpasswd > /dev/null 2>&1; then
		no "mkpasswd is missing - no yescrypt account can log in" "the whois package provides it"
		return
	fi
	ref=$(mkpasswd -m yescrypt "$probe" 2> /dev/null)
	case "$ref" in
		'$y$'*) ;;
		*)
			no "mkpasswd cannot produce a yescrypt hash" "it returned '${ref:-nothing}' - check libcrypt"
			return
			;;
	esac
	setting="${ref%\$*}\$"
	again=$(mkpasswd "$probe" "$setting" 2> /dev/null)
	if [ "$again" != "$ref" ]; then
		no "yescrypt hashing does not reproduce from its own setting" "every panel login would be refused"
	else
		ok "yescrypt hashing works and reproduces from its setting"
	fi
}

# check_protected_names - the floor that stops a record from binding PATH or BIN (#807). Two ways
# it could go green while protecting nothing: the list empties, or a name in it is also a real
# config key, in which case the floor locks that key out of every conf. Both are checked here, and
# the second is checked against the key registries rather than a second hand-kept list.
check_protected_names() {
	local n bad=0 first="" reg regs nregs
	regs="web mail mail_accounts user cron db system ip backup_excludes"
	nregs=$(wc -w <<< "$regs")
	n=$(wc -w <<< "$SOURCE_CONF_PROTECTED")
	if [ "${n:-0}" -lt 10 ]; then
		no "protected name list is empty or short ($n)" "SOURCE_CONF_PROTECTED in include/main.sh"
		return
	fi
	for reg in $regs; do
		for name in $(syshealth_known_keys "$reg"); do
			is_protected_key "$name" || continue
			bad=$((bad + 1))
			[ -z "$first" ] && first="$name is both a $reg key and a protected name"
		done
	done
	# Derived from the data, not from the compiled lists: a name can be a config key without being
	# in any registry (BACKUP_TEMP was, and the floor swallowed it in silence). If a conf on this
	# box carries a protected name as a key, the floor is dropping something real.
	local pat live
	pat="^($(tr -s ' \n' '||' <<< "$SOURCE_CONF_PROTECTED" | sed -e 's/^|//' -e 's/|$//'))="
	live=$(grep -lE "$pat" "$HESTIA/conf"/*.conf "$CONF_DIR/users"/*/user.conf \
		"$CONF_DIR/users"/*/backup-excludes.conf "$CONF_DIR/packages"/*.pkg "$CONF_DIR/ips"/* \
		2> /dev/null | head -3 | tr '\n' ' ')
	if [ "$bad" -gt 0 ]; then
		no "$bad protected name(s) collide with a real config key" "$first"
	elif [ -n "$live" ]; then
		no "a protected name is used as a key in a live config" "$live"
	else
		ok "protected names hold and collide with no config key ($n names, $nregs registries)"
	fi
}
# check_record_only_protected - RECORD_ONLY_PROTECTED carries names source_conf MUST accept (they
# are honest hestia.conf / restic.conf keys) while the record parser must refuse them. Floor and
# list differ only in WHERE a name is allowed, so the question this asks is: does one of them ever
# appear as a key in a RECORD? BACKUP is deliberately absent from the list because it is one.
#
# Does NOT cover records inside an archive - refusing those is the parser's job, not this check's.
check_record_only_protected() {
	local n names f reads=0 bad='' pat
	names="$RECORD_ONLY_PROTECTED"
	n=$(wc -w <<< "$names")
	if [ "${n:-0}" -lt 1 ]; then
		no "the record-only protected list is empty" "RECORD_ONLY_PROTECTED in include/main.sh"
		return
	fi
	pat="^[[:space:]]*($(tr -s ' \n' '||' <<< "$names" | sed -e 's/^|//' -e 's/|$//'))="
	for f in "$CONF_DIR/users"/*/*.conf "$CONF_DIR/users"/*/mail/*.conf "$CONF_DIR/packages"/*.pkg; do
		[ -f "$f" ] || continue
		# Positive control per file: it must yield a key at all. Without it a clean result is
		# indistinguishable from a sweep that read nothing.
		if grep -qE '^[A-Z][A-Z0-9_]*=' "$f"; then
			reads=$((reads + 1))
		fi
		if grep -qE "$pat" "$f"; then
			bad="$bad $(basename "$(dirname "$f")")/$(basename "$f")"
		fi
	done
	if [ "$reads" -eq 0 ]; then
		no "the record sweep read no key from any record file" "looked under $CONF_DIR/users and $CONF_DIR/packages"
	elif [ -n "$bad" ]; then
		no "a record-only protected name is used as a record key" "$bad"
	else
		ok "record-only names appear in no record ($n names, $reads record file(s) read)"
	fi
}
# check_protected_names_effective - the list above is a claim; this is the effect. A record that
# tries to bind PATH must not change it, and a harmless one must still bind, in the same run.
check_protected_names_effective() {
	local tmp before after
	local name_before="$NAME"
	before="$PATH"
	tmp=$(mktemp)
	printf "NAME='probe'\nPATH=/tmp/hestia-smoke-should-not-happen\n" > "$tmp"
	NAME=''
	source_conf "$tmp" 2> /dev/null
	after="$PATH"
	local bound="$NAME"
	NAME="$name_before"
	rm -f "$tmp"
	if [ "$before" != "$after" ]; then
		PATH="$before"
		no "a config file rebound PATH (#807)" "source_conf accepted a protected name"
	elif [ "$bound" != "probe" ]; then
		no "the protected-name probe never bound anything" "source_conf read nothing - the check proves nothing"
	else
		ok "a config file cannot rebind PATH, an ordinary key still binds"
	fi
}
# check_restic_pairs - a snapshot without its package cannot be restored, a package without its
# snapshot describes nothing. Derived from the tags, so it also sees a package deleted by hand.
check_restic_pairs() {
	local u repo tags pkg tag n=0 orphan_snap=0 orphan_pkg=0 first="" unread=0 first_unread=""
	repo=$(restic_repo_base) || {
		ok "no restic repository configured - pairs not checked"
		return
	}
	command -v restic > /dev/null 2>&1 || {
		skip "restic not installed"
		return
	}
	local json ids sid rc
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/restic.conf" ] || continue
		json=$(restic --repo "$repo$u" --password-file "$CONF_DIR/users/$u/restic.conf" --json \
			snapshots 2> /dev/null)
		rc=$?
		# A repository that cannot be read is not an empty one: counting orphans here would blame
		# every package for a broken line.
		if [ "$rc" -ne 0 ]; then
			unread=$((unread + 1))
			[ -z "$first_unread" ] && first_unread="repository for $u could not be read (restic rc=$rc)"
			continue
		fi
		tags=$(grep -o '"meta:[^"]*"' <<< "$json" | tr -d '"')
		ids=$(grep -o '"short_id":"[^"]*"' <<< "$json" | cut -d'"' -f4)
		for tag in $tags; do
			n=$((n + 1))
			[ -f "$BACKUP/$u/${tag#meta:}.meta.tgz" ] && continue
			orphan_snap=$((orphan_snap + 1))
			[ -z "$first" ] && first="$u: snapshot tagged $tag has no package"
		done
		for pkg in "$BACKUP/$u/$u".*.meta.tgz; do
			[ -f "$pkg" ] || continue
			tag="meta:$(basename "$pkg" .meta.tgz)"
			grep -qxF "$tag" <<< "$tags" && continue
			# Second direction: the snapshot the package names itself.
			sid=$(tar -xzOf "$pkg" ./restic.meta 2> /dev/null | sed -n "s/^SNAPSHOT='\([^']*\)'.*/\1/p")
			[ -n "$sid" ] && grep -qxF "$sid" <<< "$ids" && continue
			orphan_pkg=$((orphan_pkg + 1))
			[ -z "$first" ] && first="$u: package $(basename "$pkg") has no snapshot"
		done
	done
	if [ "$unread" -gt 0 ]; then
		no "$unread restic repository(s) could not be read - only $n pair(s) checked" "$first_unread"
	elif [ "$((orphan_snap + orphan_pkg))" -eq 0 ]; then
		ok "every restic snapshot has its package ($n pair(s))"
	else
		no "$((orphan_snap + orphan_pkg)) restic artefact(s) without a partner" "$first"
	fi
}
# check_restic_mode_supported - restic mode without the addon or without a repository means no
# backup at all, and the nightly run says so only in the log.
check_restic_mode_supported() {
	local u m repo n=0 bad=0 first=""
	# The gate's own resolution, called directly - the gate would exit through check_result.
	repo=$(restic_repo_base) || repo=""
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		m=$(sed -n "s/^.*BACKUPS_MODE='\([^']*\)'.*/\1/p" "$CONF_DIR/users/$u/user.conf" 2> /dev/null | head -1)
		[ "$m" = 'restic' ] || continue
		n=$((n + 1))
		if ! restic version > /dev/null 2>&1; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but restic is not installed"
		elif [ -z "$repo" ]; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but no repository is configured"
		fi
	done
	if [ "$bad" -eq 0 ]; then
		ok "restic mode is supported where it is set ($n customer(s))"
	else
		no "$bad customer(s) in restic mode without support" "$first"
	fi
}
# check_logrotate_parses - a doubled path makes logrotate exit 1 and the unit stay failed. Only a
# collision with one of our files is ours; base-system ones are named, not red.
check_logrotate_parses() {
	local out owned line path f pat mine ours=0 base=0 first="" basefiles="" mycount=0
	if ! command -v logrotate > /dev/null 2>&1; then
		skip "logrotate not installed"
		return
	fi
	out=$(logrotate -d /etc/logrotate.conf 2>&1)
	# ours = whatever no package claims, so a file added by hand counts as ours too
	owned=$(dpkg -S /etc/logrotate.d/* 2> /dev/null | sed 's/^[^:]*: //')
	for f in /etc/logrotate.d/*; do
		[ -f "$f" ] || continue
		grep -qxF "$f" <<< "$owned" || mycount=$((mycount + 1))
	done
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		path=${line##*duplicate log entry for }
		[ "$path" != "$line" ] || continue
		mine=0
		for f in /etc/logrotate.d/*; do
			[ -f "$f" ] || continue
			grep -qxF "$f" <<< "$owned" && continue
			while read -r pat; do
				# shellcheck disable=SC2254  # the config line IS a glob, matching it is the point
				case "$path" in $pat) mine=1 ;; esac
			done < <(grep -oE '^/[^ {]+' "$f")
		done
		if [ "$mine" = 1 ]; then
			ours=$((ours + 1))
			[ -z "$first" ] && first="${line#error: }"
		else
			base=$((base + 1))
			f=${line#error: }
			f=${f%%:*}
			grep -qw "$f" <<< "$basefiles" || basefiles="${basefiles:+$basefiles, }$f"
		fi
	done <<< "$(grep '^error:' <<< "$out")"
	if [ "$ours" -gt 0 ]; then
		no "$ours logrotate collision(s) involving a file of ours" "$first"
	elif [ "$base" -gt 0 ]; then
		ok "logrotate: our $mycount file(s) collide with nothing - $base base-system conflict(s), not ours: $basefiles"
	else
		ok "logrotate parses its configuration (ours: $mycount file(s))"
	fi
}
# check_web_record_has_vhost - the upstream check reads files, so a domain whose vhost was skipped
# looks clean by being absent. Expectation comes from the record: a docker domain in a proxy model
# has its backend vhost removed on purpose, everything else needs the front (and the proxy it names).
# Not covered: the SSL variant of a fragment, and whether the vhost inside is the right one.
check_web_record_has_vhost() {
	local u line d docker proxy sys fronts n=0 miss=0 first=""
	if [ -z "$WEB_SYSTEM" ]; then
		skip "no web system - vhost coverage not checked"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			docker=$(sed -n "s/.* DOCKER='\([^']*\)'.*/\1/p" <<< "$line")
			proxy=$(sed -n "s/.* PROXY='\([^']*\)'.*/\1/p" <<< "$line")
			if [ -n "$docker" ] && [ -n "$PROXY_SYSTEM" ] && [ "$WEB_SYSTEM" != "$PROXY_SYSTEM" ]; then
				fronts="$PROXY_SYSTEM"
			else
				fronts="$WEB_SYSTEM"
				[ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] && fronts="$fronts $PROXY_SYSTEM"
			fi
			for sys in $fronts; do
				n=$((n + 1))
				[ -f "/etc/$sys/conf.d/domains/$d.conf" ] && continue
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d has no $sys vhost"
			done
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "every web record has its vhost ($n checked)"
	else
		no "$miss web record(s) without a vhost" "$first"
	fi
}
# check_web_templates_resolvable - a record pointing at a template that no longer exists
# renders nothing. add_web_config now refuses instead of writing an empty vhost, so the
# damage is visible - but only on the next rebuild, which may be weeks away.
check_web_templates_resolvable() {
	local u line d tpl proxy backend miss=0 first="" checked=0
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			tpl=$(sed -n "s/.*[^_]TPL='\([^']*\)'.*/\1/p" <<< "$line")
			proxy=$(sed -n "s/.* PROXY='\([^']*\)'.*/\1/p" <<< "$line")
			backend=$(sed -n "s/.* BACKEND='\([^']*\)'.*/\1/p" <<< "$line")
			checked=$((checked + 1))
			if [ -n "$WEB_SYSTEM" ] && [ -n "$tpl" ] \
				&& [ ! -f "$(web_template_file "$WEB_SYSTEM" "$tpl" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d TPL='$tpl'"
			fi
			if [ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] \
				&& [ ! -f "$(web_template_file "$PROXY_SYSTEM" "$proxy" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d PROXY='$proxy'"
			fi
			if [ -n "$WEB_BACKEND" ] && [ -n "$backend" ] \
				&& [ ! -f "$PHPTPL/$backend.tpl" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d BACKEND='$backend'"
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "every web record resolves to a template ($checked domain(s))"
	else
		no "$miss web record value(s) point at a missing template" "$first"
	fi
}

# check_object_counters - the record-derived counters against a recount, using the same
# derivation rules as h-update-user-counters. Not covered, deliberately: U_DISK*/U_BANDWIDTH
# (measured, not derivable from records) and U_USERS (an admin-wide count, not one of this
# user's records).
check_object_counters() {
	local u ud stored drift=0 first="" checked=0 ipf ip real
	_ctr() {
		stored=$(grep -o "${1}='[0-9]*'" "$ud/user.conf" 2> /dev/null | head -1 | tr -dc 0-9)
		[ -n "$stored" ] || return 0
		checked=$((checked + 1))
		if [ "$stored" != "$2" ]; then
			drift=$((drift + 1))
			[ -z "$first" ] && first="$u $1 stored=$stored counted=$2"
		fi
	}
	# grep -c prints its count even at rc 1 (zero matches) - a fallback echo would
	# double the output
	_cnt() {
		[ -f "$2" ] || {
			echo 0
			return
		}
		grep -c "$1" "$2" || true
	}
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		ud="$CONF_DIR/users/$u"
		_ctr U_WEB_DOMAINS "$(_cnt . "$ud/web.conf")"
		_ctr U_WEB_SSL "$(_cnt "SSL='yes'" "$ud/web.conf")"
		_ctr U_WEB_ALIASES "$(grep -o "ALIAS='[^']*'" "$ud/web.conf" 2> /dev/null \
			| awk -F"'" '{ if ($2 != "") s += split($2, a, ",") } END { print s + 0 }')"
		_ctr U_MAIL_DOMAINS "$(_cnt . "$ud/mail.conf")"
		_ctr U_MAIL_DKIM "$(_cnt "DKIM='yes'" "$ud/mail.conf")"
		_ctr U_MAIL_ACCOUNTS "$(cat "$ud"/mail/*.conf 2> /dev/null | grep -c "ACCOUNT='" || true)"
		_ctr U_DATABASES "$(_cnt . "$ud/db.conf")"
		_ctr U_CRON_JOBS "$(_cnt . "$ud/cron.conf")"
		_ctr U_BACKUPS "$(_cnt . "$ud/backup.conf")"
		# The suspended mirrors, by the same rule the recount uses. Nothing else watches them: no
		# recount runs on a schedule, only h-rebuild-user and h-update-user-counters, on demand.
		_ctr SUSPENDED_WEB "$(_cnt "SUSPENDED='yes'" "$ud/web.conf")"
		_ctr SUSPENDED_MAIL "$(_cnt "SUSPENDED='yes'" "$ud/mail.conf")"
		_ctr SUSPENDED_DB "$(_cnt "SUSPENDED='yes'" "$ud/db.conf")"
		_ctr SUSPENDED_CRON "$(_cnt "SUSPENDED='yes'" "$ud/cron.conf")"
	done
	# Records store the ADDRESS THE DOMAIN ANSWERS ON, which behind NAT is the public
	# one, while the ip file is named after the local address - so both count here, or
	# the recount is 0 on every NAT'd box and the guard "corrects" healthy counters
	local nat
	for ipf in "$CONF_DIR/ips"/*; do
		[ -f "$ipf" ] || continue
		ip=$(basename "$ipf")
		nat=$(grep -o "NAT='[^']*'" "$ipf" 2> /dev/null | head -1 | cut -d"'" -f2)
		stored=$(grep -o "U_WEB_DOMAINS='[0-9]*'" "$ipf" 2> /dev/null | head -1 | tr -dc 0-9)
		[ -n "$stored" ] || continue
		real=$(grep -hoF -e "IP='$ip'" ${nat:+-e "IP='$nat'"} \
			"$CONF_DIR/users"/*/web.conf 2> /dev/null | grep -c .)
		checked=$((checked + 1))
		if [ "$stored" != "$real" ]; then
			drift=$((drift + 1))
			[ -z "$first" ] && first="ip $ip U_WEB_DOMAINS stored=$stored counted=$real"
		fi
	done
	if [ "$drift" -eq 0 ]; then
		ok "object counters match the counted objects ($checked checked)"
	else
		no "$drift counter(s) drifted from their objects" "$first"
	fi
}

# check_key_registries - conf/defaults/*.conf must exist and match the key sets compiled into
# include/syshealth.sh. A registry that is missing, stale or duplicated makes the repair functions
# skip exactly the keys they exist to add, and does it silently (#559) - which is the whole reason
# this guard is here rather than a comment.
check_key_registries() {
	local sys want have missing='' drift='' dupes=''
	if ! declare -F syshealth_known_keys > /dev/null 2>&1; then
		skip "syshealth_known_keys unavailable - key registries not checkable"
		return
	fi
	local unknown=''
	for sys in web mail mail_accounts user cron db ip system; do
		# An empty reference must not pass as agreement: the writer feeds from the same function, so
		# a subsystem with no branch would write an empty registry that then matches its own empty
		# source. Caught here rather than reported as PASS on eight empty files.
		if ! want="$(syshealth_known_keys "$sys")" || [ -z "$want" ]; then
			unknown="$unknown $sys"
			continue
		fi
		want="$(echo "$want" | tr ' ' '\n' | sed '/^$/d')"
		if [ ! -f "$HESTIA/conf/defaults/$sys.conf" ]; then
			missing="$missing $sys"
			continue
		fi
		have="$(sed '/^$/d' "$HESTIA/conf/defaults/$sys.conf")"
		[ "$have" = "$want" ] || drift="$drift $sys"
		[ -z "$(echo "$have" | sort | uniq -d)" ] || dupes="$dupes $sys"
	done
	if [ -n "$missing$drift$dupes$unknown" ]; then
		no "key registries out of sync" \
			"missing:${missing:- none} drift:${drift:- none} duplicates:${dupes:- none} no-key-set:${unknown:- none}"
	else
		ok "key registries match the compiled key sets"
	fi
}

# check_identity_band - the allocator's preconditions, not its output. Panel users
# created before #388 keep their old uid by design, so their position is NOT checked;
# what must hold is that nothing can wander into the band and that the subordinate
# ranges the companion needs are actually permitted.
check_identity_band() {
	local defs='/etc/login.defs' band_start=11000 v dupes
	if [ ! -f "$defs" ]; then
		skip "login.defs absent - identity band guard not checkable"
		return
	fi

	for key in UID_MAX GID_MAX; do
		v=$(awk -v k="$key" '$1 == k { print $2; exit }' "$defs")
		if [ -n "$v" ] && [ "$v" -lt "$band_start" ] 2> /dev/null; then
			ok "$key caps below the panel band"
		else
			no "$key is ${v:-unset}, not below $band_start" "a bare useradd can land inside the band and collide with an allocation"
		fi
	done

	# The shipped default (600100000) sits below the highest range the formula produces,
	# which would reject the companion subuid ranges of roughly 43% of usernames - and
	# only at "enable Docker", long after the account was made.
	for key in SUB_UID_MAX SUB_GID_MAX; do
		v=$(awk -v k="$key" '$1 == k { print $2; exit }' "$defs")
		if [ -n "$v" ] && [ "$v" -ge 1048675999 ] 2> /dev/null; then
			ok "$key covers the whole subordinate range"
		else
			no "$key is ${v:-unset}, below the highest computed range end" "companion subuid ranges would be rejected later (#389)"
		fi
	done

	# Two panel users on one uid is corruption, not a legacy artefact.
	dupes=$(for u in "$CONF_DIR"/users/*/; do
		u=$(basename "$u")
		[ "$u" = '*' ] && continue
		id -u "$u" 2> /dev/null
	done | sort | uniq -d | wc -l)
	if [ "$dupes" -eq 0 ]; then
		ok "no two panel users share a uid"
	else
		no "$dupes uid(s) shared by more than one panel user" "ownership cannot be separated; check /etc/passwd"
	fi
}

# check_proc_hardening - the exemption is a live mount option, so verify the running
# state, not the config. Catches a failed unit (fail-open is silent to users) and a gid
# that drifted off the group after a delete/recreate cycle.
check_proc_hardening() {
	local unit='hestia-proc-hardening.service' mounted group_gid
	if ! systemctl list-unit-files "$unit" > /dev/null 2>&1 \
		|| [ "$(systemctl is-enabled "$unit" 2> /dev/null)" != enabled ]; then
		skip "/proc hardening not enabled here (container?)"
		return
	fi

	[ "$(systemctl is-failed "$unit" 2> /dev/null)" = failed ] \
		&& no "/proc hardening unit failed" "boot left /proc unhardened; systemctl status $unit"

	if grep -q ' /proc .*hidepid=' /proc/self/mountinfo /proc/mounts 2> /dev/null; then
		ok "/proc carries hidepid"
	else
		no "/proc has no hidepid" "every user can read foreign /proc/*/cmdline; systemctl start $unit"
	fi

	# A stale numeric gid would exempt whoever holds it now, which is the failure the
	# unit resolves the group at boot to avoid - so it must not reappear.
	mounted=$(awk '$2 == "/proc" { print $4 }' /proc/mounts | tr ',' '\n' | sed -n 's/^gid=//p')
	group_gid=$(getent group procvis 2> /dev/null | cut -d: -f3)
	if [ -z "$mounted" ]; then
		[ -z "$group_gid" ] && ok "/proc exemption absent, procvis absent" \
			|| no "/proc exemption missing while procvis exists" "gid $group_gid is not exempt; rootless Docker cannot start containers"
	elif [ "$mounted" = "$group_gid" ]; then
		ok "/proc exemption gid matches procvis"
	else
		no "/proc exemption gid $mounted is not procvis (${group_gid:-absent})" "a recycled gid silently exempts a foreign group"
	fi
}

# check_web_model_sentinel - flag an interrupted model switch so the box reports it
# rather than the operator discovering it at the next reboot.
check_mesh_serve_staged() {
	# Without the staging, /mesh-decisions.php 404s and every peer silently stops receiving this box's
	# bans - and since /run is tmpfs, a missed refresh after a boot looks healthy from anywhere else.
	if [ ! -s "$CONF_DIR/crowdsec/peers.conf" ]; then
		ok "crowdsec mesh has no peers paired"
	elif [ -f /run/hestia/mesh/tokens ] && [ -f /run/hestia/mesh/published.json ]; then
		ok "crowdsec mesh serve side staged"
	else
		no "crowdsec mesh peers paired but /run/hestia/mesh not staged" "run: h-update-crowdsec-mesh"
	fi
}

check_realip_header() {
	local f=/etc/nginx/conf.d/cloudflare.inc
	# The installer rewrites this file from the CF API and skips it silently on a failed
	# fetch. Without real_ip_header nginx defaults to X-Real-IP, which the client controls:
	# CF-Connecting-IP is then ignored (every visitor logs as the CF edge, so fail2ban bans
	# the edge) and a forged X-Real-IP becomes $remote_addr for every ban consumer.
	if [ ! -f "$f" ]; then
		skip "cloudflare realip include absent"
	elif grep -qE '^\s*real_ip_header' "$f"; then
		ok "cloudflare realip names its header"
	else
		no "cloudflare realip has no real_ip_header (#553)" "nginx then trusts client-set X-Real-IP; re-copy share/nginx/cloudflare.inc"
	fi
}

check_slice_dropins_owned() {
	local d uid orphan='' first=''
	for d in /etc/systemd/system.control/user-*.slice.d; do
		[ -d "$d" ] || continue
		uid=$(basename "$d")
		uid=${uid#user-}
		uid=${uid%.slice.d}
		getent passwd "$uid" > /dev/null 2>&1 && continue
		orphan=$((${orphan:-0} + 1))
		[ -z "$first" ] && first="uid $uid"
	done
	if [ -z "$orphan" ]; then
		ok "no resource drop-in outlives its account"
	else
		no "$orphan resource drop-in(s) without an account" \
			"$first - a later account reusing the uid inherits the limit with no visible cause"
	fi
}

check_web_model_sentinel() {
	local s="/var/lib/hestia/web-model-switch/IN_PROGRESS" op
	if [ -f "$s" ]; then
		op=$(sed -n 's/^op=//p' "$s")
		no "interrupted web-model switch pending (#120)" "recover: ${op:-h-<add|delete>-sys-<nginx|apache2>} --recover"
	else
		ok "no interrupted web-model switch"
	fi
}

