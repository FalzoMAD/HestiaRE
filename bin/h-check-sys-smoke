#!/bin/bash
# info: post-install smoke test (services, ports, logs)
# options: NONE
#
# example: h-check-sys-smoke
#
# Verifies that a fresh install came up: the services implied by the active
# configuration are running, the expected ports listen, the panel answers, and no
# critical markers are in the key logs. Preset-independent — it derives what to
# expect from hestia.conf's *_SYSTEM vars and install.conf's COMPONENT_* flags.
# Prints PASS/FAIL per check; exits 0 if all pass, 1 otherwise. No v-* symlink.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/firewall.sh
source $HESTIA/func/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# live component state (COMPONENT_* flags), if present
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

pass=0
fail=0

ok() {
	echo "[ PASS ] $1"
	pass=$((pass + 1))
}
no() {
	echo "[ FAIL ] $1${2:+ — $2}"
	fail=$((fail + 1))
}
skip() { echo "[ skip ] $1"; }

# check_source_absent <label> <pattern> <path...> — a vulnerable pattern must not
# reappear (static regression guard for a security fix). Comment lines excluded.
check_source_absent() {
	local label="$1" pat="$2"
	shift 2
	local hit
	hit=$(grep -rnE "$pat" "$@" 2> /dev/null | grep -vE ':[[:space:]]*(//|#|\*)')
	if [ -z "$hit" ]; then
		ok "invariant: $label"
	else
		no "invariant: $label" "$(echo "$hit" | head -n1)"
	fi
}

# check_session_user_allowlist <webdir> — $_SESSION["user"] is the REAL logged-in
# user; during impersonation it is the ADMIN, not the customer (who is in "look").
# Scoping customer data by it mis-targets (#438). Rather than chase every spelling
# of the bug, allowlist the files that may touch the real user at all (auth /
# dispatch / reset / real-identity display); ANY other file is red — it must use the
# look-aware $user/$user_plain from inc/main.php. Turns "did we catch every spelling"
# into "may this file see the real user".
check_session_user_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="inc/main.php login/index.php logout/index.php index.php list/index.php \
fm-auth.php rspamd-auth.php reset/index.php reset2fa/index.php edit/user/index.php \
list/log/index.php templates/includes/panel.php templates/pages/edit_server.php \
templates/pages/edit_user.php templates/pages/list_key.php templates/pages/list_log.php \
templates/pages/list_search.php templates/pages/list_user.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE '\$_SESSION\["user"\]' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: \$_SESSION[user] only in allowlisted files (#438)"
	else
		no "invariant: \$_SESSION[user] in non-allowlisted file (#438 mis-target risk)" "${bad# }"
	fi
}

# check_xaccel_allowlist <webdir> — only list/rrd/image.php may EMIT X-Accel-Redirect. Caddy serves it
# via file_server as `caddy`, which reads only the web-root files it owns (the RRD images); a download
# handler emitting it for a customer file hits the caddy-can't-read wall (#441) — stream via
# inc/download.php as `hestia` instead. Matches header(...) emission, not the handlers' prose.
check_xaccel_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="list/rrd/image.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE 'header\(["'"'"']X-Accel-Redirect' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: X-Accel-Redirect only emitted by allowlisted files (#441/#443)"
	else
		no "invariant: X-Accel-Redirect emitted by non-allowlisted file (caddy-can't-read wall)" "${bad# }"
	fi
}

# check_service <systemd-unit> <label>
check_service() {
	if systemctl is-active --quiet "$1"; then
		ok "service $2 ($1) active"
	else
		no "service $2 ($1) not active" "$(systemctl is-active "$1" 2> /dev/null)"
	fi
}

# check_port <port> <label>
check_port() {
	if ss -H -tln 2> /dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"; then
		ok "port $1 ($2) listening"
	else
		no "port $1 ($2) not listening"
	fi
}

# check_socket <path> <label> — listening unix socket
check_socket() {
	if ss -H -xln 2> /dev/null | grep -qF "$1"; then
		ok "socket $2 ($1) listening"
	else
		no "socket $2 ($1) not listening"
	fi
}

# check_firewall_closed - with the firewall enabled, INPUT must default to DROP.
# Boot-path guard: iptables-restore is atomic PER TABLE, so one rule matching an ipset that
# failed to load rejects the whole filter table and the box comes up with policy ACCEPT and no
# rules at all. Nothing else in the system notices that.
check_firewall_closed() {
	local pol
	pol=$(fw_policy_get INPUT)
	if [ -z "$pol" ]; then
		skip "firewall INPUT policy (backend not readable - root?)"
	elif [ "$pol" = 'DROP' ]; then
		ok "firewall INPUT policy closed (DROP)"
	else
		no "firewall INPUT policy is not DROP" "$pol"
	fi
}

# check_firewall_ruleset_loadable - the persisted ruleset must still be accepted by the backend, since
# that file IS what the boot unit reloads. Replaces the iptables-era check that every referenced ipset had
# a provisioning path: sets and the rules matching them now live in one document and load in one
# transaction, so the ordering hazard that could boot the box open no longer exists. What can still go
# wrong is the file being unparseable, and then the box boots with no ruleset at all.
check_firewall_ruleset_loadable() {
	local ruleset=/etc/hestia/firewall/ruleset.nft
	if [ ! -f "$ruleset" ]; then
		no "firewall ruleset not persisted" "$ruleset missing - a reboot would come up unfiltered"
		return
	fi
	if nft -c -f "$ruleset" > /dev/null 2>&1; then
		ok "persisted firewall ruleset loads"
	else
		no "persisted firewall ruleset is rejected by nft" "$(nft -c -f "$ruleset" 2>&1 | head -n1)"
	fi
}

# check_firewall_chains_tracked - the live ruleset must not carry a jail chain the object model has
# forgotten. This is check_firewall_sets_bootable's mirror image: there the model promised more than the
# live state delivered, here the live state holds more than the model admits to.
#
# Reachable today, and reproduced: deleting a multi-port jail leaves the jump behind (D4, bare --dport
# where -m multiport is needed), the leaked jump keeps the chain referenced so the following -X fails,
# and the next flush drops the jump while the teardown loop iterates chains.conf - where the record is
# already gone. Nothing ever reclaims the chain. It survives as an orphan that no h-list-firewall*
# command can see. Worth keeping after #496 fixes the cause: an untracked chain is a rule nobody audits.
check_firewall_chains_tracked() {
	local orphan='' c
	for c in $(fw_jail_chains_live); do
		grep -q "CHAIN='$c'" "$CONF_DIR/firewall/chains.conf" 2> /dev/null || orphan="$orphan $c"
	done
	if [ -n "$orphan" ]; then
		no "live firewall jail chain with no chains.conf record" "${orphan# }"
	else
		ok "firewall jail chains all tracked in the object model"
	fi
}

# check_http <url> <label>
check_http() {
	local code
	code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2> /dev/null)
	if [ "$code" = "200" ]; then
		ok "$2 (HTTP $code)"
	else
		no "$2 (HTTP ${code:-000})"
	fi
}

# check_rspamd_ctrl_isolation — the controller socket must be reachable by the
# Caddy proxy process but NOT by the app FPM pools that share the caddy user.
# Checked against live process creds + /etc/group, so a config regression fails here.
check_rspamd_ctrl_isolation() {
	local gid pid pgroups
	gid=$(getent group _rspamd-ctrl | cut -d: -f3)
	if [ -z "$gid" ]; then
		no "rspamd controller group _rspamd-ctrl missing"
		return
	fi
	# 1. socket carries the dedicated group (not plain _rspamd)
	if [ "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)" = '_rspamd-ctrl' ]; then
		ok "controller socket group is _rspamd-ctrl"
	else
		no "controller socket not group _rspamd-ctrl" "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)"
	fi
	# 2. caddy user NOT in the controller group (else app pools inherit via initgroups)
	if id -nG caddy 2> /dev/null | tr ' ' '\n' | grep -qxE '_rspamd(-ctrl)?'; then
		no "caddy user is in an rspamd group (app pools would inherit socket access)" "$(id -nG caddy)"
	else
		ok "caddy user not in any rspamd group (app pools isolated)"
	fi
	# 3. caddy proxy process DOES hold the group (else controller UI breaks)
	pid=$(systemctl show -p MainPID --value caddy.service 2> /dev/null)
	pgroups=$(grep -E '^Groups:' /proc/"${pid:-0}"/status 2> /dev/null)
	if echo "$pgroups" | tr ' \t' '\n' | grep -qx "$gid"; then
		ok "caddy proxy process holds _rspamd-ctrl (controller reachable)"
	else
		no "caddy proxy process lacks _rspamd-ctrl (controller UI would break)" "$pgroups"
	fi
}

# check_log_clean <file> <extended-regex> <label>
check_log_clean() {
	if [ ! -f "$1" ]; then
		skip "log $2 absent ($1)"
		return
	fi
	local hits
	hits=$(grep -aEc "$2" "$1" 2> /dev/null || true)
	if [ "${hits:-0}" -eq 0 ]; then
		ok "log $3 clean"
	else
		no "log $3 has $hits critical entr$([ "$hits" -eq 1 ] && echo y || echo ies)" "$1"
	fi
}

# check_file_empty <file> <label>  (fail if file exists and is non-empty)
check_file_empty() {
	if [ -s "$1" ]; then
		no "$2 non-empty" "$1"
	else
		ok "$2 empty/absent"
	fi
}

# check_banner <port> <label> — service answers with a protocol banner in 5s.
# Catches "active + listening but dead" (e.g. dovecot IMAP login hangs) that
# check_service/check_port miss.
check_banner() {
	local banner
	# head -n1, NOT head -c N: a byte-count read blocks until N bytes arrive
	banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1 && head -n1 <&3" 2> /dev/null)
	if [ -n "$banner" ]; then
		ok "port $1 ($2) answers with a banner"
	else
		no "port $1 ($2) gave no banner within 5s (service up but not functional?)"
	fi
}

# check_v_symlinks_resolve — no v-* compat alias may dangle (catches a rename/
# removal the install-time prune should have cleared). Extra aliases are fine.
check_v_symlinks_resolve() {
	local dangling first
	dangling=$(find "$HESTIA/bin" -maxdepth 1 -name 'v-*' -xtype l 2> /dev/null)
	if [ -z "$dangling" ]; then
		ok "no dangling v-* symlinks"
	else
		no "dangling v-* symlink(s)" "$(echo "$dangling" | head -n1 | xargs basename)"
	fi
}

# check_policy_fragment_coverage — a per-domain POLICY fragment (CrowdSec Layer A, bot rate limiting)
# must be in EVERY customer-domain template of its web system: it applies to all traffic, so a template
# missing one is a silent bypass (switch to the wordpress template, escape the throttle, nothing fails).
# Feature fragments (ssl/hsts/forcessl/fastcgi_cache) are NOT checked - they belong only to the
# templates implementing them. Scope = templates carrying %domain%, so the per-IP catch-all is skipped.
check_policy_fragment_coverage() {
	local tpl_root="$HESTIA/templates/web" sys frag f miss=0 first="" checked=0
	for sys in nginx apache2; do
		[ -d "$tpl_root/$sys" ] || continue
		case "$sys" in
			nginx) set -- nginx.crowdsec.conf nginx.botlimit.conf ;;
			apache2) set -- botlimit.apache2.conf ;;
		esac
		while read -r f; do
			[ -n "$f" ] || continue
			checked=$((checked + 1))
			for frag in "$@"; do
				grep -q "$frag" "$f" && continue
				miss=$((miss + 1))
				[ -z "$first" ] && first="${f#"$tpl_root/"} lacks $frag"
			done
		done < <(grep -rl '%domain%' "$tpl_root/$sys" 2> /dev/null)
	done
	if [ "$miss" -eq 0 ]; then
		ok "policy fragment includes complete ($checked domain templates)"
	else
		no "$miss policy fragment include(s) missing from web templates" "$first"
	fi
}

# check_info_headers — every h-* command must keep a non-empty `# info:` line
# (Hestia parses it for --help/usage; a comment sweep must not eat it).
check_info_headers() {
	local f n miss=0 first=""
	for f in "$HESTIA/bin"/h-*; do
		[ -f "$f" ] || continue
		n=$(sed -n 's/^# info:[[:space:]]*//p' "$f" | head -n1)
		if [ -z "$n" ]; then
			miss=$((miss + 1))
			[ -z "$first" ] && first="$(basename "$f")"
		fi
	done
	if [ "$miss" -eq 0 ]; then
		ok "all h-* commands have a # info: line"
	else
		no "$miss h-* command(s) missing a # info: line" "$first"
	fi
}

# check_sudoers <file> <label> — file parses under the running sudo. One rejected
# setting (e.g. requiretty under sudo-rs, ub26) makes sudo drop the WHOLE file.
check_sudoers() {
	if [ ! -f "$1" ]; then
		no "sudoers $2 ($1) missing"
		return
	fi
	if visudo -cf "$1" > /dev/null 2>&1; then
		ok "sudoers $2 ($1) valid"
	else
		no "sudoers $2 ($1) invalid" "$(visudo -cf "$1" 2>&1 | tail -1)"
	fi
}

# check_web_lock_coverage - every web/mail-vhost mutator must take the model-switch
# freeze lock (#120), else a domain change could land on a half-flipped tree. Same
# allowlist-by-derivation idea as the $_SESSION[user] guard: it goes red when a new
# mutating command forgets the lock, so the set cannot rot. FTP sub-account commands
# are excluded (they do not write the web vhost tree the switch rebuilds).
check_web_lock_coverage() {
	local f b bad=""
	for f in "$HESTIA"/bin/h-*; do
		b=$(basename "$f")
		case "$b" in
			h-add-web-domain-ftp | h-delete-web-domain-ftp | h-change-web-domain-ftp-password | h-change-web-domain-ftp-path) continue ;;
			h-add-web-domain | h-delete-web-domain | h-add-web-domain-* | h-delete-web-domain-* | h-change-web-domain-* | h-suspend-web-domain | h-unsuspend-web-domain | h-add-fastcgi-cache | h-delete-fastcgi-cache | h-rebuild-web-domain | h-rebuild-web-domains | h-rebuild-mail-domain | h-rebuild-mail-domains | h-add-mail-domain-webmail | h-delete-mail-domain-webmail | h-add-mail-domain-ssl) ;;
			*) continue ;;
		esac
		grep -q "web_lock_acquire" "$f" || bad="$bad $b"
	done
	if [ -z "$bad" ]; then
		ok "invariant: web/mail mutators take the model-switch lock (#120)"
	else
		no "invariant: web/mail mutator missing web_lock_acquire (#120)" "${bad# }"
	fi
}

# check_web_switch_prechecks - the four component switch commands must each run their
# named pre-check function (so a new command cannot jump straight into the core).
check_web_switch_prechecks() {
	local lib="$HESTIA/func/web-model.sh" miss="" fn
	for fn in web_precheck_add_nginx web_precheck_add_apache2 web_precheck_delete_nginx web_precheck_delete_apache2; do
		grep -q "^$fn()" "$lib" || miss="$miss $fn"
	done
	# shellcheck disable=SC2016 # literal on purpose: the dispatch line contains ${action}/${comp}
	grep -qF 'web_precheck_${action}_${comp}' "$lib" || miss="$miss dispatch-call"
	if [ -z "$miss" ]; then
		ok "invariant: web-model switch pre-checks present + dispatched (#120)"
	else
		no "invariant: web-model switch pre-check missing (#120)" "${miss# }"
	fi
}

# check_web_model_sentinel - flag an interrupted model switch so the box reports it
# rather than the operator discovering it at the next reboot.
check_mesh_serve_staged() {
	# Without the staging, /mesh-decisions.php 404s and every peer silently stops receiving this box's
	# bans - and since /run is tmpfs, a missed refresh after a boot looks healthy from anywhere else.
	if [ ! -s "$CONF_DIR/crowdsec/peers.conf" ]; then
		ok "crowdsec mesh has no peers paired"
	elif [ -f /run/hestia/mesh/tokens ] && [ -f /run/hestia/mesh/published.json ]; then
		ok "crowdsec mesh serve side staged"
	else
		no "crowdsec mesh peers paired but /run/hestia/mesh not staged" "run: h-update-crowdsec-mesh"
	fi
}

check_web_model_sentinel() {
	local s="/var/lib/hestia/web-model-switch/IN_PROGRESS" op
	if [ -f "$s" ]; then
		op=$(sed -n 's/^op=//p' "$s")
		no "interrupted web-model switch pending (#120)" "recover: ${op:-h-<add|delete>-sys-<nginx|apache2>} --recover"
	else
		ok "no interrupted web-model switch"
	fi
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "=== HestiaRE smoke test ==="

# --- Panel (always expected) ---
echo "-- panel --"
check_service caddy "panel webserver"
check_service hestia-php "panel PHP-FPM"
check_port "${BACKEND_PORT:-8083}" "panel"
check_http "https://127.0.0.1:${BACKEND_PORT:-8083}/login/" "panel login page"
# invalid sudoers → no privileged panel action works
check_sudoers /etc/sudoers.d/hestia "hestia grant"

# --- Configured subsystems (derived from *_SYSTEM) ---
echo "-- services --"
[ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'nginx' ] && check_service "$WEB_SYSTEM" "web"
[ -n "$PROXY_SYSTEM" ] && [ "$PROXY_SYSTEM" != 'remote' ] && check_service "$PROXY_SYSTEM" "reverse proxy"
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_service "$MAIL_SYSTEM" "mail"
[ -n "$IMAP_SYSTEM" ] && [ "$IMAP_SYSTEM" != 'remote' ] && check_service "$IMAP_SYSTEM" "imap"
[ -n "$ANTISPAM_SYSTEM" ] && [ "$ANTISPAM_SYSTEM" != 'remote' ] && check_service "$ANTISPAM_SYSTEM" "antispam"
[ -n "$FTP_SYSTEM" ] && [ "$FTP_SYSTEM" != 'remote' ] && check_service "$FTP_SYSTEM" "ftp"
[ -n "$CRON_SYSTEM" ] && check_service "$CRON_SYSTEM" "cron"
is_on() { [ "${1:-}" = "true" ] || [ "${1:-}" = "yes" ]; }
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then check_service mariadb "database (mysql)"; fi
# postgres flag does NOT write 'pgsql' into DB_SYSTEM → key off the component flag too
if echo "$DB_SYSTEM" | grep -qw 'pgsql' || is_on "${COMPONENT_DB_POSTGRESQL:-}"; then
	check_service postgresql "database (pgsql)"
fi
is_on "${COMPONENT_ADDON_FAIL2BAN:-}" && check_service fail2ban "fail2ban"
is_on "${COMPONENT_ADDON_CLAMAV:-}" && check_service clamav-daemon "clamav"
is_on "${COMPONENT_ADDON_CROWDSEC:-}" && check_service crowdsec "crowdsec"
# L3 feeder timer only where CrowdSec L3 is wired (the marker) - keyed off the artefact,
# not just the component flag, so a crowdsec-without-L3 state doesn't false-fail.
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && check_service hestia-crowdsec-l3.timer "crowdsec L3 feeder timer"
# fleet-mesh timer only where mesh is enabled (its marker conf), same artefact-gated reasoning.
if [ -f "$CONF_DIR/crowdsec/mesh.conf" ]; then
	check_service hestia-crowdsec-mesh.timer "crowdsec fleet-mesh timer"
	check_mesh_serve_staged
fi
# adminer/webmail: no own daemon — served by a caddy FPM pool, so check the socket
is_on "${COMPONENT_ADDON_ADMINER:-}" && check_socket /run/hestia-adminer.sock "adminer FPM"
if echo "$WEBMAIL_SYSTEM" | grep -qw 'roundcube'; then
	check_socket /run/hestia-webmail-rc.sock "roundcube FPM"
	check_http "http://127.0.0.1:8090/" "roundcube internal listener"
fi
if echo "$WEBMAIL_SYSTEM" | grep -qw 'snappymail'; then
	check_socket /run/hestia-webmail-sm.sock "snappymail FPM"
	check_http "http://127.0.0.1:8091/" "snappymail internal listener"
fi
# redis: user's DB choice or rspamd's always-present Bayes companion
if is_on "${COMPONENT_DB_REDIS:-}" || [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	check_service redis-server "redis"
fi

# --- Firewall datapath (live state, not just the daemon) ---
# The two invariants a green service check cannot see. Both keyed off FIREWALL_SYSTEM, since an
# ACCEPT policy is correct when the firewall is deliberately off. The invariants outlive the
# iptables renderer (#495 re-expresses them against nft), the mechanism below does not.
if [ -n "$FIREWALL_SYSTEM" ] && [ "$FIREWALL_SYSTEM" != 'remote' ]; then
	echo "-- firewall --"
	check_firewall_closed
	check_firewall_ruleset_loadable
	check_firewall_chains_tracked
fi

# --- Ports implied by the active config ---
echo "-- ports --"
if [ -n "$PROXY_SYSTEM" ] || [ -n "$WEB_SYSTEM" ]; then
	check_port 80 "http"
	check_port 443 "https"
fi
echo "$DB_SYSTEM" | grep -qw 'mysql' && check_port 3306 "mysql"
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_port 25 "smtp"
# banner, not just port: IMAP/SMTP must actually answer (a hung login still listens)
if [ -n "$IMAP_SYSTEM" ] && [ "$IMAP_SYSTEM" != 'remote' ]; then
	check_banner 143 "imap"
fi
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_banner 25 "smtp"
if [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	# group-restricted unix sockets — rspamd has no TCP ports
	check_socket /run/rspamd/normal.sock "rspamd scan worker"
	check_socket /run/rspamd/controller.sock "rspamd controller"
	check_rspamd_ctrl_isolation
fi
# localhost-only (webmail managesieve plugin), not opened in the firewall
[ "$SIEVE_SYSTEM" = 'yes' ] && check_port 4190 "managesieve"

# --- Critical log markers ---
echo "-- logs --"
check_log_clean "/var/log/hestia-php-fpm.log" "PHP (Fatal|Parse) error|\[emergency\]|\[alert\]" "panel FPM"
[ -n "$PROXY_SYSTEM" ] && check_log_clean "/var/log/nginx/error.log" "\[emerg\]|\[alert\]" "nginx"
[ "$WEB_SYSTEM" = 'apache2' ] && check_log_clean "/var/log/apache2/error.log" "\[.*:emerg\]|\[.*:alert\]" "apache2"
# exim writes serious problems to a dedicated paniclog — non-empty means trouble
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_file_empty "/var/log/exim4/paniclog" "exim paniclog"

# --- Security invariants (static source gates) ---
echo "-- security invariants --"
# GHSA-fcq6: auth gate must not compare a bare $ROOT_USER (legit: $_SESSION["ROOT_USER"])
check_source_absent "no bare \$ROOT_USER auth gate (GHSA-fcq6)" '\$ROOT_USER' "$HESTIA/web"
# GHSA-cr7q: search-object commands must not eval raw conf-field payloads
check_source_absent "no raw eval in search-object (GHSA-cr7q)" '(^|[^_])eval[[:space:]]' \
	"$HESTIA/bin/h-search-user-object" "$HESTIA/bin/h-search-object"
# #438: the real session user may only be touched by allowlisted files (auth /
# dispatch / reset / real-identity display) — everything else must use the
# look-aware $user/$user_plain, or an admin impersonating a customer mis-targets.
check_session_user_allowlist "$HESTIA/web"
# #438: userContext is the effective role and is what admin-gates read. The old
# effective-mirror $_SESSION["role"] must NOT be compared against (it was unified
# onto userContext) — a divergent mirror would silently split the gate surface.
check_source_absent "no gating on the effective-mirror \$_SESSION[role] (#438 — use userContext)" \
	'\$_SESSION\["role"\][[:space:]]*(==|!=)' "$HESTIA/web"
# #441/#443: X-Accel-Redirect only from the allowlisted RRD handler; a new download
# emitting it would hit the caddy-can't-read wall (stream via inc/download.php instead).
check_xaccel_allowlist "$HESTIA/web"
# v-* compat symlinks must all resolve (no dangling alias left by a rename).
check_v_symlinks_resolve
# every h-* keeps its parsed # info: line (a comment sweep must not eat it).
check_info_headers
# a policy fragment (crowdsec Layer A, bot rate limiting) missing from one template is a silent bypass.
check_policy_fragment_coverage
# #120: the model-switch freeze + pre-check coverage cannot rot; a crash is surfaced.
check_web_lock_coverage
check_web_switch_prechecks
check_web_model_sentinel

#----------------------------------------------------------#
#                       Result                             #
#----------------------------------------------------------#

echo "=== result: $pass passed, $fail failed ==="
if [ "$fail" -gt 0 ]; then
	exit 1
fi
exit 0
