#!/bin/bash
# info: list web templates
# options: [FORMAT]
#
# example: h-list-web-templates
#
# This function for obtaining the list of web templates available to a user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	objects=$(echo "$templates" | wc -w)
	i=1
	echo '['
	for template in $templates; do
		if [ "$i" -lt "$objects" ]; then
			echo -e "\t\"$template\","
		else
			echo -e "\t\"$template\""
		fi
		((++i))
	done
	echo "]"
}

# SHELL list function
shell_list() {
	echo "TEMPLATE"
	echo "--------"
	for template in $templates; do
		echo "$template"
	done
}

# PLAIN list function
plain_list() {
	for template in $templates; do
		echo "$template"
	done
}

# CSV list function
csv_list() {
	echo "TEMPLATE"
	for template in $templates; do
		echo "$template"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing templates. Only the selectable tree - a model whose vhost template lives in
# share/ (apache) offers no choice, and an empty list is the honest answer
templates=''
if [ -d "$WEBTPL/$WEB_SYSTEM/$WEB_BACKEND" ]; then
	templates=$(ls -v "$WEBTPL/$WEB_SYSTEM/$WEB_BACKEND/" | grep '\.tpl' | sed 's/\.tpl$//')
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
