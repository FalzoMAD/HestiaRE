#!/bin/bash
# info: list system IP
# options: IP [FORMAT]
#
# example: h-list-sys-ip 203.0.113.1
#
# This function for getting the list of system IP parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip="$1"
format="${2-shell}"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	echo '{'
	json_escape ip OWNER STATUS NAME U_SYS_USERS U_WEB_DOMAINS INTERFACE NETMASK NAT TIME DATE
	printf '    "%s": {\n' "$ip"
	printf '        "OWNER": "%s",\n' "$OWNER"
	printf '        "STATUS": "%s",\n' "$STATUS"
	printf '        "NAME": "%s",\n' "$NAME"
	printf '        "U_SYS_USERS": "%s",\n' "$U_SYS_USERS"
	printf '        "U_WEB_DOMAINS": "%s",\n' "$U_WEB_DOMAINS"
	printf '        "INTERFACE": "%s",\n' "$INTERFACE"
	printf '        "NETMASK": "%s",\n' "$NETMASK"
	printf '        "NAT": "%s",\n' "$NAT"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "IP:             $ip"
	echo "NETMASK:        $NETMASK"
	echo "INTERFACE:      $INTERFACE"
	echo "NAT:            $NAT"
	echo "OWNER:          $OWNER"
	echo "STATUS:         $STATUS"
	echo "NAME:           $NAME"
	echo "USERS:          $U_SYS_USERS"
	echo "DOMAINS:        $U_WEB_DOMAINS"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "$ip\t$OWNER\t$STATUS\t$NAME\t$U_SYS_USERS\t$U_WEB_DOMAINS\t"
	echo -e "$INTERFACE\t$NETMASK\t$NAT\t$TIME\t$DATE"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'IP [FORMAT]'
is_format_valid 'ip'
if [ ! -e "$CONF_DIR/ips/$ip" ]; then
	check_result $E_NOTEXIST "IP $ip doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing IP
source_conf "$CONF_DIR/ips/$ip"

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
