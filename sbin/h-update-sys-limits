#!/bin/bash
# info: re-apply the customer PHP CPU cap from /etc/hestia/limits.conf
# options: NONE
#
# example: h-update-sys-limits
#
# Reinstalls the slice, the boot oneshot and the per-version drop-ins, then computes
# the cap for the running core count. The repair path for a master that ended up
# outside the slice; for a changed percentage alone, restarting the oneshot is enough.
# In sbin because bin/ is the panel's sudo wildcard and this is not a panel action.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/limits.sh
source $HESTIA/include/limits.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

customer_php_limit_apply

# The enforced value from the cgroup, not the systemd property: fail-open means the two
# can disagree, and the property answers even while no master is in the slice.
systemctl restart "$CUSTOMER_PHP_LIMIT_UNIT" > /dev/null 2>&1
echo "customer PHP slice: cpu.max = $(customer_php_cpu_max || echo 'no live cgroup - no master in the slice') on $(nproc --all) cores"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
"$BIN/h-log-action" "system" "Info" "System" "Customer PHP CPU cap re-applied."
log_event "$OK" "$ARGUMENTS"

exit
