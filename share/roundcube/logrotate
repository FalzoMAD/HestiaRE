# Roundcube logs as the caddy FPM pool user, so rotation must recreate the files caddy-owned; the
# roundcube-core package would recreate them www-data:adm and unwritable. Its file is diverted away
# by h-add-sys-roundcube: listing a path twice is an error to logrotate, not a silent override.
/var/log/roundcube/*.log
/var/log/roundcube/errors
/var/log/roundcube/sendmail
/var/log/roundcube/session
/var/log/roundcube/userlogins
{
    su caddy caddy
    rotate 12
    monthly
    missingok
    notifempty
    create 0640 caddy caddy
}
