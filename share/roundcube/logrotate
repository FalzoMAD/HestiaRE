# Roundcube logs as the caddy FPM pool user, so rotation must recreate the files caddy-owned; the
# roundcube-core package rotates the same paths as www-data:adm, which would leave them unwritable.
# Both files cover *.log, so logrotate skips whichever it reads second - ours wins because "roundcube"
# sorts before "roundcube-core". Do not rename this file, and do not delete theirs: it is a dpkg conffile.
/var/log/roundcube/*.log
/var/log/roundcube/errors
/var/log/roundcube/sendmail
/var/log/roundcube/session
/var/log/roundcube/userlogins
{
    su caddy caddy
    rotate 12
    monthly
    missingok
    notifempty
    create 0640 caddy caddy
}
