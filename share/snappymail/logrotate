# SnappyMail writes its fail2ban auth log as the caddy FPM pool user, so rotation must recreate it
# caddy-owned. Plain rotate (no copytruncate): fail2ban follows the file across rotation by inode, and
# SnappyMail reopens the log per write, so a rename + create loses nothing.
/var/log/snappymail/fail2ban/auth.txt
{
    su caddy caddy
    rotate 12
    monthly
    missingok
    notifempty
    create 0640 caddy caddy
}
