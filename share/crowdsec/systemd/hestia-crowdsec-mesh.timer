# HestiaRE CrowdSec fleet-mesh cadence. Peer bans converge within one interval; L7-only backstop,
# so a modest cadence is fine (the local engine already blocks its own detections live).
[Unit]
Description=HestiaRE CrowdSec fleet-mesh refresh timer

[Timer]
OnBootSec=90
OnUnitActiveSec=60
AccuracySec=15

[Install]
WantedBy=timers.target
