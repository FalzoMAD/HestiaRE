# HestiaRE CrowdSec L3 ipset refresh. Oneshot, driven by hestia-crowdsec-l3.timer:
# fills crowdsec-blacklists from local web-tier ban decisions. The DROP is owned by
# h-update-firewall (the hestia-crowdsec chain); this only maintains set membership.
[Unit]
Description=HestiaRE CrowdSec L3 ipset refresh
After=crowdsec.service network-online.target
Wants=crowdsec.service

[Service]
Type=oneshot
ExecStart=/usr/local/hestia/bin/h-update-firewall-crowdsec
