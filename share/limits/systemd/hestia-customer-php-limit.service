#=========================================================================#
# HestiaRE - customer PHP CPU cap                                         #
#                                                                         #
# Installed verbatim by customer_php_limit_apply (include/limits.sh).     #
# DO NOT MODIFY THE INSTALLED COPY - it is regenerated.                   #
#=========================================================================#
#
# Ordered before the FPM masters from their side: the drop-in this writes into
# every php<v>-fpm.service.d carries the Wants=/After= pair, so no master can
# start into an uncapped slice.
#
# The script always exits 0: a system protection must not keep the box from booting. What
# survives is the slice's static value, which is NOT "no limit" - it is a fixed 200% whose
# meaning flips with the machine (see the slice unit). So a failure here is not open, it is
# arbitrary, and h-check-sys-smoke exists to make it visible.

[Unit]
Description=HestiaRE customer PHP CPU cap
ConditionPathExists=/etc/hestia/hestia.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/hestia/sbin/hestia-customer-php-limit

[Install]
WantedBy=multi-user.target
