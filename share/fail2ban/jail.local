# No mysqld jail: 3306 is not in the shipped ruleset, so MariaDB is only reachable from loopback and the
# box itself - both of which h-add-firewall-ban refuses to ban. A jail there would match and then decline to
# act. An admin who deliberately opens 3306 owns the access control for it (source-restricted rule, DB
# users) and can add a jail to suit.
# Our jails read log FILES, so the backend is pinned here rather than inherited. Ubuntu 24.04's
# jail.d/defaults-debian.conf sets `backend = systemd` in [DEFAULT], which applies to every jail: ours then
# watch the journal, never read their logpath, and match nothing while reporting perfectly healthy. Debian
# 12 omits the key and Debian 13 / Ubuntu 26 scope it to [sshd], so this only bites on one target - which is
# exactly why it has to be pinned instead of assumed.
[DEFAULT]
backend = auto

[ssh-iptables]
enabled  = true
filter   = sshd
action   = hestia[name=SSH]
logpath  = /var/log/auth.log
maxretry = 5

[exim-iptables]
enabled  = true
filter   = exim
action   = hestia[name=MAIL]
logpath  = /var/log/exim4/mainlog

[dovecot-iptables]
enabled  = true
filter   = dovecot
action   = hestia[name=MAIL]
logpath  = /var/log/dovecot.log

[proftpd-iptables]
enabled  = true
filter   = proftpd
action   = hestia[name=FTP]
logpath  = /var/log/proftpd/proftpd.log
maxretry = 5

[hestia-iptables]
enabled  = true
filter   = hestia
action   = hestia[name=HESTIA]
logpath  = /var/log/hestia/auth.log
maxretry = 5

# Webmail auth jails. enabled is a placeholder: fail2ban_gate_webmail_jails flips each on when its client
# is in WEBMAIL_SYSTEM and ensures the logpath exists (a jail on a missing file never fires). Both ban at
# the WEB chain - webmail is web-tier. The real client reaches the log via the webmail vhost header fixes
# (X-Real-IP for Roundcube, Client-IP for SnappyMail); see the two filters.
[roundcube-auth]
enabled  = false
filter   = hestia-roundcube
action   = hestia[name=WEB]
logpath  = /var/log/roundcube/userlogins.log
maxretry = 5

[snappymail-auth]
enabled  = false
filter   = hestia-snappymail
action   = hestia[name=WEB]
logpath  = /var/log/snappymail/fail2ban/auth.txt
maxretry = 5

[phpmyadmin-auth]
enabled  = true
filter   = phpmyadmin-syslog
action   = hestia[name=WEB]
logpath  = /var/log/auth.log
maxretry = 5

# The L7 jail: scanners probing customer vhosts for apps that are not installed. logpath is rewritten to the
# configured web system by fail2ban_gate_web_jail - the value here is only a placeholder. Deliberately NOT
# extended to the rate limiter's 429s: Layer B (nginx limit_req / apache mod_qos) throttles bots on its own
# and its verdicts must not escalate into firewall bans.
#
# Thresholds are spelled out, not inherited from jail.conf: this jail is armed on every domain of every
# box, so they are a decision rather than a distro default that could shift under us. 10-in-10-minutes is
# safe because only 404s on the botsearch vocabulary count - measured: eight ordinary 404s from a link
# checker, /wp-admin/ among them, counted zero. recidive escalates a repeat offender on top.
[web-botsearch]
enabled  = true
filter   = hestia-botsearch
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 10
findtime = 600
bantime  = 600

# The signature web jails: same log, same placeholder logpath and same WEB chain as web-botsearch.
# Signature/behaviour based, never rate - that is Layer B's job and its 429s must not escalate.
# maxretry >= 2 everywhere so nothing bans on a single hit. The filters say what each one matches.

# "Looking for files that should not be here" - secrets/config/info-leak paths, status-agnostic.
[web-badactor]
enabled  = true
filter   = hestia-badactor
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 2
findtime = 600
bantime  = 3600

# "Trying to execute code or break out of the directory" - traversal / RCE / appliance-exploit payloads.
[web-exploit]
enabled  = true
filter   = hestia-exploit
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 2
findtime = 600
bantime  = 3600

# Repeated 401 (auth failures) only. Counts per source IP AGGREGATED across every vhost on the box, not per
# domain, so maxretry is high on purpose - it must tolerate a shared NAT/monitoring IP touching several sites.
[web-authprobe]
enabled  = true
filter   = hestia-authprobe
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 20
findtime = 600
bantime  = 1800

[recidive]
enabled  = true
filter   = recidive
action   = hestia[name=RECIDIVE]
logpath  = /var/log/fail2ban.log
maxretry = 5
findtime = 86400
bantime  = 864000

# Whitelisting is not done here: h-add-firewall-exclude maintains the firewall whitelist and mirrors it into
# jail.d/hestia-zz-whitelist.local, so one list covers the ruleset and fail2ban both.
