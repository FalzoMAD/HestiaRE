# No mysqld jail: 3306 is not in the shipped ruleset, so MariaDB is only reachable from loopback and the
# box itself - both of which h-add-firewall-ban refuses to ban. A jail there would match and then decline to
# act. An admin who deliberately opens 3306 owns the access control for it (source-restricted rule, DB
# users) and can add a jail to suit.
# Our jails read log FILES, so the backend is pinned here rather than inherited. Ubuntu 24.04's
# jail.d/defaults-debian.conf sets `backend = systemd` in [DEFAULT], which applies to every jail: ours then
# watch the journal, never read their logpath, and match nothing while reporting perfectly healthy. Debian
# 12 omits the key and Debian 13 / Ubuntu 26 scope it to [sshd], so this only bites on one target - which is
# exactly why it has to be pinned instead of assumed.
[DEFAULT]
backend = auto

[ssh-iptables]
enabled  = true
filter   = sshd
action   = hestia[name=SSH]
logpath  = /var/log/auth.log
maxretry = 5

[exim-iptables]
enabled  = true
filter   = exim
action   = hestia[name=MAIL]
logpath  = /var/log/exim4/mainlog

[dovecot-iptables]
enabled  = true
filter   = dovecot
action   = hestia[name=MAIL]
logpath  = /var/log/dovecot.log

[proftpd-iptables]
enabled  = true
filter   = proftpd
action   = hestia[name=FTP]
logpath  = /var/log/proftpd/proftpd.log
maxretry = 5

[hestia-iptables]
enabled  = true
filter   = hestia
action   = hestia[name=HESTIA]
logpath  = /var/log/hestia/auth.log
maxretry = 5

[roundcube-auth]
enabled  = false
filter   = roundcube-auth
action   = hestia[name=WEB]
logpath  = /var/log/roundcube/errors.log
maxretry = 5

[phpmyadmin-auth]
enabled  = true
filter   = phpmyadmin-syslog
action   = hestia[name=WEB]
logpath  = /var/log/auth.log
maxretry = 5

# The L7 jail: scanners probing customer vhosts for apps that are not installed. logpath is rewritten to the
# configured web system by fail2ban_gate_web_jail - the value here is only a placeholder. Deliberately NOT
# extended to the rate limiter's 429s: Layer B (nginx limit_req / apache mod_qos) throttles bots on its own
# and its verdicts must not escalate into firewall bans.
#
# findtime/bantime are spelled out rather than inherited from jail.conf: this jail is armed on every domain
# of every box, so the thresholds are a decision, not a distro default that could shift under us. 5 in 10
# minutes is safe here because the filter counts only 404s on the botsearch vocabulary (wp-login/signup/
# admin.php, phpmyadmin, webmail, cgi-bin) - measured: eight ordinary 404s from a link checker, /wp-admin/
# among them, count zero. A client reaching 5 of those has no innocent reading. Note the knock-on: five
# bans inside a day also trips recidive, which is all-ports for 10 days.
[web-botsearch]
enabled  = true
filter   = hestia-botsearch
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 5
findtime = 600
bantime  = 600

[recidive]
enabled  = true
filter   = recidive
action   = hestia[name=RECIDIVE]
logpath  = /var/log/fail2ban.log
maxretry = 5
findtime = 86400
bantime  = 864000

# Whitelisting is not done here: h-add-firewall-exclude maintains the firewall whitelist and mirrors it into
# jail.d/hestia-zz-whitelist.local, so one list covers the ruleset and fail2ban both.
