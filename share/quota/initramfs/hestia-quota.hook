#!/bin/sh
# HestiaRE (#211): tune2fs into the initramfs for the one-shot quota arming -
# e2fsck ships there, tune2fs does not, and without it the premount dies.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs)
	prereqs
	exit 0
	;;
esac
. /usr/share/initramfs-tools/hook-functions
copy_exec /sbin/tune2fs
