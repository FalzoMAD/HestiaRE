# The panel runs as user hestia and reaches the h-* commands through sudo. The wildcard is the whole
# grant on purpose: bin/ IS the panel-callable surface, and the directory is the boundary.
#
# Everything the panel must not reach lives in /usr/local/hestia/sbin and is deliberately not named
# here. Keep it that way - do not widen this rule, and do not add a second one for sbin.
#
# Deployed ONLY through deploy_hestia_sudoers (include/helper.sh): it prepends
# "Defaults:hestia !log_allowed" where the box's sudo validates it (classic sudo; keeps
# panel-set argv passwords out of auth.log, denials keep logging) - sudo-rs (ubuntu 26.04)
# validates no logging option at all and is covered by the rsyslog drop rule instead (#693).
hestia   ALL=NOPASSWD:/usr/local/hestia/bin/*
